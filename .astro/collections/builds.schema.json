          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "publishedDate": {
            "type": "string",
            "format": "date-time"
          },
          "client": {
            "type": "string"
          },
          "organisation": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "credits": {
            "type": "string"
          },
          "heroImage": {
            "type": "string"
          },
          "heroAlt": {
            "type": "string"
          },
          "imageCredit": {
            "type": "string"
          },
          "relatedPodcasts": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
