    "outcomes": {
      "type": "string"
    },
    "testimonial": {
      "type": "object",
      "properties": {
        "quote": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "organisation": {
          "type": "string"
        },
        "permission": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "quote",
        "name"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "tagline": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "lab",
        "tool",
        "app"
      ]
    },
    "platforms": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "web",
          "desktop",
          "mobile",
          "cli",
          "api",
          "library",
          "browser-extension",
          "hardware",
          "other"
        ]
      }
    },
    "status": {
      "default": "active",
      "type": "string",
      "enum": [
        "planned",
        "active",
        "maintenance",
        "paused",
        "retired",
        "archived"
      ]
    },
    "stage": {
      "default": "prototype",
      "type": "string",
      "enum": [
        "concept",
        "prototype",
        "alpha",
        "beta",
        "stable"
      ]
    },
    "launchedDate": {
      "type": "string",
      "format": "date-time"
    },
    "retiredDate": {
      "type": "string",
      "format": "date-time"
    },
    "audience": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "problem": {
      "type": "string"
    },
    "useCases": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "title",
          "description"
        ]
      }
    },
    "access": {
      "default": "public",
      "type": "string",
      "enum": [
        "public",
        "signup",
        "invite-only",
        "private",
        "unavailable"
      ]
    },
    "pricing": {
      "default": "free",
      "type": "string",
      "enum": [
        "free",
        "freemium",
        "paid",
        "mixed",
        "not-applicable"
      ]
    },
    "requirements": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sourceAvailability": {
      "type": "string",
      "enum": [
        "open-source",
        "source-available",
        "closed-source"
      ]
    },
    "license": {
      "type": "string"
    },
    "screenshots": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "src": {
            "type": "string",
            "minLength": 1
          },
          "alt": {
            "type": "string",
            "minLength": 1
          },
          "caption": {
            "type": "string"
          },
          "credit": {
            "type": "string"
          }
        },
        "required": [
          "src",
          "alt"
        ]
      }
    },
    "primaryCta": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "href": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "label",
        "href"
      ]
    },
    "relatedBuilds": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relatedInsights": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "replacement": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "href": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "title",
        "href"
      ]
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "summary",
    "type"
  ]
}