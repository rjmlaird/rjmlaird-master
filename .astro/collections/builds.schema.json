    "relatedAwards": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relatedTools": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relatedSkills": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
