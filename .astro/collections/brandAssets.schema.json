                "portfolio",
                "research",
                "tutoring",
                "booking",
                "images",
                "labs"
              ]
            }
          }
        },
        "required": [
          "id",
          "title",
          "type",
          "creator",
          "copyrightOwner",
          "licence",
          "usage",
          "altText",
          "cdnUrl",
          "lastReviewed"
        ]
      }
    }
  ]
}