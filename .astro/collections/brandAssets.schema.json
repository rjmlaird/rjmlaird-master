              "illustration",
              "icon",
              "social-card",
              "logo"
            ]
          },
          "creator": {
            "type": "string"
          },
          "copyrightOwner": {
            "type": "string"
          },
          "licence": {
            "type": "string",
            "enum": [
              "all-rights-reserved",
              "cc-by-4.0",
              "cc-by-nc-4.0",
              "cc0"
            ]
          },
          "usage": {
            "type": "object",
            "properties": {
              "approved": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "prohibited": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "approved"
            ]
          },
          "altText": {
            "type": "string",
            "minLength": 1
          },
          "captionGuidance": {
            "type": "string"
          },
          "cdnUrl": {
            "type": "string",
