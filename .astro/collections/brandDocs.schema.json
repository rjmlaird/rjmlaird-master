{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "order": {
      "default": 100,
      "type": "number"
    },
    "status": {
      "default": "draft",
      "type": "string",
      "enum": [
        "draft",
        "review",
        "stable"
      ]
    },
    "lastReviewed": {
      "type": "string",
      "format": "date-time"
    },
    "relatedPages": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description"
  ]
}