{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "excerpt": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "imageCredit": {
      "type": "string"
    },
    "canonical": {
      "type": "string",
      "format": "uri"
    },
    "noindex": {
      "default": false,
      "type": "boolean"
    },
    "nofollow": {
      "default": false,
      "type": "boolean"
    },
    "summary": {
      "type": "string"
    },
    "draft": {
      "default": false,
      "type": "boolean"
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "heroImage": {
      "type": "string"
    },
    "heroAlt": {
      "type": "string"
    },
    "audience": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outcomes": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "formats": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "topics": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relatedWork": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relatedInsights": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relatedServices": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contactCtaLabel": {
      "type": "string"
    },
    "contactCtaHref": {
      "default": "/contact/",
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ]
}