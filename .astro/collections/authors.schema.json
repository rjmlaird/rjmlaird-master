{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "avatar": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "label"
        ]
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ]
}