{
  "color": {
    "blue": {
      "900": { "$type": "color", "$value": "#0B1B35" },
      "700": { "$type": "color", "$value": "#1D4E89" },
      "500": { "$type": "color", "$value": "#4B9CFF" },
      "400": { "$type": "color", "$value": "#3B7DD8" }
    },
    "neutral": {
      "950": { "$type": "color", "$value": "#0A0F1A" },
      "900": { "$type": "color", "$value": "#111A2A" },
      "800": { "$type": "color", "$value": "#22304A" },
      "700": { "$type": "color", "$value": "#4A5568" },
      "300": { "$type": "color", "$value": "#B4C0CF" },
      "200": { "$type": "color", "$value": "#D9D4C7" },
      "50":  { "$type": "color", "$value": "#F7F4ED" },
      "0":   { "$type": "color", "$value": "#FFFFFF" }
    },
    "status": {
      "positive": { "$type": "color", "$value": "#3FA76A" },
      "negative": { "$type": "color", "$value": "#E5626F" }
    },
    "site": {
      "main":      { "$type": "color", "$value": "#3B7DD8" },
      "astro":     { "$type": "color", "$value": "#E0A030" },
      "space":     { "$type": "color", "$value": "#8B7CF6" },
      "portfolio": { "$type": "color", "$value": "#E5626F" },
      "research":  { "$type": "color", "$value": "#2AA79B" },
      "tutoring":  { "$type": "color", "$value": "#3FA76A" },
      "booking":   { "$type": "color", "$value": "{color.site.main}" },
      "images":    { "$type": "color", "$value": "#C9BFA8" },
      "labs":      { "$type": "color", "$value": "#F0C419" }
    }
  },
  "space": {
    "1":  { "$type": "dimension", "$value": "0.25rem" },
    "2":  { "$type": "dimension", "$value": "0.5rem" },
    "3":  { "$type": "dimension", "$value": "0.75rem" },
    "4":  { "$type": "dimension", "$value": "1rem" },
    "6":  { "$type": "dimension", "$value": "1.5rem" },
    "8":  { "$type": "dimension", "$value": "2rem" },
    "12": { "$type": "dimension", "$value": "3rem" },
    "16": { "$type": "dimension", "$value": "4rem" }
  },
  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": ["system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"] },
      "mono": { "$type": "fontFamily", "$value": ["ui-monospace", "Menlo", "Consolas", "monospace"] }
    },
    "weight": {
      "regular":  { "$type": "fontWeight", "$value": 400 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold":     { "$type": "fontWeight", "$value": 800 }
    },
    "size": {
      "0": { "$type": "dimension", "$value": "1rem" },
      "1": { "$type": "dimension", "$value": "1.25rem" },
      "2": { "$type": "dimension", "$value": "1.5rem" },
      "3": { "$type": "dimension", "$value": "2rem" },
      "4": { "$type": "dimension", "$value": "3rem" },
      "small": { "$type": "dimension", "$value": "0.875rem" }
    },
    "leading": {
      "tight": { "$type": "number", "$value": 1.15 },
      "body":  { "$type": "number", "$value": 1.6 }
    }
  },
  "radius": {
    "sm":   { "$type": "dimension", "$value": "0.5rem" },
    "md":   { "$type": "dimension", "$value": "0.75rem" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "layout": {
    "width": {
      "content": { "$type": "dimension", "$value": "42rem" },
      "page":    { "$type": "dimension", "$value": "70rem" }
    }
  }
}
