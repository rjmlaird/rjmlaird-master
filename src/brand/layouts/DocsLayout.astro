---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import DocsSidebar from '../components/layout/DocsSidebar.astro';
import TableOfContents from '../components/shared/TableOfContents.astro';
import { getSectionEntries } from '../lib/content';
import type { Section } from '../lib/schemas';

interface Props {
  section: Section;
  title: string;
  description: string;
  status?: string;
  lastReviewed?: Date;
  headings?: { depth: number; slug: string; text: string }[];
  site?: string;
}
const { section, title, description, status, lastReviewed, headings = [], site } = Astro.props;
const entries = await getSectionEntries(section);
---
<BaseLayout title={title} description={description} site={site}>
  <div class="wrap docs">
    <DocsSidebar section={section} entries={entries} />
    <div class="doc">
      <Breadcrumbs section={section} title={title} />
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      {(status || lastReviewed) && (
        <p class="meta">
          {status && <span class={`badge ${status}`}>{status}</span>}
          {lastReviewed && <span>Reviewed {lastReviewed.toISOString().slice(0, 10)}</span>}
        </p>
      )}
      <TableOfContents headings={headings} />
      <div class="prose"><slot /></div>
    </div>
  </div>
</BaseLayout>
