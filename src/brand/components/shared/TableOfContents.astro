---
interface Props { headings: { depth: number; slug: string; text: string }[] }
const items = Astro.props.headings.filter((h) => h.depth === 2);
---
{items.length > 1 && (
  <nav class="toc" aria-label="On this page">
    <b>On this page</b>
    <ul>{items.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
  </nav>
)}
