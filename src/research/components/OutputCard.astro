---
import { outputTypeLabel } from '../data/output-types';
interface Props { type: string; title: string; url?: string; state: string; projectId?: string; projectTitle?: string; }
const { type, title, url, state, projectId, projectTitle } = Astro.props;
---
<article class="card">
  <p class="meta"><span>{outputTypeLabel(type)}</span><span class={`badge ${state}`}>{state}</span></p>
  <h3>{url ? <a href={url}>{title}</a> : title}</h3>
  {projectId && <p class="small muted">From <a href={`/research/projects/${projectId}/`}>{projectTitle}</a></p>}
</article>
