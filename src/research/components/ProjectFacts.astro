---
import ProjectStatus from './ProjectStatus.astro';
import { themeLabel } from '../data/themes';
import { fmt, type Project } from '../lib/content';
interface Props { project: Project; methodTitles: Record<string, string>; }
const { project, methodTitles } = Astro.props;
const d = project.data;
---
<dl class="facts">
  <div><dt>Status</dt><dd><ProjectStatus status={d.status} /></dd></div>
  <div><dt>Themes</dt><dd>{d.themes.map((t, i) => <><a href={`/research/themes/${t}/`}>{themeLabel(t)}</a>{i < d.themes.length - 1 ? ', ' : ''}</>)}</dd></div>
  <div><dt>Started</dt><dd>{d.startedAt ? fmt(d.startedAt) : 'Not started'}</dd></div>
  <div><dt>Updated</dt><dd>{fmt(d.updatedAt)}</dd></div>
  <div><dt>Methods</dt><dd>{d.methods.map((m, i) => <><a href={`/research/methods/${m}/`}>{methodTitles[m] ?? m}</a>{i < d.methods.length - 1 ? ', ' : ''}</>)}</dd></div>
  <div><dt>Tools</dt><dd>{d.tools.join(', ') || 'To be confirmed'}</dd></div>
</dl>
