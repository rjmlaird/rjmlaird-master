---
import { fmt } from '../lib/content';
import type { CollectionEntry } from 'astro:content';
interface Props { note: CollectionEntry<'researchNotes'>; }
const { note } = Astro.props;
---
<article class="card">
  <p class="meta"><span>{note.data.kind}</span><span>{fmt(note.data.publishedAt)}</span></p>
  <h3><a href={`/research/notes/${note.id}/`}>{note.data.title}</a></h3>
  <p>{note.data.summary}</p>
</article>
