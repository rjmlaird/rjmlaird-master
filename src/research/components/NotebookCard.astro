---
import type { CollectionEntry } from 'astro:content';
interface Props { notebook: CollectionEntry<'researchNotebooks'>; }
const n = Astro.props.notebook.data;
---
<article class="card">
  <p class="meta"><span class={`badge ${n.state}`}>{n.state}</span><span>{n.area}</span></p>
  <h3><a href={`/research/notebooks/${Astro.props.notebook.id}/`}>{n.title}</a></h3>
  <p>{n.summary}</p>
</article>
