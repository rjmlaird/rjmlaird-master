---
import { fmt } from '../lib/content';
interface Props { sources: { name: string; url?: string; licence?: string; accessedAt?: Date }[]; }
const { sources } = Astro.props;
---
{sources.length === 0 ? <p class="muted">No data sources have been finalised for this project yet.</p> : (
  <div class="table-scroll"><table>
    <thead><tr><th scope="col">Source</th><th scope="col">Licence</th><th scope="col">Accessed</th></tr></thead>
    <tbody>{sources.map((s) => (
      <tr><td>{s.url ? <a href={s.url}>{s.name}</a> : s.name}</td><td>{s.licence ?? 'To be confirmed'}</td><td>{s.accessedAt ? fmt(s.accessedAt) : 'Not yet accessed'}</td></tr>
    ))}</tbody>
  </table></div>
)}
