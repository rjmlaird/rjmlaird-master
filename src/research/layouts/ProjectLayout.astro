---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ResearchTimeline from '../components/ResearchTimeline.astro';
import ProjectFacts from '../components/ProjectFacts.astro';
import DataSourceList from '../components/DataSourceList.astro';
import OutputCard from '../components/OutputCard.astro';
import LimitationsPanel from '../components/LimitationsPanel.astro';
import ReproducibilityPanel from '../components/ReproducibilityPanel.astro';
import LicenceNotice from '../components/LicenceNotice.astro';
import RelatedWork from '../components/RelatedWork.astro';
import CitationBox from '../components/CitationBox.astro';
import { projectCitation } from '../lib/citations';
import { breadcrumbSchema, projectSchema } from '../lib/schema';
import { external } from '../data/external-links';
import { themeLabel } from '../data/themes';
import type { Project } from '../lib/content';

interface Props { project: Project; methodTitles: Record<string, string>; }
const { project, methodTitles } = Astro.props;
const d = project.data;
const path = `/research/projects/${project.id}/`;
const schema = [
  breadcrumbSchema([{ name: 'Home', path: '/research/lab/' }, { name: 'Projects', path: '/research/projects/' }, { name: d.title, path }]),
  projectSchema({ title: d.title, summary: d.summary, path, keywords: d.themes.map(themeLabel), modified: d.updatedAt, started: d.startedAt }),
];
const rail = [['question', 'Research question'], ['methods', 'Method'], ['data', 'Data source'], ['analysis', 'Analysis'], ['outputs', 'Output'], ['limitations', 'Limitations'], ['reproducibility', 'Reproducibility'], ['citation', 'Citation']];
---
<BaseLayout title={d.title} description={d.summary} noindex={d.draft} schema={schema}>
  <div class="wrap">
    <Breadcrumbs items={[{ label: 'Home', href: '/research/lab/' }, { label: 'Projects', href: '/research/projects/' }, { label: d.title }]} />
    <header class="page-head">
      <h1>{d.title}</h1>
      <p class="lede">{d.summary}</p>
    </header>
    {d.draft && <p class="notice"><strong>Draft.</strong> This page describes planned or early-stage work. It contains no verified findings and is hidden from search engines until reviewed.</p>}
    <ProjectFacts project={project} methodTitles={methodTitles} />
    <div class="project">
      <nav class="rail" aria-label="On this page"><ol>{rail.map(([id, l]) => <li><a href={`#${id}`}>{l}</a></li>)}</ol></nav>
      <article>
        <section id="question">
          <h2>Research {d.researchQuestions.length > 1 ? 'questions' : 'question'}</h2>
          <ul>{d.researchQuestions.map((q) => <li>{q}</li>)}</ul>
          <h3>Why it matters</h3>
          <p>{d.whyItMatters}</p>
        </section>
        <section id="methods">
          <h2>Method</h2>
          {d.methods.length > 0 ? <ul>{d.methods.map((m) => <li><a href={`/research/methods/${m}/`}>{methodTitles[m] ?? m}</a></li>)}</ul> : <p class="muted">Methods to be defined.</p>}
          <p>Tools: {d.tools.join(', ') || 'to be confirmed'}.</p>
        </section>
        <section id="data"><h2>Data sources</h2><DataSourceList sources={d.dataSources} /></section>
        <section id="analysis">
          <h2>Analysis and progress</h2>
          <p><strong>Current progress:</strong> {d.progress}</p>
          <div class="prose"><slot /></div>
        </section>
        <section id="outputs">
          <h2>Outputs</h2>
          {d.outputs.length === 0 ? <p class="muted">No outputs yet.</p> : <div class="grid">{d.outputs.map((o) => <OutputCard {...o} />)}</div>}
        </section>
        <section id="limitations"><h2>Limitations</h2><LimitationsPanel items={d.limitations} /></section>
        <section id="reproducibility">
          <h2>Reproducibility</h2>
          <ReproducibilityPanel text={d.reproducibility} url={d.reproducibilityUrl} />
          <h3>Licensing</h3>
          <LicenceNotice licence={d.licence} />
          {d.relatedArticles.length > 0 && <><h3>Related writing</h3><RelatedWork links={d.relatedArticles} /></>}
        </section>
        <section id="citation">
          <h2>Citation</h2>
          <CitationBox citation={projectCitation(project)} />
          <h3>Collaboration</h3>
          <p>Interested in collaborating or have a correction? <a href={external.contact.url}>Get in touch</a>.</p>
        </section>
      </article>
    </div>
  </div>
</BaseLayout>
