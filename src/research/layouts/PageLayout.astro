---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
interface Props { title: string; lede?: string; description?: string; crumbs?: { label: string; href?: string }[]; noindex?: boolean; schema?: object[]; }
const { title, lede, description, crumbs = [], noindex, schema } = Astro.props;
---
<BaseLayout title={title} description={description ?? lede} noindex={noindex} schema={schema}>
  <div class="wrap">
    {crumbs.length > 0 && <Breadcrumbs items={crumbs} />}
    <header class="page-head">
      <h1>{title}</h1>
      {lede && <p class="lede">{lede}</p>}
    </header>
    <slot />
  </div>
</BaseLayout>
