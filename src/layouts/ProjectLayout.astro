---
// src/layouts/ProjectLayout.astro
import Layout from './Layout.astro';
import { getExperience, getEducation, getVolunteering } from '@/lib/api';
import type { CollectionEntry } from 'astro:content';
import ProjectMeta from '../components/ProjectMeta.astro';
import Figure from '../components/Figure.astro';
import RelatedProjects from '../components/RelatedPosts.astro';
import { getReadingTime } from '../utils/readingTime';
import videosData from '../data/videos.json';
import { isEvidenceReady, cleanText } from '../lib/content-quality.mjs';

interface Props {
  project?: CollectionEntry<'projects'>;
  initiative?: CollectionEntry<'initiatives'>;
  caseStudy?: CollectionEntry<'caseStudies'>;
  event?: CollectionEntry<'events'>;
  title?: string;
  description?: string;
  relatedProjects?: CollectionEntry<'projects'>[];
}

const {
  project,
  initiative,
  caseStudy,
  event,
  relatedProjects = [],
  title: propTitle,
  description: propDescription,
} = Astro.props;

const source = project ?? initiative ?? caseStudy ?? event;
const kind = project
  ? 'project'
  : initiative
    ? 'initiative'
    : caseStudy
      ? 'caseStudy'
      : 'event';

const data = source ? source.data : {};

const {
  title: sourceTitle = '',
  description: sourceDescription = '',
  excerpt,
  startDate = new Date(),
  endDate,
  updatedDate,
  category = [],
  tags = [],
  heroImage,
  heroAlt,
  imageCredit,
  canonical,
  noindex = false,
  type,
  status,
  client,
  organisation,
  institution,
} = data as Record<string, any>;

const title = propTitle || sourceTitle;
// Template text is never shown, and stub entries stay out of search until they carry real evidence.
const description = cleanText(propDescription) || cleanText(sourceDescription) || cleanText(excerpt);
const isStub = kind !== 'event' && !isEvidenceReady(data, (source as { body?: string } | undefined)?.body ?? '');

function processVideos(data: unknown[]) {
  return data.map((item) => {
    const video = item as Record<string, unknown>;
    const rawId = typeof video.youtubeId === "string" ? video.youtubeId : "";
    const cleanId = rawId.replace(/^v=/, "").split("&")[0].split("?")[0];
    const itemTitle = typeof video.title === "string" ? video.title : "";
    
    const slug = itemTitle.trim()
      ? itemTitle.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "")
      : cleanId || "video";

    return {
      ...video,
      youtubeId: cleanId,
      slug,
    };
  });
}

await Promise.all([
  getExperience(),
  getEducation(),
  getVolunteering(),
]);

processVideos(videosData);

const body = source?.body ?? '';
const readingTime = getReadingTime(body);
const safeRelatedProjects = Array.isArray(relatedProjects) ? relatedProjects : [];
const safeTags = Array.isArray(tags) ? tags : [];
const safeCategory = Array.isArray(category) ? category : [];

const resolvedHeroSrc = typeof heroImage === 'string' ? heroImage : '';
const resolvedHeroAlt = heroAlt || title || 'Hero image';
const resolvedHeroCredit = imageCredit;

const slug = Astro.params.slug;
const defaultLabel =
  kind === 'initiative'
    ? 'Initiative'
    : kind === 'caseStudy'
      ? 'Case Study'
      : kind === 'event'
        ? 'Event'
        : 'Project';

const pageTitle = title || slug || defaultLabel;
const pageDescription = description || `Details for ${pageTitle}.`;

const baseUrl = Astro.site?.href;
const basePath =
  kind === 'initiative'
    ? 'initiatives'
    : kind === 'caseStudy'
      ? 'case-studies'
      : kind === 'event'
        ? 'events'
        : 'projects';

const pageUrl = baseUrl ? new URL(`/${basePath}/${slug}/`, baseUrl).href : undefined;

const PERSON_ID = `${(baseUrl ?? 'https://rjmlaird.co.uk/').replace(/\/$/, '')}/#person`;
const mainEntity = {
  '@type': kind === 'event' ? 'Event' : 'CreativeWork',
  name: pageTitle,
  headline: pageTitle,
  description: pageDescription,
  image: resolvedHeroSrc ? [resolvedHeroSrc] : undefined,
  author: kind === 'event' ? undefined : { '@id': PERSON_ID },
  organizer: kind === 'event' ? { '@id': PERSON_ID } : undefined,
  dateCreated: startDate?.toISOString?.(),
  dateModified: (updatedDate ?? startDate)?.toISOString?.(),
  keywords: safeTags.length > 0 ? safeTags.join(', ') : undefined,
};
---

<Layout
  mainEntity={mainEntity}
  title={pageTitle}
  description={pageDescription}
  image={resolvedHeroSrc || undefined}
  canonical={canonical}
  noindex={noindex || isStub}
>
  <article class="project">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li>
          <a href={`/${basePath}/`}>
            {kind === 'initiative'
              ? 'Initiatives'
              : kind === 'caseStudy'
                ? 'Case Studies'
                : kind === 'event'
                  ? 'Events'
                  : 'Projects'}
          </a>
        </li>
        <li aria-current="page">{pageTitle}</li>
      </ol>
    </nav>

    <header class="project-header">
      <div class="title-wrap">
        <h1>{pageTitle}</h1>
      </div>
    </header>

    {resolvedHeroSrc && (
      <Figure
        src={resolvedHeroSrc}
        alt={resolvedHeroAlt}
        credit={resolvedHeroCredit ? `${resolvedHeroCredit}` : undefined}
        wide
        loading="eager"
      />
    )}

    <ProjectMeta
      type={type}
      status={status}
      client={client}
      organisation={organisation}
      institution={institution}
      startDate={startDate}
      endDate={endDate}
      updatedDate={updatedDate}
      readingTime={readingTime}
      category={safeCategory}
      tags={safeTags}
    />

    <slot />

    <footer class="project-footer">
      <RelatedProjects posts={safeRelatedProjects} />
    </footer>
  </article>
</Layout>