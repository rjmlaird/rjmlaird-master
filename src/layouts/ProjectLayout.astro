---
// src/layouts/ProjectLayout.astro
import type { CollectionEntry } from "astro:content";
import Layout from "./Layout.astro";
import ProjectMeta from "../components/ProjectMeta.astro";
import Figure from "../components/Figure.astro";
import RelatedProjects from "../components/RelatedPosts.astro";
import { getReadingTime } from "../utils/readingTime";
import { cleanText, isEvidenceReady } from "../lib/content-quality.mjs";

type WorkEntry =
  | CollectionEntry<"projects">
  | CollectionEntry<"initiatives">
  | CollectionEntry<"caseStudies">
  | CollectionEntry<"events">;

type WorkKind = "project" | "initiative" | "caseStudy" | "event";

interface Props {
  project?: CollectionEntry<"projects">;
  initiative?: CollectionEntry<"initiatives">;
  caseStudy?: CollectionEntry<"caseStudies">;
  event?: CollectionEntry<"events">;
  title?: string;
  description?: string;
  relatedProjects?: CollectionEntry<"projects">[];
}

const {
  project,
  initiative,
  caseStudy,
  event,
  title: propTitle,
  description: propDescription,
  relatedProjects = [],
} = Astro.props;

const source: WorkEntry | undefined =
  project ?? initiative ?? caseStudy ?? event;

const kind: WorkKind = project
  ? "project"
  : initiative
    ? "initiative"
    : caseStudy
      ? "caseStudy"
      : "event";

if (!source) {
  throw new Error(
    "ProjectLayout requires a project, initiative, caseStudy, or event entry."
  );
}

const data = source.data;

const title = propTitle ?? data.title ?? "";
const summary =
  "summary" in data && typeof data.summary === "string" ? data.summary : "";

const description =
  cleanText(propDescription) ||
  cleanText(data.description) ||
  cleanText(data.excerpt) ||
  cleanText(summary);

const body = source.body ?? "";
const isStub = kind !== "event" && !isEvidenceReady(data, body);
const readingTime = getReadingTime(body);

const safeRelatedProjects = Array.isArray(relatedProjects)
  ? relatedProjects
  : [];

const safeTags = Array.isArray(data.tags) ? data.tags : [];
const safeCategory = Array.isArray(data.category) ? data.category : [];

const heroImage =
  typeof data.heroImage === "string" ? data.heroImage : undefined;

const heroAlt =
  typeof data.heroAlt === "string" && data.heroAlt.trim()
    ? data.heroAlt
    : title || "Project hero image";

const imageCredit =
  typeof data.imageCredit === "string" && data.imageCredit.trim()
    ? data.imageCredit
    : undefined;

const canonical =
  typeof data.canonical === "string" && data.canonical.trim()
    ? data.canonical
    : undefined;

const noindex = data.noindex ?? false;

const startDate =
  data.startDate instanceof Date ? data.startDate : undefined;
const endDate = data.endDate instanceof Date ? data.endDate : undefined;
const updatedDate =
  data.updatedDate instanceof Date ? data.updatedDate : undefined;

const type = typeof data.type === "string" ? data.type : undefined;
const status = typeof data.status === "string" ? data.status : undefined;
const client = typeof data.client === "string" ? data.client : undefined;
const organisation =
  typeof data.organisation === "string" ? data.organisation : undefined;
const institution =
  typeof data.institution === "string" ? data.institution : undefined;

const slug = Astro.params.slug ?? source.id;

const defaultLabel =
  kind === "initiative"
    ? "Initiative"
    : kind === "caseStudy"
      ? "Case study"
      : kind === "event"
        ? "Event"
        : "Project";

const pageTitle = title || slug || defaultLabel;
const pageDescription = description || `Details and documentation for ${pageTitle}.`;

const basePath =
  kind === "initiative"
    ? "work/initiatives"
    : kind === "caseStudy"
      ? "work/case-studies"
      : kind === "event"
        ? "events"
        : "work/projects";

const personBaseUrl = (Astro.site?.href ?? "https://rjmlaird.co.uk/").replace(
  /\/$/,
  ""
);
const personId = `${personBaseUrl}/#person`;

const mainEntity = {
  "@type": kind === "event" ? "Event" : "CreativeWork",
  name: pageTitle,
  headline: pageTitle,
  description: pageDescription,
  image: heroImage ? [new URL(heroImage, personBaseUrl).href] : undefined,
  author: kind === "event" ? undefined : { "@id": personId },
  organizer: kind === "event" ? { "@id": personId } : undefined,
  dateCreated: startDate?.toISOString(),
  dateModified: (updatedDate ?? startDate)?.toISOString(),
  keywords: safeTags.length > 0 ? safeTags.join(", ") : undefined,
};
---

<Layout
  mainEntity={mainEntity}
  title={pageTitle}
  description={pageDescription}
  image={heroImage}
  canonical={canonical}
  noindex={noindex || isStub}
>
  <article class="project-detail-view fade in">
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
      <ol class="breadcrumb-list">
        <li><a href="/">Home</a></li>
        <li aria-hidden="true">/</li>
        <li>
          <a href={`/${basePath}/`}>
            {
              kind === "initiative"
                ? "Initiatives"
                : kind === "caseStudy"
                  ? "Case studies"
                  : kind === "event"
                    ? "Events"
                    : "Projects"
            }
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li aria-current="page">{pageTitle}</li>
      </ol>
    </nav>

    <header class="project-header page-head">
      <div class="title-wrap">
        <h1>{pageTitle}</h1>
      </div>
    </header>

    {
      heroImage && (
        <div class="project-hero-media">
          <Figure
            src={heroImage}
            alt={heroAlt}
            credit={imageCredit}
            wide
            loading="eager"
          />
        </div>
      )
    }

    <ProjectMeta
      type={type}
      status={status}
      client={client}
      organisation={organisation}
      institution={institution}
      startDate={startDate}
      endDate={endDate}
      updatedDate={updatedDate}
      readingTime={readingTime}
      category={safeCategory}
      tags={safeTags}
    />

    <div class="project-content prose">
      <slot />
    </div>

    {
      safeRelatedProjects.length > 0 && (
        <footer class="project-footer">
          <div class="related-section-divider" />
          <RelatedProjects posts={safeRelatedProjects} />
        </footer>
      )
    }
  </article>
</Layout>

<style>
  .project-detail-view {
    max-width: var(--content-max);
    margin-inline: auto;
    padding-bottom: 4rem;
  }

  .breadcrumb-nav {
    margin-bottom: 1.5rem;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    color: var(--mb);
  }

  .breadcrumb-list {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    flex-wrap: wrap;
  }

  .breadcrumb-list a {
    color: var(--mb);
    text-decoration: none;
    transition: color 0.2s;
  }

  .breadcrumb-list a:hover {
    color: var(--teal);
  }

  .breadcrumb-list [aria-current="page"] {
    color: var(--w);
    font-weight: 500;
  }

  .project-hero-media {
    margin-bottom: 2rem;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--bd);
  }

  .project-content {
    margin-top: 2.5rem;
  }

  .project-footer {
    margin-top: 4rem;
  }

  .related-section-divider {
    height: 1px;
    background: var(--bd);
    margin-bottom: 2.5rem;
  }
</style>