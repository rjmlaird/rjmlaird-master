---
// src/layouts/Layout.astro
import "../styles/global.css";
import "../styles/pages.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import JsonLd from "../components/JsonLd.astro";
import type { CollectionEntry } from 'astro:content';
import nav from "../data/nav.json";
import { loadSchemaSource } from "../lib/schema-org/source";
import { buildPageGraph, type Crumb, type PageType } from "../lib/schema-org/graph";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonical?: string;
  post?: CollectionEntry<'blog'> | CollectionEntry<'projects'> | CollectionEntry<'caseStudies'>;
  headings?: { depth: number; slug: string; text: string }[];
  relatedPosts?: CollectionEntry<'blog'>[];
  /** Page-specific structured data (Article, PodcastEpisode, CreativeWork, BreadcrumbList...)
   *  merged alongside the site-wide WebSite + Person schema below. */
  jsonLd?: Record<string, any> | Record<string, any>[];
  /** schema.org page type (default WebPage). ProfilePage/AboutPage make the page "about" the Person. */
  schemaType?: PageType;
  /** Force the full Person profile into the graph (it is automatic on home, about, cv, contact, work-with-me, press). */
  schemaFull?: boolean;
  /** Explicit breadcrumb trail; omit to derive it from the URL. */
  breadcrumbs?: Crumb[];
  /** The page's primary entity (BlogPosting, PodcastEpisode, VideoObject ...), linked to the WebPage by @id. */
  mainEntity?: Record<string, any>;
  datePublished?: string | Date;
  dateModified?: string | Date;
}

const {
  title = "Ryan Laird — CMktr MInstP",
  description = "Ryan Laird is an astrophysicist, science communicator and strategist working across space, sustainability and technology.",
  image = "/images/og-default.jpg",
  noindex = false,
  canonical,
  post,
  jsonLd,
  schemaType,
  schemaFull,
  breadcrumbs,
  mainEntity,
  datePublished,
  dateModified,
} = Astro.props as Props;

const postData = post?.data as Record<string, any> | undefined;

const resolvedTitle = postData?.title ?? title;
const resolvedDescription = postData?.description ?? description;
const resolvedImage = postData?.heroImage?.src ?? postData?.image ?? image;
const resolvedNoindex = postData?.noindex ?? noindex;

const siteTitle = "Ryan Laird — CMktr MInstP";
const fullTitle = resolvedTitle === siteTitle ? resolvedTitle : `${resolvedTitle} · ${siteTitle}`;

const baseUrl = Astro.site?.href;
const canonicalUrl =
  canonical ?? postData?.canonical ?? (baseUrl ? new URL(Astro.url.pathname, baseUrl).href : Astro.url.href);

const ogImage = baseUrl ? new URL(resolvedImage, baseUrl).href : resolvedImage;

const siteUrl = (baseUrl ?? "https://rjmlaird.co.uk").replace(/\/$/, "");

// Pages that are about Ryan carry the full Person profile; everything else gets the light Person node.
const FULL_PROFILE_PATHS = new Set(["/", "/about/", "/cv/", "/contact/", "/work-with-me/", "/press/"]);
const path = Astro.url.pathname;
const knownSections = [...(nav.primary ?? []), ...(nav.utility ?? [])]
  .map((n: { href: string }) => n.href)
  .filter((h: string) => h.startsWith("/"))
  .map((h: string) => h.split("/").filter(Boolean)[0])
  .filter(Boolean)
  .concat(["blog", "podcasts", "videos", "projects", "case-studies", "research", "dev", "mentoring", "coaching", "initiatives", "events", "awards", "press", "teaching"]);

const schemaSource = await loadSchemaSource();
const stripContext = (n: Record<string, any>) => {
  const { ["@context"]: _ctx, ...rest } = n;
  return rest;
};
const extraNodes = (jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []).flatMap((n) =>
  n["@graph"] ? (n["@graph"] as Record<string, any>[]) : [stripContext(n)],
);
const pageGraph = buildPageGraph(schemaSource, {
  siteUrl,
  path,
  // The graph describes this site's own URL even when <link rel=canonical> points elsewhere (e.g. syndicated podcasts).
  canonicalUrl: new URL(path, `${siteUrl}/`).href,
  title: resolvedTitle,
  description: resolvedDescription,
  imageUrl: ogImage,
  type: schemaType,
  full: schemaFull ?? FULL_PROFILE_PATHS.has(path),
  breadcrumbs,
  datePublished,
  dateModified,
  mainEntity,
  extras: extraNodes,
  knownSections: Array.from(new Set(knownSections)),
});
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{fullTitle}</title>
    <meta name="description" content={resolvedDescription} />
    {resolvedNoindex ? <meta name="robots" content="noindex, nofollow" /> : null}
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={resolvedDescription} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@300;400;500&display=swap"
      rel="stylesheet"
    />

    <JsonLd id="jsonld" json={pageGraph} />

    <slot name="head" />
  </head>

  <body>
    <a href="#content" class="skip-link">Skip to content</a>
    <Nav />
    <main id="content">
      <slot />
    </main>
    <Footer />

    <script is:inline>
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("in");
              io.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.07 }
      );

      document.querySelectorAll(".fade").forEach((el) => io.observe(el));
    </script>
  </body>
</html>

