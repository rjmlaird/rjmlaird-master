---
// src/layouts/VideoLayout.astro
import Layout from "./Layout.astro";
import type { CollectionEntry } from "astro:content";
import VideoMeta from "../components/VideoMeta.astro";
import VideoSidebar from "../components/VideoSidebar.astro";
import Figure from "../components/Figure.astro";

type VideoEntry = CollectionEntry<any>;
type VideoData = Record<string, any>;

interface Props {
  video?: VideoEntry;
  title?: string;
  description?: string;
}

const { video, title: propTitle, description: propDescription } = Astro.props as Props;
const data = (video && typeof video === 'object' && 'data' in video ? ((video as any).data ?? {}) : {}) as Partial<VideoData>;

const sourceTitle = data.title ?? "";
const sourceDescription = data.description ?? "";
const excerpt = data.excerpt;
const updatedDate = data.updatedDate;
const categories = data.category ?? [];
const tags = data.tags ?? [];
const canonical = data.canonical;
const noindex = data.noindex ?? false;

const heroImage = data.heroImage;
const youtubeId = data.youtubeId;
const videoUrl = data.url;
const client = data.client;
const organisation = data.organisation;
const credits = data.credits;
const videoType = data.video_type;
const status = data.status;

const publishedDate = data.publishedDate;
const duration = data.duration;

const safeCategories = Array.isArray(categories) ? categories : [];
const safeTags = Array.isArray(tags) ? tags : [];

const resolvedHeroImage = heroImage || (youtubeId ? `https://img.youtube.com/vi/${youtubeId}/maxresdefault.jpg` : "");
const resolvedEmbedSrc = youtubeId ? `https://www.youtube-nocookie.com/embed/${youtubeId}` : "";

const pageTitle = propTitle || sourceTitle || Astro.params.slug || "Video";
const pageDescription = propDescription || sourceDescription || excerpt || `Details for ${pageTitle}.`;
const parsedPublishedDate = publishedDate ? new Date(publishedDate) : undefined;

function toIsoDuration(raw?: string): string | undefined {
  if (!raw) return undefined;
  const m = raw.match(/(\d+)M/);
  const s = raw.match(/(\d+)S/);
  if (!m && !s) return undefined;
  return `PT${m ? `${m[1]}M` : ''}${s ? `${s[1]}S` : ''}`;
}

const videoObjectSchema = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: pageTitle,
  description: pageDescription,
  thumbnailUrl: resolvedHeroImage ? [resolvedHeroImage] : undefined,
  uploadDate: parsedPublishedDate?.toISOString?.(),
  datePublished: parsedPublishedDate?.toISOString?.(),
  duration: toIsoDuration(duration),
  contentUrl: videoUrl,
  embedUrl: resolvedEmbedSrc || undefined,
  publisher: organisation || client ? { '@type': 'Organization', name: organisation || client } : undefined,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site ? new URL('/', Astro.site).href : '/' },
    { '@type': 'ListItem', position: 2, name: 'Videos', item: Astro.site ? new URL('/videos/', Astro.site).href : '/videos/' },
    { '@type': 'ListItem', position: 3, name: pageTitle },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image={resolvedHeroImage || undefined}
  canonical={canonical}
  noindex={noindex}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(videoObjectSchema)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />
  </Fragment>

  <article class="video-page">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li><a href="/videos/">Videos</a></li>
        <li aria-current="page">{pageTitle}</li>
      </ol>
    </nav>

    <header class="video-header">
      <div class="title-wrap">
        <h1>{pageTitle}</h1>
      </div>
    </header>

    <VideoMeta
      type={videoType}
      status={status}
      client={client}
      organisation={organisation}
      publishedDate={parsedPublishedDate}
      updatedDate={updatedDate ? new Date(updatedDate) : undefined}
      duration={duration}
      category={safeCategories}
      tags={safeTags}
    />

    <section class="video-layout">
      <div class="video-layout__content">
        {resolvedEmbedSrc ? (
          <div class="video-embed-container">
            <iframe
              src={resolvedEmbedSrc}
              title={pageTitle}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="eager"
            ></iframe>
          </div>
        ) : resolvedHeroImage ? (
          <Figure src={resolvedHeroImage} alt={pageTitle} wide loading="eager" />
        ) : null}

        <slot />

        {credits && (
          <div class="video-credits">
            <h3>Credits & Production</h3>
            <p>{credits}</p>
          </div>
        )}
      </div>

      <aside class="video-layout__sidebar">
        <VideoSidebar
          title={pageTitle}
          description={pageDescription}
          client={client}
          organisation={organisation}
          publishedDate={parsedPublishedDate}
          duration={duration}
          videoUrl={videoUrl}
          youtubeId={youtubeId}
          heroImage={resolvedHeroImage}
          credits={credits}
          tags={safeTags}
        />
      </aside>
    </section>
  </article>
</Layout>

<style>
  .video-layout {
    display: grid;
    gap: 2rem;
    grid-template-columns: minmax(0, 1fr);
  }

  .video-layout__content,
  .video-layout__sidebar {
    min-width: 0;
  }

  .video-embed-container {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    border-radius: 0.5rem;
    margin: 1rem 0 1.5rem;
    background: var(--color-surface-muted, #000);
  }

  .video-embed-container iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video-credits {
    margin-block: 2rem;
    padding: 1.25rem;
    background: var(--color-surface-subtle, rgba(0, 0, 0, 0.03));
    border-radius: 0.375rem;
    font-size: 0.9rem;
  }

  .video-credits h3 {
    margin-bottom: 0.5rem;
    font-size: 1rem;
  }

  @media (min-width: 900px) {
    .video-layout {
      grid-template-columns: minmax(0, 2fr) minmax(320px, 1fr);
      align-items: start;
    }

    .video-layout__sidebar {
      position: sticky;
      top: 2rem;
    }
  }
</style>