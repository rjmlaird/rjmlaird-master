---
// src/pages/videos/[slug].astro
import VideoLayout from "../../layouts/VideoLayout.astro";
import VideoSidebar from "../../components/VideoSidebar.astro";
import ImpactStats from "../../components/ImpactStats.astro";
import { getExperience, getEducation, getVolunteering, getAwards, getVideos } from "@/lib/api";
import YouTubeEmbed from "../../components/YouTubeEmbed.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const entries = await getVideos();

  return entries.map((entry: any) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: any };
const slug = Astro.params.slug;
const video = entry;

const sectors = Array.isArray(video.sectors) ? video.sectors : [];
const tools = Array.isArray(video.tools_tech) ? video.tools_tech : [];
const features = Array.isArray(video.features) ? video.features : [];
const links = video.links || {};

const youtubeUrl = video.url || links.youtube;
const youtubeId = video.youtubeId;

const [
  experienceItems,
  educationItems,
  volunteeringItems,
  awardsItems,
  projectItems,
  eventItems,
  allVideos,
] = await Promise.all([
  getExperience(),
  getEducation(),
  getVolunteering(),
  getAwards(),
  getCollection("projects"),
  getCollection("events"),
  getVideos(),
]);

const relatedExperienceIds = Array.isArray(video.relatedExperience) ? video.relatedExperience : [];
const relatedEducationIds = Array.isArray(video.relatedEducation) ? video.relatedEducation : [];
const relatedOrgIds = Array.isArray(video.relatedOrg) ? video.relatedOrg : [];
const relatedVolunteeringIds = Array.isArray(video.relatedVolunteering) ? video.relatedVolunteering : [];
const relatedAwardIds = Array.isArray(video.relatedAwards) ? video.relatedAwards : [];
const relatedProjectIds = Array.isArray(video.relatedProjects) ? video.relatedProjects : [];
const relatedEventIds = Array.isArray(video.relatedEvents) ? video.relatedEvents : [];
const relatedVideoIds = Array.isArray(video.relatedVideos) ? video.relatedVideos : [];

const relatedExperience = experienceItems.filter((item: any) =>
  relatedExperienceIds.includes(item.id ?? item.slug)
);

const relatedEducation = educationItems.filter((item: any) =>
  relatedEducationIds.includes(item.id ?? item.slug)
);

const relatedOrganisations = volunteeringItems.filter((item: any) =>
  relatedOrgIds.includes(item.id ?? item.slug)
);

const relatedVolunteering = volunteeringItems.filter((item: any) =>
  relatedVolunteeringIds.includes(item.id ?? item.slug)
);

const relatedAwards = awardsItems.filter((item: any) =>
  relatedAwardIds.includes(item.id ?? item.slug)
);

const relatedProjects = projectItems.filter((item: any) =>
  relatedProjectIds.includes(item.id ?? item.slug)
);

const relatedEvents = eventItems.filter((item: any) =>
  relatedEventIds.includes(item.id ?? item.slug)
);

const relatedVideos = allVideos.filter((item: any) =>
  relatedVideoIds.includes(item.slug ?? item.id)
);

const pageTitle = video.title || slug || "Video";
const pageDescription = video.description || video.summary || `Video details for ${pageTitle}.`;
---

<VideoLayout
  title={pageTitle}
  description={pageDescription}
>
  <section class="section publications-gallery">
    <div class="project-layout">
      <VideoSidebar
        title={pageTitle}
        description={pageDescription}
        client={video.client}
        organisation={video.organisation}
        publishedDate={video.publishedDate ? new Date(video.publishedDate) : undefined}
        duration={video.duration}
        videoUrl={youtubeUrl}
        youtubeId={youtubeId}
        heroImage={video.heroImage}
        credits={video.credits || video.production_credit}
        tags={video.tags}
        sectors={sectors}
        tools={tools}
        features={features}
        relatedExperience={relatedExperience}
        relatedEducation={relatedEducation}
        relatedOrganisations={relatedOrganisations}
        relatedVolunteering={relatedVolunteering}
        relatedAwards={relatedAwards}
        relatedProjects={relatedProjects}
        relatedEvents={relatedEvents}
        relatedVideos={relatedVideos}
        links={links}
      />

      <article class="project-content">
        <div class="project-body">
          <div class="pg-intro">
            {video.description && <p class="pg-lead">{video.description}</p>}
          </div>

          <YouTubeEmbed id={youtubeId} url={youtubeUrl} />

          {video.summary && (
            <div class="video-summary">
              <h3>Summary</h3>
              <p>{video.summary}</p>
            </div>
          )}

          {video.production_credit && (
            <div class="video-credit">
              <p><em>{video.production_credit}</em></p>
            </div>
          )}
        </div>

        {video.impact && Object.keys(video.impact).length > 0 && (
          <section class="sidebar-block">
            <h2>Impact</h2>
            <ImpactStats impact={video.impact} />
          </section>
        )}
      </article>
    </div>
  </section>
</VideoLayout>