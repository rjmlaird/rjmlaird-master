---
// src/pages/work/case-studies/index.astro
import Layout from "../../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import ProjectCard from "../../../components/Projects/ProjectCard.astro";
import Filters from "../../../components/Projects/Filters.astro";
import IndexHero from "../../../components/Index/IndexHero.astro";
import CardGrid from "../../../components/Index/CardGrid.astro";

const caseStudies = await getCollection("caseStudies", ({ data }) => data.draft !== true);

const sortedCaseStudies = caseStudies.sort((a, b) =>
  (a.data.title ?? "").localeCompare(b.data.title ?? "")
);
---

<Layout
  title="Case studies"
  description="Selected case studies in space, sustainability and science communication: the brief, my role and what changed."
>
  <section class="project-index">
    <div class="pg-shell">
      <IndexHero
        eyebrow="Case studies"
        title="Selected work, written up"
        accent="the brief, my role, the outcome"
        lede="Fuller accounts of projects in space, Earth observation and science communication."
        stats={[`${sortedCaseStudies.length} case studies`]}
      />

      <Filters items={sortedCaseStudies} noun="case studies" />

      <CardGrid label="Case studies">
        {sortedCaseStudies.map((caseStudy) => <ProjectCard caseStudy={caseStudy} />)}
      </CardGrid>
    </div>
  </section>
</Layout>
