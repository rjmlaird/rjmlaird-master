---
import Layout from "../../../layouts/Layout.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import ProjectCard from "../../../components/Projects/ProjectCard.astro";
import Filters from "../../../components/Projects/Filters.astro";
import IndexHero from "../../../components/Index/IndexHero.astro";
import CardGrid from "../../../components/Index/CardGrid.astro";

const initiatives = await getCollection("initiatives", ({ data }) => data.draft !== true);

const sortByTitle = (a: CollectionEntry<"initiatives">, b: CollectionEntry<"initiatives">) =>
  (a.data.title ?? "").localeCompare(b.data.title ?? "");

const sortedInitiatives = initiatives.sort(sortByTitle);
---

<Layout
  title="Initiatives"
  description="Community-led initiatives in space and science communication that I run or support, including Leicester Space Week, Space for Neurodiversity and Spaceoneers."
>
  <section class="project-index">
    <div class="pg-shell">
      <IndexHero
        eyebrow="Initiatives"
        title="Initiatives I run"
        accent="and support"
        lede="Community-led programmes in space and science communication, from Leicester Space Week to Space for Neurodiversity and Spaceoneers."
        stats={[`${sortedInitiatives.length} initiatives`]}
      />

      <Filters items={sortedInitiatives} noun="initiatives" />

      <CardGrid label="Initiatives">
        {sortedInitiatives.map((initiative) => <ProjectCard initiative={initiative} />)}
      </CardGrid>
    </div>
  </section>
</Layout>
