---
import Layout from "../../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import ProjectCard from "../../../components/Projects/ProjectCard.astro";
import Filters from "../../../components/Projects/Filters.astro";
import IndexHero from "../../../components/Index/IndexHero.astro";
import CardGrid from "../../../components/Index/CardGrid.astro";

const events = (await getCollection("events", ({ data }) => data.draft !== true))
  .sort((a, b) => {
    const aDate = a.data.startDate ? new Date(a.data.startDate).getTime() : 0;
    const bDate = b.data.startDate ? new Date(b.data.startDate).getTime() : 0;
    return bDate - aDate;
  });

const years = events
  .map((e) => (e.data.startDate ? new Date(e.data.startDate).getFullYear() : NaN))
  .filter((y) => Number.isFinite(y));
const span = years.length ? `${Math.min(...years)}–${Math.max(...years)}` : "";
---

<Layout
  title="Events"
  description="Space, sustainability and science-communication events I have organised, hosted or taken part in. Search by title, filter by year, tag, type or format."
>
  <section class="project-index">
    <div class="pg-shell">
      <IndexHero
        eyebrow="Events"
        title="Events across"
        accent="space, sustainability & science policy"
        lede="Meetups, live broadcasts, conferences and bootcamps I have organised, hosted or taken part in. Newest first."
        stats={[`${events.length} events`, ...(span ? [span] : [])]}
      />

      <Filters items={events} noun="events" />

      <CardGrid label="Events">
        {events.map((event) => <ProjectCard event={event} />)}
      </CardGrid>
    </div>
  </section>
</Layout>
