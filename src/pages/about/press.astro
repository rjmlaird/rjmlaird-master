---
import Layout from '../../layouts/Layout.astro';
import profile from '../../data/profile.json';
import mentions from '../../data/press-mentions.json';

const sortedMentions = [...mentions].sort(
  (a, b) => new Date(b.date).valueOf() - new Date(a.date).valueOf()
);

const siteUrl = Astro.site?.href ?? 'https://rjmlaird.co.uk/';
const headshotUrl = new URL(profile.avatar, siteUrl).href;
const logoUrl = new URL('/img/space-logo.png', siteUrl).href;

const typeLabels: Record<string, string> = {
  podcast: 'Podcast appearance',
  article: 'Article / feature',
  quote: 'Press quote',
};

// Press mentions as an ItemList, reflecting exactly what is rendered below. The ProfilePage itself comes from Layout.
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Press mentions',
    itemListElement: sortedMentions.map((m, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: m.title,
      url: m.externalUrl || (m.url ? new URL(m.url, siteUrl).href : undefined),
    })),
  },
];
---

<Layout
  title="Press &amp; Media"
  description="Press kit and media mentions for Ryan Laird — bio, credentials, headshot, and appearances including The EcoSend Podcast."
  jsonLd={jsonLd}
  schemaType="ProfilePage"
>
  <section class="press">
    <header class="press-head">
      <p class="eyebrow">Press &amp; Media</p>
      <h1>Press kit</h1>
      <p class="intro">Core bio, credentials, and downloadable assets for press, podcast, and speaking enquiries.</p>
    </header>

    <div class="kit-grid">
      <img src={profile.avatar} alt={profile.name} class="headshot" width="200" height="200" />
      <div class="kit-body">
        <h2>{profile.name}</h2>
        <p class="role">{profile.role} &middot; {profile.credentials}</p>
        <p class="bio">{profile.biography[0]}</p>
        <div class="downloads">
          <a href={headshotUrl} download class="btn">Download headshot</a>
          <a href={logoUrl} download class="btn btn-outline">Download logo</a>
          <a href={`mailto:${profile.email}`} class="btn btn-outline">Media enquiries</a>
        </div>
      </div>
    </div>

    <section class="mentions">
      <h2>As featured in</h2>
      {sortedMentions.length > 0 ? (
        <ul class="mentions-list">
          {sortedMentions.map((m) => (
            <li class="mention">
              {m.logo && <img src={m.logo} alt="" class="mention-logo" width="56" height="56" />}
              <div class="mention-body">
                <span class="mention-type">{typeLabels[m.type] ?? m.type}</span>
                <h3>
                  <a href={m.externalUrl ?? m.url}>{m.title}</a>
                </h3>
                <p class="mention-outlet">
                  {m.outlet} &middot; <time datetime={m.date}>{new Date(m.date).toLocaleDateString('en-GB', { year: 'numeric', month: 'long' })}</time>
                </p>
                <p class="mention-desc">{m.description}</p>
                {m.url && m.externalUrl && (
                  <a href={m.url} class="internal-link">Read the full write-up on this site &rarr;</a>
                )}
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">More press mentions coming soon.</p>
      )}
    </section>
  </section>
</Layout>

<style>
  .press {
    max-width: 900px;
    margin-inline: auto;
    padding: 2.5rem 1.5rem 4rem;
  }
  .press-head {
    margin-bottom: 2.5rem;
  }
  .eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 0.3rem;
  }
  .press-head h1 {
    margin: 0 0 0.5rem;
  }
  .intro {
    color: var(--color-text-muted);
    max-width: 60ch;
  }

  .kit-grid {
    display: flex;
    gap: 1.75rem;
    padding: 1.75rem;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    margin-bottom: 3rem;
    flex-wrap: wrap;
  }
  .headshot {
    width: 140px;
    height: 140px;
    border-radius: 10px;
    object-fit: cover;
    flex-shrink: 0;
  }
  .kit-body {
    flex: 1;
    min-width: 240px;
  }
  .kit-body h2 {
    margin: 0 0 0.2rem;
  }
  .role {
    color: var(--color-accent);
    font-size: 0.9rem;
    margin: 0 0 0.9rem;
  }
  .bio {
    color: var(--color-text-muted);
    line-height: 1.6;
    max-width: 60ch;
  }
  .downloads {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 1rem;
  }
  .btn {
    padding: 0.55rem 1.1rem;
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    background: var(--color-accent);
    color: #fff;
  }
  .btn-outline {
    background: transparent;
    border: 1px solid var(--color-border);
    color: var(--color-text);
  }

  .mentions h2 {
    margin-bottom: 1.5rem;
  }
  .mentions-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .mention {
    display: flex;
    gap: 1rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }
  .mention:last-child {
    border-bottom: none;
  }
  .mention-logo {
    border-radius: 8px;
    object-fit: cover;
    flex-shrink: 0;
  }
  .mention-type {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .mention-body h3 {
    margin: 0.2rem 0 0.2rem;
    font-size: 1.05rem;
  }
  .mention-body h3 a {
    color: inherit;
    text-decoration: none;
  }
  .mention-body h3 a:hover {
    color: var(--color-accent);
  }
  .mention-outlet {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin: 0 0 0.5rem;
  }
  .mention-desc {
    font-size: 0.9rem;
    line-height: 1.55;
    margin: 0 0 0.5rem;
  }
  .internal-link {
    font-size: 0.85rem;
    color: var(--color-accent);
    text-decoration: none;
  }
  .empty {
    color: var(--color-text-muted);
  }
</style>
