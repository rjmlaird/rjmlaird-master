---
import BaseLayout from '@brand/layouts/BaseLayout.astro';
import Breadcrumbs from '@brand/components/layout/Breadcrumbs.astro';
import { sections, type Section } from '@brand/lib/schemas';
import { sectionMeta } from '@brand/data/navigation';
import { getSectionEntries } from '@brand/lib/content';

export function getStaticPaths() {
  return sections.map((section) => ({ params: { section } }));
}
const section = Astro.params.section as Section;
const entries = await getSectionEntries(section);
---
<BaseLayout title={sectionMeta[section].title} description={sectionMeta[section].summary}>
  <div class="wrap">
    <Breadcrumbs section={section} />
    <h1>{sectionMeta[section].title}</h1>
    <p class="lede">{sectionMeta[section].summary}</p>
    <div class="grid">
      {entries.map((e) => (
        <a class="card link-card" href={e.href}>
          <h3>{e.title}</h3>
          <p>{e.description}</p>
          {e.status && e.status !== 'stable' && <span class={`badge ${e.status}`}>{e.status}</span>}
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
