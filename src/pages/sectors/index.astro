---
// src/pages/sectors/index.astro
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const entries = await getCollection("sectors");

type SectorEntry = (typeof entries)[number];

const sectors = [...entries].sort((a, b) => {
  const aOrder = a.data.order ?? 99;
  const bOrder = b.data.order ?? 99;

  if (aOrder !== bOrder) return aOrder - bOrder;

  return a.data.title.localeCompare(b.data.title);
});

function sectorHref(entry: SectorEntry): string {
  const slug = entry.id.replace(/^\/+|\/+$/g, "");

  return `/sectors/${slug
    .split("/")
    .map((segment: string) => encodeURIComponent(segment))
    .join("/")}/`;
}

function searchText(entry: SectorEntry): string {
  const { data } = entry;

  return [
    data.title,
    data.description,
    ...(data.related ?? []),
    ...(data.excludes ?? []),
  ]
    .filter(Boolean)
    .join(" ")
    .toLowerCase();
}
---

<Layout
  title="Sectors"
  description="Explore the core industries, markets, and strategic domains we work across, including space, energy, transport, and digital technology."
>
  <section class="sector-index" data-sectors-index>
    <div class="container pg-shell">
      <header class="page-head">
        <p class="sl">Sectors</p>

        <h1 class="fade">
          Industries &amp; <em>strategic domains</em>
        </h1>

        <div class="lede">
          <p>
            Strategic positioning, commercial partnerships, and technical advisory
            across complex regulated markets and emerging technology ecosystems.
          </p>

          <p>
            Explore our work, policy frameworks, and digital architectures tailored
            to specific industry requirements. Read our development stories on the{" "}
            <a class="hp-link" href="/insights/blog/">blog</a>.
          </p>
        </div>

        {
          sectors.length > 0 && (
            <p class="sector-overview">
              <span>
                {sectors.length} active{" "}
                {sectors.length === 1 ? "sector" : "sectors"}
              </span>
            </p>
          )
        }
      </header>

      {
        sectors.length > 0 ? (
          <>
            <form
              class="sector-filters"
              data-sector-filters
              aria-label="Filter sectors"
              hidden
            >
              <div class="filter-field filter-search">
                <label for="sector-search">Search</label>

                <input
                  id="sector-search"
                  name="search"
                  type="search"
                  placeholder="Search sectors, related domains or keywords"
                  autocomplete="off"
                  aria-controls="sectorGrid"
                />
              </div>

              <button class="filter-reset" type="reset">
                Clear filters
              </button>
            </form>

            <p
              class="results-count"
              data-sector-count
              role="status"
              aria-live="polite"
              aria-atomic="true"
            >
              {sectors.length} {sectors.length === 1 ? "sector" : "sectors"}
            </p>

            <div class="sector-grid" id="sectorGrid">
              {sectors.map((sector) => {
                const { data } = sector;
                const href = sectorHref(sector);
                const relatedItems = data.related ?? [];

                return (
                  <article
                    class="sector-card"
                    data-sector-card
                    data-search={searchText(sector)}
                  >
                    {data.heroImage && (
                      <a
                        class="sector-card-image"
                        href={href}
                        tabindex="-1"
                        aria-hidden="true"
                      >
                        <img
                          src={data.heroImage}
                          alt={data.heroAlt ?? ""}
                          loading="lazy"
                          decoding="async"
                        />
                      </a>
                    )}

                    <div class="sector-card-body">
                      <div class="sector-card-meta">
                        {data.status && (
                          <span class="sector-category">
                            {data.status}
                          </span>
                        )}
                      </div>

                      <h2>
                        <a href={href}>{data.title}</a>
                      </h2>

                      <p class="sector-summary">{data.description}</p>

                      {relatedItems.length > 0 && (
                        <div class="sector-focus">
                          <p class="focus-label">Related domains</p>
                          <ul class="focus-tags" aria-label={`${data.title} related domains`}>
                            {relatedItems.map((area: string) => (
                              <li>
                                <span class="focus-tag">{area}</span>
                              </li>
                            ))}
                          </ul>
                        </div>
                      )}

                      <div class="sector-card-footer">
                        <a class="hp-link" href={href}>
                          Explore sector
                          <span aria-hidden="true"> →</span>
                          <span class="visually-hidden">
                            : {data.title}
                          </span>
                        </a>
                      </div>
                    </div>
                  </article>
                );
              })}
            </div>

            <div class="sector-empty" data-sector-empty hidden>
              <h2>No matching sectors</h2>
              <p>
                Try another search term or clear the filter to view all sectors.
              </p>
            </div>
          </>
        ) : (
          <div class="sector-empty">
            <h2>Sectors are on the way</h2>
            <p>Industry profiles will appear here as they are published.</p>
          </div>
        )
      }
    </div>
  </section>
</Layout>

<script>
  function initialiseSectorFilters() {
    document
      .querySelectorAll<HTMLElement>("[data-sectors-index]")
      .forEach((root) => {
        const form =
          root.querySelector<HTMLFormElement>("[data-sector-filters]");

        if (!form || form.dataset.initialised === "true") return;

        const search =
          form.querySelector<HTMLInputElement>('[name="search"]');

        const count =
          root.querySelector<HTMLElement>("[data-sector-count]");

        const empty =
          root.querySelector<HTMLElement>("[data-sector-empty]");

        if (!search || !count || !empty) {
          return;
        }

        const cards = Array.from(
          root.querySelectorAll<HTMLElement>("[data-sector-card]"),
        ).map((element) => ({
          element,
          search: element.dataset.search ?? "",
        }));

        const applyFilters = () => {
          const terms = search.value
            .trim()
            .toLowerCase()
            .split(/\s+/)
            .filter(Boolean);

          let visibleCount = 0;

          for (const card of cards) {
            const visible = terms.every((term) =>
              card.search.includes(term),
            );

            card.element.hidden = !visible;

            if (visible) visibleCount += 1;
          }

          const hasFilters = terms.length > 0;
          const noun = cards.length === 1 ? "sector" : "sectors";

          count.textContent = hasFilters
            ? `${visibleCount} of ${cards.length} ${noun}`
            : `${cards.length} ${noun}`;

          empty.hidden = visibleCount !== 0;
        };

        form.addEventListener("submit", (event) => {
          event.preventDefault();
          applyFilters();
        });

        form.addEventListener("input", applyFilters);
        form.addEventListener("change", applyFilters);

        form.addEventListener("reset", () => {
          requestAnimationFrame(applyFilters);
        });

        form.dataset.initialised = "true";
        form.hidden = false;

        applyFilters();
      });
  }

  initialiseSectorFilters();

  document.addEventListener("astro:page-load", initialiseSectorFilters);
</script>

<style>
  .sector-index {
    --sector-border: color-mix(in srgb, currentColor 18%, transparent);
    --sector-surface: color-mix(in srgb, currentColor 4%, transparent);
    --sector-muted: color-mix(in srgb, currentColor 75%, transparent);
    --sector-accent: var(--accent, #00c2a8);
  }

  .hp-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    width: fit-content;
    min-height: 2.75rem;
    color: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.4;
    text-decoration: underline;
    text-decoration-color: var(--sector-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere;
  }

  .hp-link:hover,
  .hp-link:focus-visible {
    color: var(--sector-accent);
  }

  .page-head {
    margin-bottom: clamp(1.5rem, 4vw, 3rem);
  }

  .lede {
    max-width: 72ch;
  }

  .lede p + p {
    margin-top: 1rem;
  }

  .sector-overview {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 1.5rem 0 0;
    color: var(--sector-muted);
    font-size: 0.875rem;
  }

  .sector-filters {
    display: grid;
    grid-template-columns: minmax(14rem, 2fr) auto;
    gap: 1rem;
    align-items: end;
    margin-bottom: 1rem;
  }

  .sector-filters[hidden],
  .sector-card[hidden],
  .sector-empty[hidden] {
    display: none;
  }

  .filter-field {
    display: grid;
    gap: 0.4rem;
    min-width: 0;
  }

  .filter-field label {
    font-size: 0.875rem;
    font-weight: 600;
  }

  .filter-field input,
  .filter-reset {
    box-sizing: border-box;
    min-height: 2.75rem;
    border: 1px solid var(--sector-border);
    border-radius: 0.5rem;
    padding: 0.65rem 0.8rem;
    color: inherit;
    background: var(--sector-surface);
    font: inherit;
  }

  .filter-field input {
    width: 100%;
    min-width: 0;
  }

  .filter-field input::placeholder {
    color: var(--sector-muted);
    opacity: 1;
  }

  .filter-reset {
    cursor: pointer;
    white-space: nowrap;
  }

  .filter-reset:hover {
    background: color-mix(in srgb, currentColor 8%, transparent);
  }

  .sector-index :is(a, input, button):focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  .results-count {
    margin: 0 0 1.25rem;
    color: var(--sector-muted);
    font-size: 0.9rem;
  }

  .sector-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
    align-items: stretch;
  }

  .sector-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--sector-border);
    border-top: 4px solid var(--sector-accent);
    border-radius: 0.85rem;
    background: var(--sector-surface);
    transition:
      border-color 0.15s,
      transform 0.15s;
  }

  .sector-card:hover {
    border-color: color-mix(in srgb, var(--sector-accent) 55%, var(--sector-border));
    transform: translateY(-2px);
  }

  .sector-card-image {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid var(--sector-border);
  }

  .sector-card-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sector-card-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
    padding: clamp(1.1rem, 2vw, 1.5rem);
  }

  .sector-card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.75rem;
  }

  .sector-category {
    display: inline-flex;
    align-items: center;
    border: 1px solid color-mix(in srgb, var(--sector-accent) 60%, transparent);
    border-radius: 999px;
    padding: 0.2rem 0.6rem;
    background: color-mix(in srgb, var(--sector-accent) 14%, transparent);
    font-weight: 600;
    line-height: 1.5;
  }

  .sector-card h2 {
    margin: 0;
    font-size: clamp(1.25rem, 2vw, 1.55rem);
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .sector-card h2 a {
    color: inherit;
    text-decoration: none;
  }

  .sector-card h2 a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .sector-summary {
    margin: 0;
    color: var(--sector-muted);
    line-height: 1.65;
  }

  .focus-label {
    margin: 0 0 0.5rem;
    color: var(--sector-muted);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .focus-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .focus-tag {
    display: inline-block;
    border: 1px solid var(--sector-border);
    border-radius: 0.25rem;
    padding: 0.15rem 0.45rem;
    font-size: 0.75rem;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  .sector-card-footer {
    margin-top: auto;
    padding-top: 0.75rem;
  }

  .sector-empty {
    padding: 2rem 0;
  }

  .sector-empty h2 {
    margin: 0 0 0.75rem;
  }

  .sector-empty p {
    margin: 0;
    color: var(--sector-muted);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 1000px) {
    .sector-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .sector-grid,
    .sector-filters {
      grid-template-columns: 1fr;
    }

    .filter-reset {
      justify-self: stretch;
    }
  }
</style>