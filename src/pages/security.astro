---
import LegalNoticeLayout from "../layouts/LegalNotice.astro";
import { siteLegal } from "../data/legal";
import { defineSections } from "../lib/notice";
import ContactBlock from "../components/legal/ContactBlock.astro";
import DataTable from "../components/legal/DataTable.astro";
import DefinitionItem from "../components/legal/DefinitionItem.astro";
import DefinitionList from "../components/legal/DefinitionList.astro";
import ItemList from "../components/legal/ItemList.astro";
import LegalSection from "../components/legal/LegalSection.astro";
import Mailto from "../components/legal/Mailto.astro";

const lastUpdated = "2026-10-13";

// Replace before publishing.
const securityEmail = "security@rjmlaird.co.uk";
const pgpKeyUrl = ""; // Optional: "https://rjmlaird.co.uk/.well-known/security-pgp-key.txt";
const acknowledgementTarget = "5 working days";
const triageTarget = "10 working days";

const s = defineSections({
  overview: "Overview",
  reporting: "Report a vulnerability",
  "what-to-include": "What to include",
  response: "What happens next",
  scope: "Scope",
  "safe-harbour": "Good-faith research",
  "testing-rules": "Testing rules",
  "out-of-scope": "Out of scope",
  "data-handling": "Handling discovered data",
  disclosure: "Coordinated disclosure",
  "security-practices": "Security practices",
  "incident-contact": "General security concerns",
  changes: "Changes to this notice",
  contact: "Contact",
});

const inScope = [
  {
    asset: "Main website",
    address: "https://rjmlaird.co.uk",
    notes:
      "Public pages, forms, static assets, first-party scripts and configuration directly controlled for this website.",
  },
  {
    asset: "Booking portal",
    address: "https://booking.rjmlaird.co.uk",
    notes:
      "Public portal pages and first-party functionality. Third-party booking, payment and calendar platforms remain subject to their own disclosure processes.",
  },
  {
    asset: "Security contact and policy",
    address: "https://rjmlaird.co.uk/.well-known/security.txt",
    notes:
      "The security.txt file, disclosure route and policy pages.",
  },
];

const outOfScope = [
  "Any domain, subdomain, service, account, application, repository or infrastructure not explicitly listed as in scope.",
  "Third-party products and services, including hosting, content-delivery networks, payment processors, booking systems, calendar providers, social-media platforms, newsletter tools, analytics providers and embedded services. Report issues to the relevant provider unless the issue is caused by this website’s configuration or integration.",
  "Impact Orbit Collective systems, brands, domains or infrastructure, unless they are separately listed in that organisation’s own vulnerability-disclosure policy.",
  "Denial-of-service, distributed denial-of-service, stress testing, load testing or any activity likely to affect availability.",
  "Social engineering, phishing, pretexting, impersonation, physical-security testing or contacting staff, clients, suppliers or partners to obtain information or access.",
  "Credential stuffing, password spraying, brute force, guessing passwords, account enumeration or attempting to bypass authentication.",
  "Spam, unsolicited messages, abuse of contact forms, bulk submissions or automated requests that are not necessary to demonstrate a specific vulnerability.",
  "Issues that require access to another person’s account, private information, payment information or confidential materials to demonstrate impact.",
  "Missing or non-ideal security headers, TLS configuration preferences, clickjacking concerns, version disclosure or similar low-impact observations without a demonstrated, realistic security consequence.",
  "Reports based solely on automated scanner output without a clear explanation, reproducible evidence and an assessment of real impact.",
  "Vulnerabilities in unsupported browsers, unmodified third-party software or publicly known issues where no reasonable remediation is available to the site operator.",
];

const reportFields = [
  "The affected website, URL, endpoint, page, feature or asset.",
  "A concise description of the issue and the suspected vulnerability type, for example cross-site scripting, access control, injection, information disclosure or configuration issue.",
  "Clear, reproducible steps to demonstrate the issue using a benign, non-destructive proof of concept.",
  "The potential impact, including what an attacker could realistically access, change, disrupt or impersonate.",
  "Any relevant request, response, screenshot, log, video or code sample. Remove or redact unnecessary personal, confidential and security-sensitive information.",
  "Whether you believe the issue is already being actively exploited, and why.",
  "Your preferred contact details, if you would like updates. Anonymous reports are accepted, but a contact route helps with clarification and follow-up.",
];

const securityPractices = [
  "Using reputable infrastructure and service providers appropriate to the website’s needs.",
  "Applying security updates and dependency updates within a risk-based maintenance process.",
  "Using encrypted connections through HTTPS where supported.",
  "Restricting access to systems and accounts to people who need it.",
  "Using strong authentication and multi-factor authentication where available.",
  "Reviewing access, integrations, forms, third-party tools and configuration as the site changes.",
  "Keeping backups, recovery arrangements and operational records appropriate to the service.",
  "Reviewing reports of suspected vulnerabilities and security incidents.",
];
const scopeColumns = [
  { key: "asset", label: "Asset", width: "20%" },
  { key: "address", label: "Address", width: "29%" },
  { key: "notes", label: "Scope notes", width: "51%" },
];

const scopeRows = inScope.map((item) => ({
  asset: item.asset,
  address: { href: item.address },
  notes: item.notes,
}));
---

<LegalNoticeLayout
  title="Security notice"
  description="Security information and vulnerability-disclosure guidance for rjmlaird.co.uk."
  eyebrow="Security"
  lead="This notice explains how to report a potential security vulnerability affecting this website or the booking portal, and how good-faith reports will be handled."
  lastUpdated={lastUpdated}
  sections={s.list}
  related={["privacy", "terms", "accessibility", "securityTxt"]}
>
  <Fragment slot="summary">
    <p>
      If you believe you have found a security vulnerability, report it
      privately to <Mailto email={securityEmail} />. Please do not
      publicly disclose the issue, access other people’s data or disrupt the
      service while it is being investigated.
    </p>
  </Fragment>

  <LegalSection section={s.by.overview}>

    <p>
      Security matters. This page sets out a coordinated vulnerability
      disclosure process for the public websites and first-party functionality
      identified in the <a href={s.by.scope.href}>scope</a> section.
    </p>

    <p>
      I welcome good-faith reports that help identify and reduce security risks.
      If you believe you have found a vulnerability, please report it privately
      and allow a reasonable opportunity for it to be investigated and
      addressed before sharing details more widely.
    </p>

    <p>
      This policy is intended to support responsible reporting. It is not a
      request to test systems beyond the boundaries described below, and it does
      not authorise access to systems, accounts, data or services that you do
      not own or have permission to use.
    </p>
  </LegalSection>

  <LegalSection section={s.by.reporting}>

    <p>
      Send vulnerability reports to:
    </p>

    <ContactBlock variant="callout" label="Security contact" email={securityEmail} />

    {
      pgpKeyUrl && (
        <p>
          For encrypted communication, use the published
          <a href={pgpKeyUrl}>PGP public key</a>.
        </p>
      )
    }

    {
      !pgpKeyUrl && (
        <p>
          TODO: If you support encrypted reporting, publish a PGP key or secure
          reporting form and add the link here. Do not ask researchers to send
          highly sensitive material through an ordinary contact form.
        </p>
      )
    }

    <p>
      The preferred route is private email. If you cannot use email, you may use
      the general contact route at <Mailto email={siteLegal.contactEmail} />
      and clearly mark the subject line: <strong>Security report</strong>.
    </p>

    <p>
      Do not include passwords, payment-card details, full personal records,
      secrets, access tokens, private keys or other unnecessary sensitive
      information in an email. If sensitive evidence is essential, ask first for
      a secure method of transfer.
    </p>
  </LegalSection>

  <LegalSection section={s.by["what-to-include"]}>

    <p>
      A clear report helps make investigation faster and safer. Please include
      as much of the following as you can:
    </p>

    <ItemList items={reportFields} />

    <p>
      A short, benign proof of concept is usually more useful than an automated
      scan report alone. Keep testing to the minimum necessary to demonstrate
      the issue.
    </p>
  </LegalSection>

  <LegalSection section={s.by.response}>

    <p>
      Vulnerability reports are assessed in good faith and treated as
      confidential while they are being investigated.
    </p>

    <ItemList ordered variant="steps">
      <li>
        <strong>Acknowledgement:</strong> I aim to acknowledge a report within
        {` ${acknowledgementTarget}`}.
      </li>

      <li>
        <strong>Initial triage:</strong> I aim to assess the report, request
        clarification if needed and determine the likely impact within
        {` ${triageTarget}`}.
      </li>

      <li>
        <strong>Remediation:</strong> Where an issue is confirmed, I will
        prioritise it according to severity, exploitability, exposure, available
        mitigation and the dependencies involved.
      </li>

      <li>
        <strong>Updates:</strong> Where you provide contact details, I will aim
        to keep you informed of material progress, subject to security,
        confidentiality, legal and operational considerations.
      </li>

      <li>
        <strong>Closure:</strong> Once the issue has been addressed, I will aim
        to let you know. I may ask you to confirm that a fix resolves the issue
        where that is appropriate and safe.
      </li>
    </ItemList>

    <p>
      These are targets, not guarantees. Some issues may take longer to resolve,
      especially where a third-party provider, hosting platform, dependency,
      vendor patch, wider investigation or coordinated response is involved.
    </p>
  </LegalSection>

  <LegalSection section={s.by.scope}>

    <p>
      This policy applies only to the following public assets, to the extent
      that they are directly controlled:
    </p>

    <DataTable caption="In-scope assets" columns={scopeColumns} rows={scopeRows} minWidth="52rem" />

    <p>
      If you are unsure whether an asset is in scope, contact <Mailto email={securityEmail} /> before testing.
    </p>
  </LegalSection>

  <LegalSection section={s.by["safe-harbour"]}>

    <p>
      If you act in good faith, follow this policy, minimise harm, respect
      privacy and promptly report a vulnerability through the stated channel, I
      will not intentionally pursue legal action against you solely for
      responsible research within the stated scope.
    </p>

    <p>
      Good-faith research means acting to improve security, not to gain access,
      obtain data, disrupt services, seek payment, embarrass another party or
      take advantage of a vulnerability.
    </p>

    <p>
      This statement does not authorise activity that is unlawful, harmful,
      reckless, disruptive, outside scope, directed at third parties or in
      breach of another organisation’s terms or policies. It also does not limit
      any rights or obligations that cannot lawfully be limited.
    </p>

    <p>
      If you are unsure whether a proposed test is permitted, stop and ask for
      written clarification before proceeding.
    </p>
  </LegalSection>

  <LegalSection section={s.by["testing-rules"]}>

    <p>
      To keep research safe, proportionate and lawful, you must:
    </p>

    <ul>
      <li>Test only assets explicitly listed as in scope</li>
      <li>Use the least intrusive method needed to demonstrate a vulnerability</li>
      <li>Use a benign, non-destructive proof of concept</li>
      <li>Stop testing if you encounter personal, confidential or sensitive information</li>
      <li>Stop testing if you gain access to an account or data that is not your own</li>
      <li>Stop testing if there is any risk of disruption, data loss or degradation of service</li>
      <li>Respect rate limits and avoid automated activity that could affect availability</li>
      <li>Protect any information you encounter and do not share it with anyone else</li>
      <li>Report the issue promptly using the security contact route</li>
      <li>Allow reasonable time for investigation and remediation before public disclosure</li>
    </ul>

    <p>
      NCSC guidance recommends clear boundaries, benign proof-of-concept steps
      and a direct reporting route for vulnerability reports.
    </p>
  </LegalSection>

  <LegalSection section={s.by["out-of-scope"]}>

    <p>
      The following are out of scope and must not be tested against these
      websites:
    </p>

    <ItemList items={outOfScope} />

    <p>
      This list is not exhaustive. Activity that creates risk, affects other
      users, accesses data without permission or interferes with a third party
      is outside the scope of this policy.
    </p>
  </LegalSection>

  <LegalSection section={s.by["data-handling"]}>

    <p>
      If you encounter personal data, confidential material, credentials,
      session tokens, private documents, payment information or other sensitive
      information while researching a potential issue, you must stop testing
      immediately.
    </p>

    <p>
      Do not download, copy, retain, modify, publish, share or use the
      information. Report only the minimum details needed to explain that the
      exposure occurred, and ask for a secure reporting method if evidence is
      necessary.
    </p>

    <p>
      Any data incident will be assessed in line with applicable legal,
      contractual and security obligations. This may require notification to
      service providers, affected individuals, regulators or relevant
      authorities where appropriate.
    </p>
  </LegalSection>

  <LegalSection section={s.by.disclosure}>

    <p>
      Please do not publicly disclose a suspected vulnerability, share details
      on social media, publish a proof of concept or contact third parties about
      it while it is being investigated.
    </p>

    <p>
      Once a vulnerability has been resolved, you may request to discuss public
      disclosure. Any disclosure timing should be coordinated to reduce risk to
      users and services, particularly where patches, configuration changes,
      vendor action or user mitigation are still needed.
    </p>

    <p>
      Credit for a responsible report may be offered where appropriate and where
      you consent, but public acknowledgement is not guaranteed.
    </p>
  </LegalSection>

  <LegalSection section={s.by["security-practices"]}>

    <p>
      Reasonable, proportionate measures are used to help protect the website,
      its supporting systems and information processed through it. These may
      include:
    </p>

    <ItemList items={securityPractices} />

    <p>
      Security is an ongoing process. No website, service or technical control
      can guarantee complete security, and users should take their own sensible
      precautions when using online services.
    </p>

    <p>
      This section describes general practices only. It does not disclose
      detailed security architecture, configuration, monitoring, incident
      response, supplier arrangements or defensive controls.
    </p>
  </LegalSection>

  <LegalSection section={s.by["incident-contact"]}>

    <p>
      Use the vulnerability-reporting route only for a suspected technical
      security issue. It is not a general customer-support, privacy, abuse,
      account-recovery or emergency service.
    </p>

    <DefinitionList>
      <DefinitionItem term="Security vulnerability">
          Email <Mailto email={securityEmail} />
        </DefinitionItem>

      <DefinitionItem term="Privacy concern">
          Email
          {" "}
          <Mailto email={siteLegal.privacyEmail} />
        </DefinitionItem>

      <DefinitionItem term="General enquiry">
          Email
          {" "}
          <Mailto email={siteLegal.contactEmail} />
        </DefinitionItem>

      <DefinitionItem term="Immediate danger">
          Contact the relevant emergency services or competent authority. Do not
          rely on this website’s security email for an emergency response.
        </DefinitionItem>
    </DefinitionList>
  </LegalSection>

  <LegalSection section={s.by.changes}>

    <p>
      This notice may be updated as the website, booking portal, infrastructure,
      suppliers, security arrangements or reporting process changes.
    </p>

    <p>
      The latest version will be published on this page with the date it was
      last updated. The associated security.txt file should also be updated when
      contact details or policy links change.
    </p>
  </LegalSection>

  <LegalSection section={s.by.contact}>

    <p>
      To report a suspected security vulnerability, email:
    </p>

    <ContactBlock label="" email={securityEmail} />

    <p>
      For non-security matters, use <Mailto email={siteLegal.contactEmail} />.
    </p>
  </LegalSection>

  <Fragment slot="draft-note">
    <p>
      <strong>Before publishing:</strong> create, monitor and test the <code>{securityEmail}</code> inbox; set response targets you can actually
      meet; confirm the assets you control; publish a valid <code>/.well-known/security.txt</code> file; and ensure your hosting,
      booking, payment and infrastructure suppliers each have their own
      vulnerability-reporting routes. The NCSC recommends a clear, secure
      reporting channel, defined researcher boundaries and an explanation of how
      reports will be handled.
    </p>
  </Fragment>
</LegalNoticeLayout>

