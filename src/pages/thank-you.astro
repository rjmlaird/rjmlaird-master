---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Thank you"
  description="Your enquiry has been sent."
>
  <div class="nested-main thanks">
    <section>
      <div class="wrap">
        <p class="eyebrow">Enquiry sent</p>

        <h1>Thank you for getting in touch.</h1>

        <p>
          Your message has been received. I aim to reply within three working
          days. If your enquiry is time-sensitive, please include that context
          in any follow-up.
        </p>

        <a class="button" href="/">
          Return to the homepage
        </a>
      </div>
    </section>
  </div>
</Layout>

<style>
  .thanks {
    min-height: 70vh;
    display: grid;
    place-items: center;
    padding-block: 5rem;
  }

  .thanks section {
    width: 100%;
  }

  .thanks .wrap {
    max-width: 48rem;
  }

  .eyebrow {
    margin: 0;
    color: var(--teal);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0.75rem 0 0;
    color: var(--w);
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 7vw, 6rem);
    font-weight: 400;
    letter-spacing: -0.06em;
    line-height: 0.9;
  }

  p:not(.eyebrow) {
    max-width: 38rem;
    margin: 1.5rem 0 0;
    color: var(--mb);
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .button {
    display: inline-flex;
    min-height: 2.9rem;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.1rem;
    margin-top: 2rem;
    border: 1px solid var(--teal);
    color: var(--on-accent);
    background: var(--teal);
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
  }
</style>
