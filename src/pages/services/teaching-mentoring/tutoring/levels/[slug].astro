---
import PageLayout from '../../../../tutoring/layouts/PageLayout.astro';
import BookingCTA from '../../../../tutoring/components/BookingCTA.astro';
import { levels } from '../../../../tutoring/data/levels';
import { liveSubjects } from '../../../../tutoring/data/subjects';

export function getStaticPaths() {
  return levels.map((level) => ({ params: { slug: level.slug }, props: { level } }));
}
const { level } = Astro.props;
const subjects = liveSubjects.filter((s) => s.levels.includes(level.slug));
---
<PageLayout title={`${level.name} tuition`} lede={level.summary}>
  <h2>What we focus on</h2>
  <ul>{level.focus.map((f) => <li>{f}</li>)}</ul>
  <h2>Subjects at {level.name}</h2>
  <ul>{subjects.map((s) => <li><a href={`/tutoring/subjects/${s.slug}/`}>{s.name}</a></li>)}</ul>
  <BookingCTA />
</PageLayout>
