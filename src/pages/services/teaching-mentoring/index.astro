---
import Layout from "../../../layouts/Layout.astro";
import FaqSection from "../../../components/faqs/FaqSection.astro";
---

<Layout
  title="Teaching & mentoring"
  description="Physics and astronomy tuition, guest teaching, workshops and career mentoring for students, professionals and teams."
>
  <main class="service-page">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/services/">Services</a></li>
          <li aria-current="page">Teaching &amp; mentoring</li>
        </ol>
      </nav>

      <header class="service-hero">
        <div class="service-hero__meta">
          <p class="sl">Services</p>
          <p class="service-hero__number" aria-hidden="true">03</p>
        </div>

        <div class="service-hero__content">
          <h1>Teaching &amp;<br /><em>mentoring.</em></h1>

          <p class="lead">
            Practical support for people learning science, communicating complex
            ideas or working out what comes next in their career.
          </p>

          <a class="text-link" href="#enquire">
            Enquire about teaching or mentoring
            <span aria-hidden="true">↓</span>
          </a>
        </div>
      </header>

      <section class="section section--split" aria-labelledby="fit-heading">
        <div class="section__label">
          <p class="eyebrow">The fit</p>
          <h2 id="fit-heading">Learning that meets people where they are.</h2>
        </div>

        <div class="section__content">
          <p class="prose prose--large">
            I work with students, adult learners, educators and professionals.
            The format depends on what you need: deeper subject knowledge,
            clearer communication skills or structured space to think through a
            professional decision.
          </p>

          <ul class="audience-list">
            <li>School, college and university students</li>
            <li>Adult learners returning to science or technical subjects</li>
            <li>Early- and mid-career professionals exploring their next step</li>
            <li>Schools, universities, charities and learning networks</li>
            <li>Research, science and mission-led teams building communication capability</li>
          </ul>
        </div>
      </section>

      <section class="section" aria-labelledby="offers-heading">
        <div class="section__intro">
          <div>
            <p class="eyebrow">What this can include</p>
            <h2 id="offers-heading">Four ways to learn, develop and contribute.</h2>
          </div>

          <p class="prose">
            Each format has a distinct purpose. Start with the outcome you need,
            rather than trying to choose a label before we have talked.
          </p>
        </div>

        <div class="offer-grid offer-grid--four">
          <article class="offer">
            <p class="offer__number" aria-hidden="true">01</p>
            <h3>Physics &amp; astronomy tuition</h3>
            <p>
              One-to-one academic support for physics, astronomy and related
              science subjects, tailored to your course, exam board, goals and
              current level of confidence.
            </p>
            <p class="offer__meta">
              For school, college and university students, and adult learners.
            </p>
          </article>

          <article class="offer">
            <p class="offer__number" aria-hidden="true">02</p>
            <h3>Guest teaching &amp; talks</h3>
            <p>
              A focused session on space science, sustainability, Earth
              observation or the challenge of communicating research and
              technical subjects.
            </p>
            <p class="offer__meta">
              For schools, universities, societies, community groups and events.
            </p>
          </article>

          <article class="offer">
            <p class="offer__number" aria-hidden="true">03</p>
            <h3>Workshops</h3>
            <p>
              Practical group sessions on explaining complex ideas: finding the
              structure, using plain language and retaining the accuracy that
              gives technical communication its value.
            </p>
            <p class="offer__meta">
              For research groups, charities, networks and student societies.
            </p>
          </article>

          <article class="offer">
            <p class="offer__number" aria-hidden="true">04</p>
            <h3>Career mentoring</h3>
            <p>
              Structured one-to-one conversations about career direction,
              moving between science and communications, and building a path in
              mission-led sectors.
            </p>
            <p class="offer__meta">
              For early- and mid-career professionals and scientists exploring new directions.
            </p>
          </article>
        </div>
      </section>

      <section class="expertise-panel" aria-labelledby="subjects-heading">
        <div class="expertise-panel__mark" aria-hidden="true">✦</div>

        <div>
          <p class="eyebrow">Subject areas</p>
          <h2 id="subjects-heading">Science knowledge, communication practice.</h2>
        </div>

        <div class="expertise-panel__copy">
          <p>
            Sessions can draw on physics and astronomy, space science,
            sustainability, Earth observation, research communication, digital
            communication and content strategy.
          </p>

          <p>
            The shared focus is making difficult material easier to work with:
            understanding it, explaining it accurately and using it with more
            confidence.
          </p>
        </div>
      </section>

      <section class="section section--split" aria-labelledby="details-heading">
        <div class="section__label">
          <p class="eyebrow">Practical details</p>
          <h2 id="details-heading">A clear arrangement before we begin.</h2>
        </div>

        <div class="section__content">
          <dl class="details-list">
            <div>
              <dt>Where</dt>
              <dd>
                Online across the UK and Europe. In person in Leicester and the
                East Midlands, with other locations by arrangement.
              </dd>
            </div>

            <div>
              <dt>Level &amp; audience</dt>
              <dd>
                Tell me the course, exam board, learner age or audience when you
                enquire. I will confirm whether I am the right person and
                recommend an appropriate format.
              </dd>
            </div>

            <div>
              <dt>Under-18s</dt>
              <dd>
                Tuition is arranged through a parent, guardian or school.
                Safeguarding, communication and session arrangements are agreed
                before any teaching begins.
              </dd>
            </div>

            <div>
              <dt>Fees &amp; availability</dt>
              <dd>
                Fees and availability are confirmed after a short conversation
                about the format, preparation required, location and timescale.
              </dd>
            </div>
          </dl>
        </div>
      </section>

      <section class="section section--split" aria-labelledby="team-training-heading">
        <div class="section__label">
          <p class="eyebrow">For organisations</p>
          <h2 id="team-training-heading">Training that stays useful after the session.</h2>
        </div>

        <div class="section__content">
          <div class="engagement engagement--full">
            <p class="engagement__type">Team capability building</p>

            <h3>Tailored organisational training</h3>

            <p>
              For teams that need to develop their own communication and content
              capability, training can be tailored around a live challenge,
              priority audience or existing material.
            </p>

            <p>
              Larger programmes and organisation-level delivery are provided
              through Impact Orbit Collective, the practice I founded and direct.
            </p>

            <a
              href="https://impactorbit.co/"
              target="_blank"
              rel="noopener noreferrer"
            >
              Visit Impact Orbit Co.
              <span aria-hidden="true">↗</span>
              <span class="sr-only"> (opens in a new tab)</span>
            </a>
          </div>
        </div>
      </section>

      <FaqSection page="services/teaching-mentoring" limit={6} />


      <section class="service-cta" id="enquire" aria-labelledby="enquire-heading">
        <p class="eyebrow">Next step</p>
        <h2 id="enquire-heading">Begin with what you need.</h2>

        <p>
          Tell me who the learning is for, the subject or challenge, your
          preferred format, location and any relevant dates. I will reply with
          questions, a suggested approach or a referral if another route is a
          better fit.
        </p>

        <div class="cta-row">
          <a class="bp" href="/contact/#teaching-mentoring">
            Enquire about teaching or mentoring
          </a>

          <a class="bo" href="/work/case-studies/">
            View selected work
          </a>
        </div>
      </section>
    </div>
  </main>
</Layout>

<style>
  .service-page {
    padding-block: clamp(1.5rem, 4vw, 3.5rem) clamp(3.5rem, 8vw, 7rem);
  }

  .crumbs {
    margin-bottom: clamp(2rem, 6vw, 5rem);
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .crumbs li,
  .crumbs a {
    color: var(--m);
    font-size: 0.8rem;
  }

  .crumbs a {
    text-underline-offset: 0.2em;
  }

  .crumbs li + li::before {
    margin-right: 0.45rem;
    color: var(--mb);
    content: "/";
  }

  .service-hero {
    display: grid;
    grid-template-columns: minmax(5rem, 0.6fr) minmax(0, 2fr);
    gap: clamp(1.5rem, 5vw, 6rem);
    min-height: min(34rem, 70vh);
    padding-bottom: clamp(3rem, 8vw, 7rem);
    border-bottom: 1px solid var(--bd);
  }

  .service-hero__meta {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
  }

  .service-hero__meta .sl,
  .eyebrow {
    margin: 0;
    color: var(--teal);
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .service-hero__number,
  .offer__number {
    margin: 0;
    color: var(--bd);
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 6.5rem);
    font-weight: 400;
    letter-spacing: -0.08em;
    line-height: 0.8;
  }

  .service-hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: end;
    max-width: 55rem;
  }

  .service-hero h1 {
    max-width: 13ch;
    margin: 0;
    color: var(--w);
    font-family: var(--font-display);
    font-size: clamp(3.4rem, 8vw, 7.75rem);
    font-weight: 400;
    letter-spacing: -0.065em;
    line-height: 0.88;
  }

  .service-hero h1 em {
    color: var(--sky, var(--teal));
    font-style: normal;
  }

  .lead {
    max-width: 42rem;
    margin: clamp(1.75rem, 4vw, 3rem) 0 0;
    color: var(--mb);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.65;
  }

  .text-link,
  .engagement a {
    display: inline-flex;
    gap: 0.65rem;
    align-items: center;
    min-height: 44px;
    margin-top: 1.5rem;
    color: var(--w);
    font-weight: 700;
    text-decoration: none;
    text-underline-offset: 0.25em;
  }

  .text-link:hover,
  .text-link:focus-visible,
  .engagement a:hover,
  .engagement a:focus-visible {
    color: var(--sky, var(--teal));
    text-decoration: underline;
  }

  .section {
    padding-block: clamp(3.5rem, 8vw, 7rem);
    border-bottom: 1px solid var(--bd);
  }

  .section--split {
    display: grid;
    grid-template-columns: minmax(14rem, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 8vw, 8rem);
  }

  .section__label h2,
  .section__intro h2,
  .expertise-panel h2,
  .service-cta h2 {
    max-width: 18ch;
    margin: 0.7rem 0 0;
    color: var(--w);
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.6rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 0.98;
  }

  .section__content {
    min-width: 0;
  }

  .section__intro {
    display: grid;
    grid-template-columns: minmax(14rem, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 8vw, 8rem);
    align-items: end;
    margin-bottom: clamp(2rem, 5vw, 4rem);
  }

  .prose,
  .expertise-panel__copy p,
  .service-cta > p {
    max-width: 48rem;
    margin: 0;
    color: var(--mb);
    font-size: 1rem;
    line-height: 1.75;
  }

  .prose--large {
    max-width: 46rem;
    color: var(--w);
    font-size: clamp(1.1rem, 1.8vw, 1.3rem);
  }

  .audience-list {
    display: grid;
    gap: 0;
    margin: 2rem 0 0;
    padding: 0;
    border-top: 1px solid var(--bd);
    list-style: none;
  }

  .audience-list li {
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--bd);
    color: var(--mb);
    font-size: 0.95rem;
    line-height: 1.45;
  }

  .audience-list li::before {
    margin-right: 0.7rem;
    color: var(--sky, var(--teal));
    content: "↗";
  }

  .offer-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--bd);
    border-left: 1px solid var(--bd);
  }

  .offer-grid--four {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .offer {
    display: flex;
    flex-direction: column;
    min-height: 23rem;
    padding: clamp(1.25rem, 3vw, 2.25rem);
    border-right: 1px solid var(--bd);
    border-bottom: 1px solid var(--bd);
    background: transparent;
  }

  .offer__number {
    color: var(--sky, var(--teal));
    font-size: 2rem;
    letter-spacing: -0.05em;
  }

  .offer h3 {
    margin: clamp(2rem, 6vw, 5rem) 0 0.85rem;
    color: var(--w);
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.4vw, 1.8rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .offer p:not(.offer__number) {
    margin: 0;
    color: var(--mb);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .offer__meta {
    margin-top: auto !important;
    padding-top: 1.25rem;
    color: var(--m) !important;
    font-size: 0.78rem !important;
    line-height: 1.55 !important;
  }

  .expertise-panel {
    display: grid;
    grid-template-columns: auto minmax(12rem, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: start;
    padding: clamp(2rem, 5vw, 4rem);
    margin-block: clamp(3.5rem, 8vw, 7rem);
    border: 1px solid color-mix(in srgb, var(--sky, var(--teal)) 45%, var(--bd));
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--sky, var(--teal)) 10%, transparent), transparent 58%),
      var(--lift);
  }

  .expertise-panel__mark {
    color: var(--sky, var(--teal));
    font-size: 2rem;
    line-height: 1;
  }

  .expertise-panel__copy {
    display: grid;
    gap: 1rem;
  }

  .details-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--bd);
  }

  .details-list > div {
    display: grid;
    grid-template-columns: minmax(8rem, 0.45fr) minmax(0, 1fr);
    gap: 1.5rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--bd);
  }

  .details-list dt {
    color: var(--w);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .details-list dd {
    margin: 0;
    color: var(--mb);
    font-size: 0.92rem;
    line-height: 1.65;
  }

  .engagement {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-height: 18rem;
    padding: clamp(1.25rem, 3vw, 2.25rem);
    border: 1px solid var(--bd);
    background: var(--lift);
  }

  .engagement--full {
    min-height: 0;
  }

  .engagement__type {
    margin: 0;
    color: var(--sky, var(--teal));
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .engagement h3 {
    margin: 1rem 0 0;
    color: var(--w);
    font-family: var(--font-display);
    font-size: 1.55rem;
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .engagement > p:not(.engagement__type) {
    max-width: 46rem;
    margin: 1rem 0 0;
    color: var(--mb);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .service-cta {
    max-width: 58rem;
    padding-top: clamp(3.5rem, 8vw, 7rem);
  }

  .service-cta h2 {
    max-width: 15ch;
  }

  .service-cta > p {
    margin-top: 1.5rem;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .cta-row a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
  }

  .service-page a:focus-visible {
    outline: 2px solid var(--sky, var(--teal));
    outline-offset: 3px;
  }

  @media (max-width: 1000px) {
    .offer-grid--four {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 800px) {
    .service-hero,
    .section--split,
    .section__intro,
    .expertise-panel {
      grid-template-columns: 1fr;
    }

    .service-hero {
      min-height: auto;
    }

    .service-hero__meta {
      flex-direction: row;
      align-items: center;
    }

    .service-hero__number {
      font-size: 2.5rem;
    }

    .section__intro {
      align-items: start;
    }

    .offer-grid,
    .offer-grid--four {
      grid-template-columns: 1fr;
    }

    .offer {
      min-height: 0;
    }

    .offer h3 {
      margin-top: 2rem;
    }

    .expertise-panel__mark {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .service-hero h1 {
      font-size: clamp(3rem, 15vw, 4.25rem);
    }

    .details-list > div {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }

    .cta-row {
      flex-direction: column;
    }

    .cta-row a {
      width: 100%;
    }
  }
</style>
