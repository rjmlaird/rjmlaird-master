---
import Layout from "../../../layouts/Layout.astro";
import FaqSection from "../../../components/faqs/FaqSection.astro";
---

<Layout
  title="Strategic communication"
  description="Strategic communication for organisations working in science, technology, space, Earth observation, climate and sustainability."
>
  <div class="nested-main service-page">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/services/">Services</a></li>
          <li aria-current="page">Strategic communication</li>
        </ol>
      </nav>

      <header class="service-hero">
        <div class="service-hero__meta">
          <p class="sl">Services</p>
          <p class="service-hero__number" aria-hidden="true">01</p>
        </div>

        <div class="service-hero__content">
          <h1>Strategic<br /><em>communication.</em></h1>

          <p class="lead">
            I help organisations make complex science, technology and
            environmental work clear, credible and useful to the people who
            need to understand it.
          </p>

          <a class="text-link" href="#start">
            Discuss a communication project
            <span aria-hidden="true">↓</span>
          </a>
        </div>
      </header>

      <section class="section section--split" aria-labelledby="for-heading">
        <div class="section__label">
          <p class="eyebrow">The fit</p>
          <h2 id="for-heading">For work that deserves to be understood.</h2>
        </div>

        <div class="section__content">
          <p class="prose prose--large">
            This work is for organisations with substantial ideas, evidence or
            technical capability that need a clearer story, stronger content,
            or a more purposeful way to reach the audiences that matter.
          </p>

          <ul class="audience-list">
            <li>Space and Earth observation organisations</li>
            <li>Climate, sustainability and environmental organisations</li>
            <li>Science, research and technology businesses</li>
            <li>Mission-led, public-interest and policy-facing initiatives</li>
            <li>Teams working with scientific, technical or policy-heavy subjects</li>
          </ul>
        </div>
      </section>

      <section class="section" aria-labelledby="offers-heading">
        <div class="section__intro">
          <p class="eyebrow">What this can include</p>
          <h2 id="offers-heading">From a clearer story to a plan people can use.</h2>
          <p class="prose">
            The appropriate scope depends on the challenge, audience and your
            team’s capacity. Most engagements draw from one or more of these areas.
          </p>
        </div>

        <div class="offer-grid">
          <article class="offer">
            <p class="offer__number" aria-hidden="true">01</p>
            <h3>Positioning &amp; messaging</h3>
            <p>
              Clarifying what you do, who it is for and why it matters through
              audience insight, narrative development, value propositions and
              message architecture.
            </p>
          </article>

          <article class="offer">
            <p class="offer__number" aria-hidden="true">02</p>
            <h3>Content &amp; editorial strategy</h3>
            <p>
              Planning useful content across websites, publications, reports,
              articles, case studies and thought leadership—grounded in
              audience needs and organisational priorities.
            </p>
          </article>

          <article class="offer">
            <p class="offer__number" aria-hidden="true">03</p>
            <h3>Engagement &amp; communication planning</h3>
            <p>
              Creating practical plans for campaigns, stakeholder engagement,
              public engagement, partnerships, launches and events.
            </p>
          </article>
        </div>
      </section>

      <section class="expertise-panel" aria-labelledby="expertise-heading">
        <div class="expertise-panel__mark" aria-hidden="true">✦</div>

        <div>
          <p class="eyebrow">Subject-matter grounding</p>
          <h2 id="expertise-heading">Accurate without being inaccessible.</h2>
        </div>

        <div class="expertise-panel__copy">
          <p>
            My work is grounded in experience across science, space, Earth
            observation, sustainability and technology. I help teams communicate
            research, data and innovation accurately without expecting every
            audience to arrive with specialist knowledge.
          </p>
          <p>
            The aim is not to make complex work sound simpler. It is to preserve
            the substance, make its relevance clear and support better
            understanding and decision-making.
          </p>
        </div>
      </section>

      <section class="section section--split" aria-labelledby="routes-heading">
        <div class="section__label">
          <p class="eyebrow">Ways of working</p>
          <h2 id="routes-heading">The right route for the scope.</h2>
        </div>

        <div class="section__content engagement-grid">
          <article class="engagement">
            <p class="engagement__type">Organisation projects</p>
            <h3>Strategic, multi-part delivery</h3>
            <p>
              Communication strategies, content programmes, campaigns and
              retained support are delivered through Impact Orbit Collective, the
              practice I founded and direct.
            </p>
            <a
              href="https://impactorbit.co/"
              target="_blank"
              rel="noopener noreferrer"
            >
              Visit Impact Orbit Co.
              <span aria-hidden="true">↗</span>
              <span class="sr-only"> (opens in a new tab)</span>
            </a>
          </article>

          <article class="engagement">
            <p class="engagement__type">Focused contributions</p>
            <h3>Defined advice and expertise</h3>
            <p>
              Strategy reviews, workshops, event sessions and editorial input
              can be arranged directly when the scope is well defined.
            </p>
            <a href="/contact/#strategic-communication">
              Start a conversation <span aria-hidden="true">→</span>
            </a>
          </article>
        </div>
      </section>

      <FaqSection page="services/strategic-communication" limit={6} />


      <section class="service-cta" id="start" aria-labelledby="start-heading">
        <p class="eyebrow">Next step</p>
        <h2 id="start-heading">Start with the context.</h2>

        <p>
          Tell me about your organisation, the audience you need to reach, what
          you are trying to achieve and any relevant timescale. I will reply
          with questions, a suggested next step or a referral to the more
          appropriate route.
        </p>

        <div class="cta-row">
          <a class="bp" href="/contact/#strategic-communication">
            Discuss a communication project
          </a>

          <a class="bo" href="/work/case-studies/">
            View selected work
          </a>
        </div>
      </section>
    </div>
  </div>
</Layout>

<style>
  .service-page {
    padding-block: clamp(1.5rem, 4vw, 3.5rem) clamp(3.5rem, 8vw, 7rem);
  }

  .crumbs {
    margin-bottom: clamp(2rem, 6vw, 5rem);
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .crumbs li,
  .crumbs a {
    color: var(--m);
    font-size: 0.8rem;
  }

  .crumbs a {
    text-underline-offset: 0.2em;
  }

  .crumbs li + li::before {
    margin-right: 0.45rem;
    color: var(--mb);
    content: "/";
  }

  .service-hero {
    display: grid;
    grid-template-columns: minmax(5rem, 0.6fr) minmax(0, 2fr);
    gap: clamp(1.5rem, 5vw, 6rem);
    min-height: min(34rem, 70vh);
    padding-bottom: clamp(3rem, 8vw, 7rem);
    border-bottom: 1px solid var(--bd);
  }

  .service-hero__meta {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
  }

  .service-hero__meta .sl,
  .eyebrow {
    margin: 0;
    color: var(--teal);
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .service-hero__number,
  .offer__number {
    margin: 0;
    color: var(--bd);
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 6.5rem);
    font-weight: 400;
    line-height: 0.8;
    letter-spacing: -0.08em;
  }

  .service-hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: end;
    max-width: 55rem;
  }

  .service-hero h1 {
    max-width: 13ch;
    margin: 0;
    color: var(--w);
    font-family: var(--font-display);
    font-size: clamp(3.4rem, 8vw, 7.75rem);
    font-weight: 400;
    letter-spacing: -0.065em;
    line-height: 0.88;
  }

  .service-hero h1 em {
    color: var(--teal);
    font-style: normal;
  }

  .lead {
    max-width: 42rem;
    margin: clamp(1.75rem, 4vw, 3rem) 0 0;
    color: var(--mb);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.65;
  }

  .text-link,
  .engagement a {
    display: inline-flex;
    gap: 0.65rem;
    align-items: center;
    min-height: 44px;
    margin-top: 1.5rem;
    color: var(--w);
    font-weight: 700;
    text-decoration: none;
    text-underline-offset: 0.25em;
  }

  .text-link:hover,
  .text-link:focus-visible,
  .engagement a:hover,
  .engagement a:focus-visible {
    color: var(--teal);
    text-decoration: underline;
  }

  .section {
    padding-block: clamp(3.5rem, 8vw, 7rem);
    border-bottom: 1px solid var(--bd);
  }

  .section--split {
    display: grid;
    grid-template-columns: minmax(14rem, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 8vw, 8rem);
  }

  .section__label h2,
  .section__intro h2,
  .expertise-panel h2,
  .service-cta h2 {
    max-width: 18ch;
    margin: 0.7rem 0 0;
    color: var(--w);
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.6rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 0.98;
  }

  .section__content {
    min-width: 0;
  }

  .section__intro {
    display: grid;
    grid-template-columns: minmax(14rem, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 8vw, 8rem);
    align-items: end;
    margin-bottom: clamp(2rem, 5vw, 4rem);
  }

  .section__intro .prose {
    margin: 0;
  }

  .prose,
  .expertise-panel__copy p,
  .service-cta > p {
    max-width: 48rem;
    margin: 0;
    color: var(--mb);
    font-size: 1rem;
    line-height: 1.75;
  }

  .prose--large {
    max-width: 46rem;
    color: var(--w);
    font-size: clamp(1.1rem, 1.8vw, 1.3rem);
  }

  .audience-list {
    display: grid;
    gap: 0;
    margin: 2rem 0 0;
    padding: 0;
    border-top: 1px solid var(--bd);
    list-style: none;
  }

  .audience-list li {
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--bd);
    color: var(--mb);
    font-size: 0.95rem;
    line-height: 1.45;
  }

  .audience-list li::before {
    margin-right: 0.7rem;
    color: var(--teal);
    content: "↗";
  }

  .offer-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--bd);
    border-left: 1px solid var(--bd);
  }

  .offer {
    min-height: 20rem;
    padding: clamp(1.25rem, 3vw, 2.25rem);
    border-right: 1px solid var(--bd);
    border-bottom: 1px solid var(--bd);
    background: transparent;
  }

  .offer__number {
    color: var(--teal);
    font-size: 2rem;
    letter-spacing: -0.05em;
  }

  .offer h3 {
    margin: clamp(2rem, 6vw, 5rem) 0 0.85rem;
    color: var(--w);
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.4vw, 1.8rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .offer p:not(.offer__number) {
    margin: 0;
    color: var(--mb);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .expertise-panel {
    display: grid;
    grid-template-columns: auto minmax(12rem, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: start;
    padding: clamp(2rem, 5vw, 4rem);
    margin-block: clamp(3.5rem, 8vw, 7rem);
    border: 1px solid color-mix(in srgb, var(--teal) 45%, var(--bd));
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--teal) 10%, transparent), transparent 58%),
      var(--lift);
  }

  .expertise-panel__mark {
    color: var(--teal);
    font-size: 2rem;
    line-height: 1;
  }

  .expertise-panel__copy {
    display: grid;
    gap: 1rem;
  }

  .expertise-panel__copy p + p {
    margin-top: 0;
  }

  .engagement-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .engagement {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-height: 18rem;
    padding: clamp(1.25rem, 3vw, 2.25rem);
    border: 1px solid var(--bd);
    background: var(--lift);
  }

  .engagement__type {
    margin: 0;
    color: var(--teal);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .engagement h3 {
    margin: 1rem 0 0;
    color: var(--w);
    font-family: var(--font-display);
    font-size: 1.55rem;
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .engagement > p:not(.engagement__type) {
    margin: 1rem 0 0;
    color: var(--mb);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .engagement a {
    margin-top: auto;
    padding-top: 1.5rem;
  }

  .service-cta {
    max-width: 58rem;
    padding-top: clamp(3.5rem, 8vw, 7rem);
  }

  .service-cta h2 {
    max-width: 15ch;
  }

  .service-cta > p {
    margin-top: 1.5rem;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .cta-row a {
    min-height: 44px;
  }

  .service-page a:focus-visible {
    outline: 2px solid var(--teal);
    outline-offset: 3px;
  }

  @media (max-width: 800px) {
    .service-hero,
    .section--split,
    .section__intro,
    .expertise-panel {
      grid-template-columns: 1fr;
    }

    .service-hero {
      min-height: auto;
    }

    .service-hero__meta {
      flex-direction: row;
      align-items: center;
    }

    .service-hero__number {
      font-size: 2.5rem;
    }

    .section__intro {
      align-items: start;
    }

    .offer-grid,
    .engagement-grid {
      grid-template-columns: 1fr;
    }

    .offer {
      min-height: 0;
    }

    .offer h3 {
      margin-top: 2rem;
    }

    .expertise-panel__mark {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .service-hero h1 {
      font-size: clamp(3rem, 15vw, 4.25rem);
    }

    .cta-row {
      flex-direction: column;
    }

    .cta-row a {
      justify-content: center;
      width: 100%;
    }
  }
</style>
