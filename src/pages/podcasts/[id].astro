---
import { getCollection, render, type CollectionEntry } from "astro:content";
import PodcastLayout from "../../layouts/PodcastLayout.astro";
import YouTubeEmbed from "../../components/YouTubeEmbed.astro";

export async function getStaticPaths() {
  const entries = await getCollection("podcasts");

  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props as {
  entry: CollectionEntry<"podcasts">;
};

const id = Astro.params.id;
const podcast = entry.data;
const { Content } = await render(entry);

const pageTitle = podcast.title || id || "Podcast";
const pageDescription =
  podcast.description || podcast.excerpt || `Details for ${pageTitle}.`;
const project = entry.data;
const links = project.links || {};
const youtubeUrl = (project as any).youtubeUrl || links.youtube;
const youtubeId = project.youtubeId;
---

<PodcastLayout podcast={entry} title={pageTitle} description={pageDescription}>
  <div class="podcast-body">
          <YouTubeEmbed id={youtubeId} url={youtubeUrl} />
    <Content />
  </div>
</PodcastLayout>

