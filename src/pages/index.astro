---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { isEvidenceReady, cleanText } from "../lib/content-quality.mjs";
import selected from "../data/selected-work.json";
import enquiries from "../data/enquiries.json";

const selectedWork = (
  await Promise.all(
    selected.items.map(async (item) => {
      const entries = await getCollection(
        item.collection as "projects" | "initiatives",
        ({ data }) => data.draft !== true,
      );

      const entry = entries.find(
        (entry) => (entry.data.slug ?? entry.id) === item.slug,
      );

      return entry ? { ...item, entry } : null;
    }),
  )
).filter((item): item is NonNullable<typeof item> => item !== null);

const posts = (
  await getCollection("blog", ({ data }) => !data.draft)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const latestPost = posts[0];

const pathways = [
  {
    tone: "teal",
    action: "I plan",
    title: "Strategic communication",
    story:
      "When the subject is technical, contested or still taking shape, the first task is often to create a shared direction. I help teams decide what they need to say, who needs to hear it and how communication can support meaningful progress.",
    outcomes: [
      "Positioning and messaging",
      "Communication and content strategy",
      "Audience, stakeholder and engagement planning",
    ],
    for: "Space, Earth observation, climate, sustainability, science and technology organisations.",
    href: "/services/#strategic-communication",
    cta: "Explore strategic communication",
  },
  {
    tone: "sky",
    action: "I build",
    title: "Digital strategy and systems",
    story:
      "Useful digital work is not only about a new website. It is about giving people better ways to publish, organise, find, measure and improve the work that already matters.",
    outcomes: [
      "Websites and information architecture",
      "Content operations and publishing systems",
      "Analytics, workflows and practical automation",
    ],
    for: "Teams improving their website, content operations, information architecture, analytics, workflows or automation.",
    href: "/services/#digital-strategy-systems",
    cta: "Explore digital strategy and systems",
  },
  {
    tone: "violet",
    action: "I teach",
    title: "Teaching and mentoring",
    story:
      "Learning works best when it connects knowledge with confidence and practical next steps. I teach scientific subjects, facilitate useful conversations and support people as they develop their own direction.",
    outcomes: [
      "Physics and astronomy tuition",
      "Guest teaching, workshops and training",
      "One-to-one mentoring and career reflection",
    ],
    for: "Students, adult learners, schools, universities, charities, networks and professional teams.",
    href: "/services/#teaching-mentoring",
    cta: "Explore teaching and mentoring",
  },
  {
    tone: "amber",
    action: "I contribute",
    title: "Speaking and collaboration",
    story:
      "Some work needs a contributor rather than a consultant: someone who can bring an informed perspective, connect ideas clearly and help a conversation reach the right people.",
    outcomes: [
      "Talks, panels and podcasts",
      "Editorial commissions and interviews",
      "Research and public-engagement collaboration",
    ],
    for: "Event organisers, journalists, editors, universities, public-engagement teams and research collaborators.",
    href: "/services/#speaking-collaboration",
    cta: "Explore speaking and collaboration",
  },
];

---

<Layout
  title="Ryan Laird — Science, communication and strategy"
  description="Ryan Laird is an astrophysicist, science communicator and strategist working across space, sustainability and technology through strategic communication, digital systems, teaching, mentoring and public engagement."
>
  <div class="hp-root">
    <section class="hp-hero" aria-labelledby="home-title">
      <div class="hp-wrap hp-hero__grid">
        <div class="hp-hero__content">
          <p class="hp-eyebrow">Ryan Laird · CMktr MInstP</p>

          <h1 id="home-title">
            Science, communication and digital strategy for complex ideas.
          </h1>

          <p class="hp-lead">
            I am an astrophysicist, science communicator and strategist working
            across space, sustainability and technology.
          </p>

          <p class="hp-support">
            I help organisations, teams and individuals make complex work
            clearer, more accurate and more useful through communication,
            digital practice, teaching and collaboration.
          </p>

          <p class="hp-location">
            Based in Leicester. Working across the UK, Europe and online.
          </p>

          <div class="hp-actions">
            <a class="hp-btn hp-btn--primary" href="/services/">
              Explore services
            </a>

            <a class="hp-btn hp-btn--secondary" href="/how-i-work/">
              How I work
            </a>
          </div>
        </div>

        <figure class="hp-portrait">
          <img
            src="/img/person/ryan-laird.jpg"
            alt="Portrait of Ryan Laird"
            width="720"
            height="900"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
      </div>
    </section>

    <section class="hp-creds" aria-label="Credentials">
      <div class="hp-wrap">
        <ul>
          <li><strong>MPhys</strong> Astrophysics</li>
          <li><strong>CMktr</strong> Chartered Marketer</li>
          <li><strong>MInstP</strong> Institute of Physics</li>
          <li><strong>MCIPR</strong> Chartered Institute of Public Relations</li>
          <li><strong>Founder and Director</strong> Impact Orbit Co.</li>
        </ul>
      </div>
    </section>

    <section class="hp-block" aria-labelledby="services-title">
      <div class="hp-wrap">
        <div class="hp-heading">
          <div>
            <p class="hp-eyebrow">How I contribute</p>
            <h2 id="services-title">From complex work to useful progress.</h2>
          </div>

          <p>
            My work starts in different places: a difficult message, an
            underused website, a question someone wants to understand or a
            conversation worth bringing into the open. The routes below
            describe what I do when I am asked to help.
          </p>
        </div>

        <div class="hp-stories">
          {
            pathways.map((pathway, index) => (
              <article class="hp-story" data-tone={pathway.tone}>
                <div class="hp-story__number" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </div>

                <div class="hp-story__title">
                  <p class="hp-story__action">{pathway.action}</p>
                  <h3>{pathway.title}</h3>
                </div>

                <div class="hp-story__content">
                  <p class="hp-story__lead">{pathway.story}</p>

                  <ul class="hp-story__outcomes">
                    {pathway.outcomes.map((outcome) => (
                      <li>{outcome}</li>
                    ))}
                  </ul>

                  <p class="hp-story__for">
                    <strong>For:</strong> {pathway.for}
                  </p>

                  <a class="hp-link" href={pathway.href}>
                    {pathway.cta}
                    <span aria-hidden="true">&nbsp;→</span>
                  </a>
                </div>
              </article>
            ))
          }
        </div>

        <p class="hp-actions hp-actions--after">
          <a class="hp-btn hp-btn--secondary" href="/services/">
            View all services
          </a>
        </p>
      </div>
    </section>

    <section
      class="hp-block hp-block--bordered"
      aria-labelledby="selected-work-title"
    >
      <div class="hp-wrap">
        <div class="hp-heading">
          <div>
            <p class="hp-eyebrow">Selected work</p>
            <h2 id="selected-work-title">
              Work across science, space and public interest.
            </h2>
          </div>

          <p>
            A selection of projects spanning communication, Earth observation,
            sustainability, digital work and public engagement.
          </p>
        </div>

        <div class="hp-grid hp-grid--work">
          {
            selectedWork.map(
              ({ entry, sector, year, role, outcome, collection }) => {
                const summary = outcome || cleanText(entry.data.description);
                const shortSummary =
                  summary.length > 170
                    ? `${summary.slice(0, summary.lastIndexOf(" ", 167))}…`
                    : summary;

                const ready = isEvidenceReady(entry.data, entry.body ?? "");
                const slug = entry.data.slug ?? entry.id;
                const metadata = [sector, entry.data.client, year]
                  .filter(Boolean)
                  .join(" · ");

                return (
                  <a
                    class="hp-card hp-card--work"
                    href={`/work/${collection}/${slug}/`}
                  >
                    {metadata && <p class="hp-card__meta">{metadata}</p>}

                    <h3>{entry.data.title}</h3>

                    {shortSummary && <p>{shortSummary}</p>}

                    {role && (
                      <p class="hp-card__note">
                        <strong>My role:</strong> {role}
                      </p>
                    )}

                    {!ready && (
                      <p class="hp-card__note">
                        Expanded case study in preparation.
                      </p>
                    )}

                    <span class="hp-card__link">
                      View project <span aria-hidden="true">→</span>
                    </span>
                  </a>
                );
              },
            )
          }
        </div>

        <p class="hp-actions hp-actions--after">
          <a class="hp-btn hp-btn--secondary" href="/work/projects/">
            View all projects
          </a>
        </p>
      </div>
    </section>

    <section
      class="hp-block hp-block--bordered"
      aria-labelledby="research-writing-title"
    >
      <div class="hp-wrap hp-feature">
        <div>
          <p class="hp-eyebrow">Research and writing</p>
          <h2 id="research-writing-title">
            Evidence, explanation and informed perspective.
          </h2>
        </div>

        <div class="hp-feature__content">
          <p>
            I write and contribute to research on astrophysics, Earth
            observation, space sustainability, climate and how science reaches
            the public.
          </p>

          {
            latestPost && (
              <p class="hp-latest">
                <span>Latest writing</span>
                <a href={`/blog/${latestPost.data.slug ?? latestPost.id}/`}>
                  {latestPost.data.title}
                </a>
              </p>
            )
          }

          <div class="hp-actions">
            <a class="hp-btn hp-btn--secondary" href="/research/">
              Explore research
            </a>

            <a class="hp-btn hp-btn--secondary" href="/work/editorial/">
              Read writing and commentary
            </a>
          </div>
        </div>
      </div>
    </section>

    <section
      class="hp-block hp-block--bordered"
      aria-labelledby="learning-title"
    >
      <div class="hp-wrap">
        <div class="hp-heading">
          <div>
            <p class="hp-eyebrow">Learning and engagement</p>
            <h2 id="learning-title">
              Build understanding, confidence and direction.
            </h2>
          </div>

          <p>
            Support for people and groups who want to understand a subject more
            deeply, communicate more effectively or think through a useful next
            step.
          </p>
        </div>

        <div class="hp-grid hp-grid--pair">
          <article class="hp-card hp-card--route">
            <p class="hp-eyebrow hp-eyebrow--violet">One-to-one support</p>

            <h3>Mentoring</h3>

            <p>
              Structured conversations for early- and mid-career professionals,
              career changers and people exploring space, sustainability,
              science communication or mission-led digital work.
            </p>

            <a class="hp-link" href="/mentoring/">
              How mentoring works
              <span aria-hidden="true">&nbsp;→</span>
            </a>
          </article>

          <article class="hp-card hp-card--route">
            <p class="hp-eyebrow hp-eyebrow--violet">For groups and events</p>

            <h3>Teaching, workshops and talks</h3>

            <p>
              Physics and astronomy tuition, guest teaching, workshops and
              public talks for schools, universities, charities, professional
              teams and wider communities.
            </p>

            <a class="hp-link" href="/teaching/">
              Explore teaching and workshops
              <span aria-hidden="true">&nbsp;→</span>
            </a>
          </article>
        </div>
      </div>
    </section>

    <section class="hp-orbit" aria-labelledby="impact-orbit-title">
      <div class="hp-wrap hp-feature">
        <div>
          <p class="hp-eyebrow">Organisation-level projects</p>
          <h2 id="impact-orbit-title">Impact Orbit Co.</h2>
        </div>

        <div class="hp-feature__content">
          <p>
            Larger organisation-level projects in strategic communication and
            digital strategy and systems are delivered through Impact Orbit Co.
          </p>

          <p>
            This site is the home of my personal practice: research, writing,
            teaching, mentoring, speaking and selected collaborations.
          </p>

          <p class="hp-actions">
            <a
              class="hp-btn hp-btn--secondary"
              href="https://impactorbit.co/"
              target="_blank"
              rel="noopener noreferrer"
            >
              Visit Impact Orbit Co.
              <span class="sr-only">, opens in a new tab</span>
            </a>
          </p>
        </div>
      </div>
    </section>

    <section class="hp-cta" aria-labelledby="next-step-title">
      <div class="hp-wrap">
        <p class="hp-eyebrow">Not sure where to start?</p>

        <h2 id="next-step-title">Tell me what you are trying to do.</h2>

        <p class="hp-cta__intro">
          Choose the closest option and describe what you have in mind. If a
          different route, collaborator or Impact Orbit Co. is a better fit, I
          will say so.
        </p>

        <div class="hp-grid hp-grid--options">
          {
            enquiries.types.map((type) => (
              <a class="hp-option" href={`/contact/#${type.id}`}>
                <strong class="hp-option__title">{type.label}</strong>
                <span class="hp-option__hint">{type.hint}</span>
                <span class="hp-option__arrow" aria-hidden="true">→</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  /* ------------------------------------------------------------------
     Homepage styles. Every class is prefixed hp- so nothing collides with
     the shared .route / .split / .work-grid / .go / .home-* rules in
     pages.css. Mobile-first: base rules are for phones; min-width queries
     add columns. Spacing comes from ONE gutter source (.hp-wrap).
     ------------------------------------------------------------------ */

  .hp-root {
    padding-inline: 0; /* beats :where(main > *) in global.css */
    overflow-x: clip; /* clip, not hidden: keeps focus rings and sticky intact */
  }

  .hp-root > section {
    padding-inline: 0;
  }

  .hp-wrap {
    width: 100%;
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: var(--gutter-min);
  }

  /* Type ---------------------------------------------------------- */
  .hp-eyebrow {
    margin: 0;
    color: var(--teal);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .hp-eyebrow--violet {
    color: var(--violet);
  }

  .hp-root h1,
  .hp-root h2 {
    margin: 0.75rem 0 0;
    color: var(--w);
    font-family: var(--font-display);
    font-weight: 400;
    letter-spacing: -0.03em;
    overflow-wrap: break-word;
  }

  .hp-root h1 {
    max-width: 22ch;
    font-size: clamp(2.25rem, 1.2rem + 4.2vw, 5rem);
    line-height: 1.04;
  }

  .hp-root h2 {
    max-width: 22ch;
    font-size: clamp(1.85rem, 1rem + 3.2vw, 3.75rem);
    line-height: 1.08;
  }

  .hp-lead {
    max-width: 43rem;
    margin: clamp(1.25rem, 3vw, 2.25rem) 0 0;
    color: var(--w);
    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.4rem);
    line-height: 1.55;
  }

  .hp-support,
  .hp-location {
    max-width: 39rem;
    margin: 1rem 0 0;
    color: var(--mb);
    font-size: 1rem;
    line-height: 1.7;
  }

  .hp-location {
    color: var(--m);
    font-size: 0.9375rem;
  }

  /* Buttons and links --------------------------------------------- */
  .hp-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.75rem 0 0;
  }

  .hp-actions--after {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
  }

  .hp-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem; /* 44px */
    padding: 0.8rem 1.1rem;
    border: 1px solid transparent;
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      color 0.2s ease,
      background 0.2s ease;
  }

  .hp-btn--primary {
    border-color: var(--teal);
    color: var(--on-accent);
    background: var(--teal);
  }

  .hp-btn--primary:hover,
  .hp-btn--primary:focus-visible {
    border-color: var(--w);
    color: var(--on-accent);
    background: var(--w);
  }

  .hp-btn--secondary {
    border-color: var(--bm);
    color: var(--w);
    background: transparent;
  }

  .hp-btn--secondary:hover,
  .hp-btn--secondary:focus-visible {
    border-color: var(--teal);
    color: var(--teal);
  }

  .hp-link,
  .hp-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    width: fit-content;
    min-height: 2.75rem; /* 44px touch target */
    color: var(--w);
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.4;
    text-decoration: underline;
    text-decoration-color: var(--teal);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }

  .hp-link:hover,
  .hp-link:focus-visible,
  .hp-card--work:hover .hp-card__link,
  .hp-card--work:focus-visible .hp-card__link {
    color: var(--teal);
  }

  /* Hero ---------------------------------------------------------- */
  .hp-hero {
    padding-block: clamp(2rem, 5vw, 4rem) clamp(3rem, 8vw, 7rem);
  }

  .hp-hero__grid {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  .hp-portrait {
    width: 100%;
    max-width: 15rem;
    margin: 0;
    overflow: hidden;
    background: var(--lift);
  }

  .hp-portrait img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    object-position: center top;
  }

  /* Credentials --------------------------------------------------- */
  .hp-creds {
    border-block: 1px solid var(--bd);
  }

  .hp-creds ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem 1.25rem;
    padding: 1.1rem 0;
    margin: 0;
    list-style: none;
  }

  .hp-creds li {
    color: var(--m);
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .hp-creds strong {
    display: block;
    color: var(--w);
    font-weight: 700;
  }

  /* Blocks and headings ------------------------------------------- */
  .hp-block,
  .hp-orbit,
  .hp-cta {
    padding-block: clamp(3rem, 8vw, 7rem);
  }

  .hp-block--bordered,
  .hp-orbit,
  .hp-cta {
    border-top: 1px solid var(--bd);
  }

  .hp-orbit {
    background: var(--lift);
  }

  .hp-heading,
  .hp-feature {
    display: grid;
    gap: 1.5rem;
  }

  .hp-heading {
    padding-bottom: clamp(1.75rem, 4vw, 3.5rem);
  }

  .hp-heading > p,
  .hp-feature__content > p,
  .hp-cta__intro {
    max-width: 38rem;
    margin: 0;
    color: var(--mb);
    font-size: 1rem;
    line-height: 1.7;
  }

  .hp-feature__content > p + p {
    margin-top: 1.1rem;
  }

  .hp-feature__content {
    max-width: 39rem;
  }

  .hp-cta__intro {
    margin-top: 1.25rem;
  }

  .hp-latest {
    display: grid;
    gap: 0.15rem;
    padding-top: 1.25rem;
    margin-top: 1.25rem !important;
    border-top: 1px solid var(--bd);
  }

  .hp-latest span {
    color: var(--m);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hp-latest a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    width: fit-content;
    color: var(--w);
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.4;
    text-decoration-color: var(--teal);
    text-underline-offset: 0.25em;
  }

  .hp-latest a:hover,
  .hp-latest a:focus-visible {
    color: var(--teal);
  }

  /* Service stories ----------------------------------------------- */
  .hp-stories {
    border-top: 1px solid var(--bd);
  }

  .hp-story {
    display: grid;
    gap: 0.9rem;
    padding-block: clamp(1.75rem, 4vw, 3.5rem);
    border-bottom: 1px solid var(--bd);
  }

  .hp-story[data-tone="teal"] { --accent: var(--teal); }
  .hp-story[data-tone="sky"] { --accent: var(--sky); }
  .hp-story[data-tone="violet"] { --accent: var(--violet); }
  .hp-story[data-tone="amber"] { --accent: var(--amber); }

  .hp-story__number {
    display: none; /* decorative; shown from 35rem */
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .hp-story__action {
    margin: 0;
    color: var(--accent);
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .hp-story h3 {
    margin: 0.35rem 0 0;
    color: var(--w);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.5rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.08;
    overflow-wrap: break-word;
  }

  .hp-story__content {
    max-width: 42rem;
  }

  .hp-story__lead {
    margin: 0;
    color: var(--w);
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .hp-story__outcomes {
    display: grid;
    gap: 0.5rem;
    padding: 0;
    margin: 1.1rem 0 0;
    list-style: none;
  }

  .hp-story__outcomes li {
    color: var(--mb);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .hp-story__outcomes li::before {
    margin-right: 0.65rem;
    color: var(--accent);
    content: "—";
  }

  .hp-story__for {
    margin: 1.25rem 0 0;
    color: var(--m);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .hp-story__for strong {
    color: var(--w);
  }

  /* Card grids (mobile: one column) ------------------------------- */
  .hp-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-top: 1px solid var(--bd);
    border-left: 1px solid var(--bd);
  }

  .hp-card,
  .hp-option {
    padding: clamp(1.25rem, 3vw, 2.25rem);
    border-right: 1px solid var(--bd);
    border-bottom: 1px solid var(--bd);
  }

  .hp-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .hp-card h3 {
    margin: 0.8rem 0 0;
    color: var(--w);
    font-size: clamp(1.2rem, 1.05rem + 0.7vw, 1.55rem);
    line-height: 1.25;
    overflow-wrap: break-word;
  }

