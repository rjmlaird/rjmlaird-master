---
import LegalNoticeLayout from "../layouts/LegalNotice.astro";
import { siteLegal } from "../data/legal";
import { defineSections } from "../lib/notice";
import ContactBlock from "../components/legal/ContactBlock.astro";
import LegalSection from "../components/legal/LegalSection.astro";
import Mailto from "../components/legal/Mailto.astro";

const lastUpdated = "2026-10-13";

const s = defineSections({
  about: "About these terms",
  acceptance: "Acceptance of terms",
  "website-purpose": "Purpose of this website",
  "acceptable-use": "Acceptable use",
  content: "Content and information",
  "intellectual-property": "Intellectual property",
  permission: "Permission to reuse content",
  links: "Links to other websites",
  linking: "Linking to this website",
  availability: "Availability and security",
  liability: "Liability",
  privacy: "Privacy and cookies",
  services: "Services and bookings",
  changes: "Changes to these terms",
  "governing-law": "Governing law",
  contact: "Contact",
});
---

<LegalNoticeLayout
  title="Terms of use"
  description="Terms governing use of rjmlaird.co.uk."
  eyebrow="Legal"
  lead="These terms explain the rules for using rjmlaird.co.uk, including how website content may be used and the limits that apply to information and external links."
  lastUpdated={lastUpdated}
  sections={s.list}
  related={["privacy", "cookies", "accessibility", "disclaimer"]}
>
  <Fragment slot="summary">
    <p>
      You may use this website for lawful, personal and professional purposes.
      Website content remains protected by intellectual-property rights, and
      separate written terms apply where services, bookings or paid work are
      agreed.
    </p>
  </Fragment>

  <LegalSection section={s.by.about}>

    <p>
      These terms of use apply to your access to and use of <a href={siteLegal.siteUrl}>{siteLegal.siteUrl}</a>, including pages, articles, resources, downloads, contact routes and other material made available through this website.
    </p>

    <p>
      In these terms, “I”, “me” and “my” mean
      <strong> {siteLegal.controllerName}</strong>. “You” means any person,
      organisation or other entity accessing or using this website.
    </p>

    <p>
      These terms apply to the website itself. They do not, by themselves,
      create a contract for advisory, communication, speaking, editorial,
      teaching, mentoring, digital or other professional services.
    </p>
  </LegalSection>

  <LegalSection section={s.by.acceptance}>

    <p>
      By accessing or using this website, you agree to comply with these terms.
      If you do not agree with them, please do not use the website.
    </p>

    <p>
      You are responsible for ensuring that anyone who accesses the website
      through your internet connection is aware of these terms and complies
      with them.
    </p>
  </LegalSection>

  <LegalSection section={s.by["website-purpose"]}>

    <p>
      This website provides information about my professional background, work,
      services, writing, speaking, research, projects and related activities.
      It may also provide routes to make an enquiry, request a contribution,
      access resources or visit related websites and services.
    </p>

    <p>
      Content is provided for general information and professional context. It
      is not intended to be legal, financial, medical, therapeutic, investment,
      regulatory, technical, academic or other specialist advice on which you
      should rely without obtaining appropriate independent advice.
    </p>

    <p>
      Any views, analysis or commentary published on this site are provided in
      good faith and may be updated, corrected, expanded, withdrawn or replaced
      without notice.
    </p>
  </LegalSection>

  <LegalSection section={s.by["acceptable-use"]}>

    <p>You may use this website only for lawful purposes. You must not:</p>

    <ul>
      <li>
        Use the website in a way that breaches applicable local, national or
        international law or regulation.
      </li>
      <li>
        Use the website in a way that is unlawful, fraudulent, misleading,
        harmful, threatening, abusive, defamatory, discriminatory or otherwise
        objectionable.
      </li>
      <li>
        Attempt to gain unauthorised access to the website, its hosting,
        connected systems, accounts, data or infrastructure.
      </li>
      <li>
        Introduce viruses, malware, ransomware, spyware, harmful code or other
        technologically harmful material.
      </li>
      <li>
        Probe, scan, test or circumvent the security, authentication,
        rate-limiting or access controls of the website without permission.
      </li>
      <li>
        Use automated tools, bots, scrapers, crawlers or similar methods to
        access, copy, index, extract or monitor the site except where permitted
        by applicable law or standard search-engine indexing practices.
      </li>
      <li>
        Interfere with, disrupt, damage or overload the website, its servers or
        any connected network.
      </li>
      <li>
        Use contact details, forms or other website features to send spam,
        unsolicited marketing, harassment or irrelevant communications.
      </li>
      <li>
        Impersonate another person or organisation, or misrepresent your
        identity, affiliation, authority or intentions.
      </li>
      <li>
        Remove, obscure or alter copyright, trade-mark, attribution or other
        proprietary notices.
      </li>
    </ul>

    <p>
      I may take reasonable steps to protect the website, users and systems,
      including restricting or blocking access where misuse is suspected.
    </p>
  </LegalSection>

  <LegalSection section={s.by.content}>

    <p>
      I take reasonable care to keep website content accurate, current and
      useful. However, the website and its content are provided on an
      “as available” basis. Information may become out of date, contain
      inaccuracies, omit relevant context or no longer reflect current
      circumstances.
    </p>

    <p>
      You should independently verify information that is important to a
      decision, action, project, purchase, application, policy position,
      technical implementation or professional engagement.
    </p>

    <p>
      References to third parties, organisations, publications, tools, products,
      services, events or websites do not necessarily constitute endorsement,
      partnership, recommendation or approval.
    </p>

    <p>
      Past work, examples, case studies, outcomes and commentary are presented
      for context. They do not guarantee that the same outcomes can be achieved
      in another situation.
    </p>
  </LegalSection>

  <LegalSection section={s.by["intellectual-property"]}>

    <p>
      Unless stated otherwise, I own or hold the relevant rights or permissions
      for the content, design, text, imagery, graphics, logos, video, audio,
      research, data visualisations, code, downloadable materials and other
      materials published on this website.
    </p>

    <p>
      Those materials are protected by copyright, trade-mark, database,
      design, confidentiality and other intellectual-property laws. All rights
      not expressly granted in these terms are reserved.
    </p>

    <p>
      Third-party content remains the property of its respective owner and may
      be subject to separate licences, rights notices, attribution requirements
      or conditions of use.
    </p>

    <h3>Permitted personal and professional use</h3>

    <p>You may:</p>

    <ul>
      <li>View pages in a web browser for your own lawful use</li>
      <li>Print or download reasonable extracts for personal reference</li>
      <li>Share a link to a page through ordinary web or social-sharing tools</li>
      <li>
        Quote short extracts with clear attribution, a link to the original
        page where practicable, and without altering the meaning or context
      </li>
      <li>
        Draw the attention of colleagues, clients, students or collaborators to
        material published on the site
      </li>
    </ul>

    <h3>Restricted use</h3>

    <p>You must not, without prior written permission:</p>

    <ul>
      <li>
        Copy, reproduce, republish, sell, license, distribute or commercially
        exploit a substantial part of the website or its content.
      </li>
      <li>
        Adapt, translate, edit, remix or create derivative works from material
        in a way that misrepresents the original meaning, author or context.
      </li>
      <li>
        Present website content as your own work or remove attribution,
        copyright notices or other rights information.
      </li>
      <li>
        Use photographs, illustrations, graphics, video, audio or other visual
        assets separately from their accompanying context where this could
        infringe rights or create a misleading impression.
      </li>
      <li>
        Use the website or its content to train, fine-tune, benchmark, evaluate
        or develop an artificial-intelligence, machine-learning or similar
        system, except where this is expressly permitted by applicable law or
        agreed in writing.
      </li>
      <li>
        Use the site’s name, branding, logos or identity in a way that suggests
        endorsement, partnership or official association where none exists.
      </li>
    </ul>
  </LegalSection>

  <LegalSection section={s.by.permission}>

    <p>
      If you would like to reproduce, adapt, translate, publish, license,
      commercially use or otherwise reuse content beyond the limited permission
      set out above, please request permission before doing so.
    </p>

    <p>
      Send requests to <Mailto email={siteLegal.contactEmail} />
      and include:
    </p>

    <ul>
      <li>The specific page, content or asset you wish to use</li>
      <li>The intended use, format, audience and territory</li>
      <li>Whether the use is commercial, educational, editorial or personal</li>
      <li>Whether you intend to alter, translate or excerpt the material</li>
      <li>The proposed attribution and link-back arrangement</li>
    </ul>

    <p>
      Permission may be granted, refused or made subject to conditions,
      attribution, fees, licences or separate written agreement.
    </p>
  </LegalSection>

  <LegalSection section={s.by.links}>

    <p>
      This website may link to third-party websites, services, resources,
      social-media platforms, booking tools, publications or organisations.
      These links are provided for convenience, context or further information.
    </p>

    <p>
      I do not control third-party websites and am not responsible for their
      content, availability, security, accessibility, data practices, terms,
      services or any loss arising from your use of them.
    </p>

    <p>
      Before using a third-party website or service, you should read its own
      terms, privacy notice, cookie notice and other relevant policies.
    </p>

    <p>
      A link does not mean that I endorse, approve, sponsor or have a formal
      relationship with the linked organisation, unless the site expressly says
      otherwise.
    </p>
  </LegalSection>

  <LegalSection section={s.by.linking}>

    <p>
      You may link to the homepage or other public pages of this website,
      provided that you do so in a fair, lawful and non-misleading way.
    </p>

    <p>You must not:</p>

    <ul>
      <li>Suggest that I endorse, approve or am affiliated with you where this is not true</li>
      <li>Frame this website within another site without prior written permission</li>
      <li>Use a link in a way that damages my reputation or takes unfair advantage of it</li>
      <li>Link from a website containing unlawful, misleading, hateful, abusive or infringing material</li>
      <li>Use my name, logo or other branding as part of a link without permission</li>
    </ul>

    <p>
      I may withdraw linking permission at any time where a link is misleading,
      harmful, inappropriate or otherwise inconsistent with these terms.
    </p>
  </LegalSection>

  <LegalSection section={s.by.availability}>

    <p>
      I do not guarantee that the website, or any content on it, will always be
      available, uninterrupted, secure, error-free or free from harmful
      components. Access may be suspended, withdrawn, restricted or changed
      without notice for maintenance, security, operational, legal or other
      reasons.
    </p>

    <p>
      You are responsible for making your own arrangements to access the
      website. You should use your own virus protection, security controls and
      backup arrangements when accessing websites or downloading material.
    </p>

    <p>
      You must not misuse the website by knowingly introducing harmful material
      or attempting unauthorised access. Such activity may be reported to
      relevant authorities.
    </p>
  </LegalSection>

  <LegalSection section={s.by.liability}>

    <p>
      Nothing in these terms excludes or limits liability where it would be
      unlawful to do so, including liability for death or personal injury caused
      by negligence, fraud or fraudulent misrepresentation, or any other
      liability that cannot lawfully be excluded or restricted.
    </p>

    <p>
      Subject to the paragraph above, and to the extent permitted by law, I do
      not accept liability for loss or damage arising from:
    </p>

    <ul>
      <li>Your use of, or inability to use, this website</li>
      <li>Reliance on information, commentary or materials published on the site</li>
      <li>Errors, omissions, interruptions, delays or unavailability</li>
      <li>Viruses, malware or other harmful material encountered through use of the internet</li>
      <li>Third-party websites, tools, services, content or resources linked from this site</li>
      <li>Unauthorised access to, alteration of or loss of information, except where liability cannot lawfully be excluded</li>
      <li>Indirect, consequential or purely economic loss, including loss of profit, revenue, business, opportunity, goodwill or data</li>
    </ul>

    <p>
      These limitations apply only to use of this website. They do not override
      any separate written agreement governing professional services, a booking,
      a commission, a project, a workshop, a talk or another paid engagement.
    </p>
  </LegalSection>

  <LegalSection section={s.by.privacy}>

    <p>
      Personal information collected through this website is handled in
      accordance with the <a href="/privacy/">privacy notice</a>.
    </p>

    <p>
      Information about cookies and similar technologies is set out in the <a href="/cookies/">cookie notice</a>.
    </p>
  </LegalSection>

  <LegalSection section={s.by.services}>

    <p>
      Information on this website about services, availability, formats,
      approaches or areas of interest is informational only. It does not
      constitute an offer to provide services, a binding quotation, a guarantee
      of availability or a commitment to accept any request.
    </p>

    <p>
      Any work, booking, paid service, event contribution, speaking engagement,
      editorial commission, advisory activity, tutoring, mentoring or
      collaboration is subject to separate written confirmation. That may
      include a proposal, scope of work, quote, booking confirmation, invoice,
      service agreement, event agreement or other applicable terms.
    </p>

    <p>
      Some organisation-level work may be delivered through <a href={siteLegal.impactOrbitUrl}>Impact Orbit Collective</a> rather
      than directly through this website. Where that applies, the relevant
      organisation’s terms and privacy information may also apply.
    </p>

    <p>
      Booking routes may be provided through <a href={siteLegal.bookingUrl}>booking.rjmlaird.co.uk</a>. Any booking,
      payment, cancellation, rescheduling or service-specific terms shown
      there apply in addition to these website terms where relevant.
    </p>
  </LegalSection>

  <LegalSection section={s.by.changes}>

    <p>
      These terms may be updated from time to time to reflect changes to the
      website, its content, technology, security arrangements, services or
      legal requirements.
    </p>

    <p>
      The current version will be published on this page with the date it was
      last updated. Continued use of the website after an update means you
      accept the revised terms.
    </p>
  </LegalSection>

  <LegalSection section={s.by["governing-law"]}>

    <p>
      These terms, their subject matter and their formation are governed by the
      laws of England and Wales.
    </p>

    <p>
      The courts of England and Wales will have jurisdiction over disputes
      arising from or connected with these terms or your use of this website,
      except where mandatory law gives you the right to bring proceedings in
      another jurisdiction.
    </p>
  </LegalSection>

  <LegalSection section={s.by.contact}>

    <p>
      If you have a question about these terms, want to request permission to
      reuse content or need to report a problem with the website, contact:
    </p>

    <ContactBlock name={siteLegal.controllerName} email={siteLegal.contactEmail} />
  </LegalSection>

  <Fragment slot="draft-note">
    <p>
      <strong>Before publishing:</strong> review the terms against the actual
      functionality of your site, including downloads, log-in areas, embedded
      media, AI tools, analytics, booking platforms, ecommerce, community
      features and any user-generated content. This page is a website-use
      notice and should not replace professionally reviewed client-service,
      tutoring, speaking, event or booking terms where those are needed.
    </p>
  </Fragment>
</LegalNoticeLayout>
