---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import articles from "../../data/articles.json";
import { TOPICS, topicsFor } from "../../lib/topics";

type Entry = { title: string; url: string; date: Date; summary: string; kind: string; where: string; topics: string[]; external: boolean };

const posts = await getCollection("blog", ({ data }) => !data.draft);
const entries: Entry[] = [
  ...posts.map((p) => ({
    title: p.data.title ?? "",
    url: `/blog/${p.data.slug ?? p.id}/`,
    date: p.data.pubDate,
    summary: p.data.description ?? "",
    kind: "Essay",
    where: "This site",
    topics: topicsFor(p.data.category, p.data.tags, p.data.title),
    external: false,
  })),
  ...(articles.articles as any[]).map((a) => ({
    title: a.title,
    url: a.url,
    date: new Date(a.date),
    summary: a.excerpt ?? "",
    kind: "Article",
    where: a.publication ?? "",
    topics: topicsFor(a.topics, a.title, a.publication),
    external: true,
  })),
].sort((a, b) => b.date.valueOf() - a.date.valueOf());

const used = TOPICS.filter((t) => entries.some((e) => e.topics.includes(t.slug)));
const fmt = (d: Date) => d.toLocaleDateString("en-GB", { year: "numeric", month: "short" });
---

<Layout title="Writing" description="Essays, articles and commentary by Ryan Laird on space, sustainability, science communication and digital strategy.">
  <div class="wrap page">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/research/">Research and writing</a> / Writing</nav>
    <header class="page-head">
      <h1>Writing</h1>
      <p class="lead">Essays on this site and articles published elsewhere. Filter by topic.</p>
    </header>

    <div class="filter-row" role="group" aria-label="Filter by topic" id="topic-filters">
      <button class="chip" type="button" data-topic="all" aria-pressed="true">All</button>
      {used.map((t) => <button class="chip" type="button" data-topic={t.slug} aria-pressed="false">{t.label}</button>)}
    </div>

    <ul class="entry-list" id="entries">
      {entries.map((e) => (
        <li data-topics={e.topics.join(" ")}>
          <span class="when">{fmt(e.date)}</span>
          <div>
            <h3><a href={e.url} {...(e.external ? { rel: "noopener" } : {})}>{e.title}</a></h3>
            {e.summary && <p>{e.summary}</p>}
            <p class="tags">{[e.kind, e.where].filter(Boolean).join(" · ")}</p>
          </div>
        </li>
      ))}
    </ul>
    <p id="no-results" class="prose" hidden>Nothing under this topic yet.</p>
  </div>

  <script is:inline>
    (function () {
      var chips = document.querySelectorAll("#topic-filters .chip");
      var items = document.querySelectorAll("#entries li");
      var empty = document.getElementById("no-results");
      function apply(topic) {
        var shown = 0;
        items.forEach(function (li) {
          var match = topic === "all" || (li.dataset.topics || "").split(" ").indexOf(topic) > -1;
          li.hidden = !match;
          if (match) shown++;
        });
        chips.forEach(function (c) { c.setAttribute("aria-pressed", String(c.dataset.topic === topic)); });
        empty.hidden = shown !== 0;
      }
      chips.forEach(function (c) {
        c.addEventListener("click", function () {
          apply(c.dataset.topic);
          var u = new URL(location.href);
          c.dataset.topic === "all" ? u.searchParams.delete("topic") : u.searchParams.set("topic", c.dataset.topic);
          history.replaceState(null, "", u);
        });
      });
      var initial = new URL(location.href).searchParams.get("topic");
      if (initial) apply(initial);
    })();
  </script>
</Layout>
