---
import Layout from "../layouts/Layout.astro";
import data from "../data/open-source.json";
import tools from "../data/tools.json";
---

<Layout title="Open source and lab" description="Open-source work, data projects, tools and technical experiments by Ryan Laird, with the status of each stated.">
  <div class="wrap page">
    <header class="page-head">
      <h1>Open source and lab</h1>
      <p class="lead">
        Code, data projects and experiments that support my research, writing and client work. Each entry says how
        mature it is, from experiment to in use.
      </p>
      <div class="cta-row">
        {data.profiles.map((p) => <a class="bo" href={p.url} rel="me noopener">{p.label}</a>)}
      </div>
    </header>

    {data.groups.map((g) => (
      <section class="block">
        <h2>{g.title}</h2>
        <div class="route-grid">
          {g.items.map((i) => (
            <article class="route" data-tone="violet">
              <h3>{i.name}</h3>
              <p><span class="status-tag">{i.status}</span></p>
              <p>{i.text}</p>
              {i.url && <a class="go" href={i.url} rel="noopener">View repository</a>}
            </article>
          ))}
        </div>
      </section>
    ))}

    <section class="block">
      <h2>Tools I build with</h2>
      <p class="prose">
        {tools.categories.map((c) => `${c.name}: ${c.items.map((i) => i.name).join(", ")}.`).join(" ")}
      </p>
    </section>
  </div>
</Layout>
