---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import ProjectCard from "../../components/Projects/ProjectCard.astro";
import Filters from "../../components/Projects/Filters.astro";

const projects = await getCollection(
  "projects",
  ({ data }) => data.draft !== true
);
---

<Layout
  title="Projects"
  description="Space, sustainability and science-communication projects — filter by date, client, tags, type and status."
>
  <section class="project-index">
    <div class="container pg-shell">
      <header class="pg-head">
        <p class="eyebrow">Projects</p>

        <h1 class="ch fade">
          Projects across <em>space, sustainability &amp; science policy</em>
        </h1>
        <p class="lead" style="max-width:44rem;margin-top:1rem">
          Work across space communications, Earth observation, public engagement and research. Entries are being
          rewritten one at a time as full case studies, with context, my role and outcomes. Where a page is still
          short, it is marked and kept out of search results until it is complete.
        </p>
      </header>

      <Filters items={projects} />

      <div class="grid" id="projectGrid">
        {projects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </div>
  </section>
</Layout>

