---
import Layout from "../../layouts/Layout.astro";
import experiments from "../../data/experiments.json";

interface Experiment {
  slug: string;
  title: string;
  description: string;
  status: "active" | "planned";
  tech: string[];
  demoUrl?: string;
  repoUrl?: string;
  updated: string;
}

const labs = experiments as Experiment[];

// Map status "active" -> "in orbit" and "planned" -> "pre-launch" for display purposes
function getDisplayStatus(status: "active" | "planned"): "in orbit" | "pre-launch" {
  return status === "active" ? "in orbit" : "pre-launch";
}

function formatDate(dateStr: string): string {
  const [year, month, day] = dateStr.split("-");
  const date = new Date(Number(year), Number(month) - 1, Number(day));
  return date.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
}
---

<Layout 
  title="Labs — Ryan Laird" 
  description="Working experiments, orbital mechanics sandboxes, data pipelines, and interface prototypes."
>
  <div class="wrap page labs-page">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="https://rjmlaird.co.uk">rjmlaird.co.uk</a> / Labs
    </nav>

    <header class="page-head">
      <p class="sl">Experimental Sandbox</p>
      <h1>Labs</h1>
      <p class="lede">
        Working experiments, not finished products. A sandbox for orbital mechanics tools, data pipelines, and interface prototypes. Some of these will graduate to the main site. Most won't, and that's the point.
      </p>

      {/* Filter controls */}
      <div class="filters" id="status-filters">
        <button class="filter-btn active" data-filter="all">All ({labs.length})</button>
        <button class="filter-btn" data-filter="in orbit">In orbit ({labs.filter(i => getDisplayStatus(i.status) === 'in orbit').length})</button>
        <button class="filter-btn" data-filter="pre-launch">Pre-launch ({labs.filter(i => getDisplayStatus(i.status) === 'pre-launch').length})</button>
      </div>
    </header>

    <section class="block">
      <div class="repo-grid" id="labs-grid">
        {labs.map((item) => {
          const displayStatus = getDisplayStatus(item.status);
          return (
            <article class="repo-card lab-card" data-status={displayStatus}>
              <div class="lab-card-header">
                <span class={`status-badge ${displayStatus === 'in orbit' ? 'status-orbit' : 'status-pre'}`}>
                  {displayStatus}
                </span>
                <span class="repo-updated">Updated {formatDate(item.updated)}</span>
              </div>

              <h3 class="repo-name">{item.title}</h3>
              <p class="repo-desc">{item.description}</p>

              <div class="repo-topics">
                {item.tech.map((t) => (
                  <span class="tag">{t}</span>
                ))}
              </div>

              <div class="repo-links">
                {item.demoUrl && (
                  <a href={item.demoUrl} target="_blank" rel="noopener noreferrer">
                    Open demo ↗
                  </a>
                )}
                {item.repoUrl && (
                  <a href={item.repoUrl} target="_blank" rel="noopener noreferrer" class="source-link">
                    Source
                  </a>
                )}
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <footer class="labs-footer">
      <a href="https://rjmlaird.co.uk" class="back-link">← Back to rjmlaird.co.uk</a>
    </footer>
  </div>
</Layout>

<script>
  const filterButtons = document.querySelectorAll('#status-filters .filter-btn');
  const labCards = document.querySelectorAll<HTMLElement>('#labs-grid .lab-card');

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      const filterValue = btn.getAttribute('data-filter');

      labCards.forEach((card) => {
        const cardStatus = card.getAttribute('data-status');
        if (filterValue === 'all' || cardStatus === filterValue) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>

<style>
  .labs-page {
    max-width: 1040px;
    margin: 0 auto;
  }

  .labs-footer {
    margin: 4rem 0 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-color, rgba(255, 255, 255, 0.1));
  }

  .back-link {
    font-size: 0.92rem;
    text-decoration: none;
    opacity: 0.8;
    transition: opacity 0.2s;
  }

  .back-link:hover {
    opacity: 1;
  }

  .lab-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .status-badge {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    font-weight: 500;
  }

  .status-orbit {
    background: rgba(0, 194, 168, 0.15);
    color: #00C2A8;
  }

  .status-pre {
    background: rgba(245, 166, 35, 0.15);
    color: #F5A623;
  }

  .filters {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.5rem;
    flex-wrap: wrap;
  }

  .filter-btn {
    background: transparent;
    border: 1px solid var(--border-color, rgba(255, 255, 255, 0.2));
    padding: 0.35rem 0.9rem;
    border-radius: 6px;
    font-size: 0.85rem;
    cursor: pointer;
    color: inherit;
    transition: all 0.2s;
  }

  .filter-btn:hover {
    border-color: #00C2A8;
  }

  .filter-btn.active {
    background: #00C2A8;
    border-color: #00C2A8;
    color: #141B29;
    font-weight: 500;
  }

  .source-link {
    opacity: 0.7;
    margin-left: 1rem;
  }
</style>