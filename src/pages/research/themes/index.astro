---
import PageLayout from '../../../research/layouts/PageLayout.astro';
import ResearchThemeCard from '../../../research/components/ResearchThemeCard.astro';
import { getProjects } from '../../../research/lib/content';
import { themes } from '../../../research/data/themes';
const projects = await getProjects();
---
<PageLayout title="Themes" lede="The subject areas the projects sit within." crumbs={[{ label: 'Home', href: '/research/lab/' }, { label: 'Themes' }]}>
  <div class="grid">{themes.map((t) => <ResearchThemeCard {...t} count={projects.filter((p) => p.data.themes.includes(t.slug)).length} />)}</div>
</PageLayout>
