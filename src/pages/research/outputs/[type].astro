---
import PageLayout from '../../../research/layouts/PageLayout.astro';
import OutputCard from '../../../research/components/OutputCard.astro';
import { outputTypes } from '../../../research/data/output-types';
import { getProjects } from '../../../research/lib/content';
export function getStaticPaths() { return outputTypes.map((t) => ({ params: { type: t.slug }, props: { t } })); }
const { t } = Astro.props;
const items = (await getProjects()).flatMap((p) => p.data.outputs.filter((o) => o.type === t.type).map((o) => ({ ...o, projectId: p.id, projectTitle: p.data.title })));
---
<PageLayout title={t.label} crumbs={[{ label: 'Home', href: '/research/lab/' }, { label: 'Outputs', href: '/research/outputs/' }, { label: t.label }]}>
  {items.length === 0 ? <p class="muted">Nothing here yet.</p> : <div class="grid">{items.map((o) => <OutputCard {...o} />)}</div>}
</PageLayout>
