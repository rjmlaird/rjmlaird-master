---
import PageLayout from '../../../research/layouts/PageLayout.astro';
import ResearchNoteCard from '../../../research/components/ResearchNoteCard.astro';
import { getNotes } from '../../../research/lib/content';
const notes = await getNotes();
const tags = [...new Set(notes.flatMap((n) => n.data.tags))].sort();
---
<PageLayout title="Notes" lede="Literature notes, methods notes and a research log." crumbs={[{ label: 'Home', href: '/research/lab/' }, { label: 'Notes' }]}>
  <p class="ui small">Tags: {tags.map((t) => <><a href={`/research/notes/tags/${t}/`}>#{t}</a>{' '}</>)}</p>
  <div class="grid">{notes.map((n) => <ResearchNoteCard note={n} />)}</div>
</PageLayout>
