---
import { render } from 'astro:content';
import ProjectLayout from '../../../research/layouts/ProjectLayout.astro';
import { getProjects, getMethods } from '../../../research/lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  const methods = await getMethods();
  const methodTitles = Object.fromEntries(methods.map((m) => [m.id, m.data.title]));
  return projects.map((project) => ({ params: { slug: project.id }, props: { project, methodTitles } }));
}
const { project, methodTitles } = Astro.props;
const { Content } = await render(project);
---
<ProjectLayout project={project} methodTitles={methodTitles}><Content /></ProjectLayout>
