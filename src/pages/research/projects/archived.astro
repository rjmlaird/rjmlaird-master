---
import PageLayout from '../../../research/layouts/PageLayout.astro';
import ProjectCard from '../../../research/components/ProjectCard.astro';
import { getProjects } from '../../../research/lib/content';
const wanted = ['archived'];
const projects = (await getProjects()).filter((p) => wanted.includes(p.data.status));
---
<PageLayout title="Archived projects" lede="Projects no longer being developed." crumbs={[{ label: 'Home', href: '/research/lab/' }, { label: 'Projects', href: '/research/projects/' }, { label: 'Archived projects' }]}>
  {projects.length === 0 ? <p class="muted">No projects here yet.</p> : <div class="grid">{projects.map((p) => <ProjectCard project={p} />)}</div>}
</PageLayout>
