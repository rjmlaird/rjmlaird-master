---
import Layout from "../../layouts/Layout.astro";
import { readFile } from "node:fs/promises";
import path from "node:path";
import profile from "../../data/profile.json";

const bib = await readFile(path.join(process.cwd(), "src/data/publications.bib"), "utf8");
const pubCount = (bib.match(/^@\w+\s*\{/gm) ?? []).length;
const orcid = profile.contact.find((c) => c.label === "ORCID")?.href;

const sections = [
  { id: "publications", title: "Publications and academic work", text: "Journal articles, conference papers and reports from my astrophysics and Earth observation work.", href: "/research/publications/", cta: `Browse the bibliography (${pubCount} entries)` },
  { id: "independent", title: "Independent research and analysis", text: "Public-interest analysis and commentary written outside any institution, such as articles on space sustainability and communication practice.", href: "/writing/", cta: "Read the writing" },
  { id: "applied", title: "Applied research and project work", text: "Research done in service of a communication, sustainability, space or digital project. Each is described on its project page with its context and my role.", href: "/projects/", cta: "See projects" },
  { id: "methods", title: "Methods, data and open tools", text: "Code, data pipelines and experiments, published where I can so others can inspect or reuse them. Status is stated for each, from experiment to maintained.", href: "/open-source/", cta: "Open source and lab" },
  { id: "talks", title: "Talks, media and public engagement", text: "Conference talks, panels, podcast and press appearances, and events I have organised.", href: "/press/", cta: "Press and appearances" },
];
---

<Layout
  title="Research"
  description="Research by Ryan Laird: publications, independent analysis, applied research, open methods and tools, and talks and media."
>
  <div class="wrap page">
    <header class="page-head">
      <h1>Research and writing</h1>
      <p class="lead">
        My research starts in astrophysics and now sits alongside work on space sustainability, climate and Earth
        observation, and how science is communicated. This page separates formal academic work from public writing,
        professional research and technical experiments.
      </p>
    </header>

    <div class="note">
      <strong>A note on status.</strong> I work as an independent practitioner. The academic work below comes from my
      physics training and collaborations, and does not imply a current university appointment.
    </div>

    <div class="block">
      <h2>What’s here</h2>
      <div class="route-grid">
        {sections.map((s, i) => (
          <article class="route" id={s.id} data-tone={["sky", "teal", "amber", "violet", "teal"][i]}>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            <a class="go" href={s.href}>{s.cta}</a>
          </article>
        ))}
      </div>
    </div>

    <section class="block" aria-labelledby="themes">
      <h2 id="themes">Current themes</h2>
      <ul class="plain-list">
        <li><strong>Space sustainability:</strong> how space organisations talk about and act on environmental impact.</li>
        <li><strong>Climate and Earth observation:</strong> making satellite-derived evidence usable by non-specialists.</li>
        <li><strong>Science communication and misinformation:</strong> how accuracy and trust are maintained in public explanation.</li>
        <li><strong>Digital systems, accessibility and public knowledge:</strong> how websites and data make or hide information.</li>
        <li><strong>Astronomy and public understanding:</strong> comets, missions and the stories around them.</li>
      </ul>
    </section>

    <section class="block" aria-labelledby="profiles">
      <h2 id="profiles">External profiles</h2>
      <ul class="plain-list">
        {orcid && <li><a class="link" href={orcid} rel="me noopener">ORCID</a></li>}
        <li><a class="link" href="https://github.com/rjmlaird" rel="me noopener">GitHub</a></li>
        <li><a class="link" href="/press/">Press and media profile</a></li>
      </ul>
    </section>
  </div>
</Layout>
