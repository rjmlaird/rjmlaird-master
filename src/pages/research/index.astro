---
import Layout from "../../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { getEntry } from "astro:content";
import { readFile } from "node:fs/promises";
import path from "node:path";
import socials from "../../data/socials.json";
import featured from "../../data/featured-research.json";
import { resolveIcon, HIDDEN_SOCIALS } from "../../lib/icons";

const bib = await readFile(path.join(process.cwd(), "src/data/publications.bib"), "utf8");
const pubCount = (bib.match(/^@\w+\s*\{/gm) ?? []).length;

const academicProfiles = socials.filter(
  (item) => item.type === "academic" && !HIDDEN_SOCIALS.has(item.key),
);

/* ---- Featured research projects, resolved from the content collection ---- */

type FeaturedItem = {
  collection: string;
  slug: string;
  sector?: string;
  year?: string;
  role?: string;
  outcome?: string;
  href?: string;
};

const TONES = ["teal", "violet", "sky", "amber"] as const;

const text = (value: unknown): string =>
  typeof value === "string" ? value.trim() : "";

const featuredProjects = (
  await Promise.all(
    (featured.items as FeaturedItem[]).map(async (item, index) => {
      const entry = await getEntry(item.collection as "projects", item.slug);

      if (!entry) {
        console.warn(
          `[research] Featured project not found: ${item.collection}/${item.slug}`,
        );
        return null;
      }

      const data = entry.data as Record<string, unknown>;

      return {
        slug: item.slug,
        title: text(data.title) || text(data.name) || item.slug,
        summary:
          text(data.summary) || text(data.description) || text(data.excerpt),
        sector: text(item.sector),
        year: text(item.year),
        role: text(item.role),
        outcome: text(item.outcome),
        href: item.href ?? `/work/projects/${item.slug}/`,
        tone: TONES[index % TONES.length],
      };
    }),
  )
).filter((project): project is NonNullable<typeof project> => project !== null);

const themes = [
  {
    title: "Space sustainability",
    text: "How space organisations talk about and act on environmental impact.",
  },
  {
    title: "Climate and Earth observation",
    text: "Making satellite-derived evidence usable by non-specialists.",
  },
  {
    title: "Science communication and misinformation",
    text: "How accuracy and trust are maintained in public explanation.",
  },
  {
    title: "Digital systems, accessibility and public knowledge",
    text: "How websites and data make or hide information.",
  },
  {
    title: "Astronomy and public understanding",
    text: "Comets, missions and the stories around them.",
  },
];
---

<Layout
  title="Research"
  description="Research by Ryan Laird: publications in astrophysics and Earth observation, featured research projects, current research themes, and academic profiles."
>
  <div class="wrap page">
    <header class="page-head">
      <p class="sl">Research</p>
      <h1>Research</h1>

      <p class="lede">
        My research starts in astrophysics and now sits alongside work on space sustainability, climate and Earth
        observation, and how science is communicated.
      </p>
    </header>

    <div class="note" role="note">
      <strong>A note on status.</strong> I work as an independent practitioner. The academic work below comes from my
      physics training and collaborations, and does not imply a current university appointment.
    </div>

    <section class="block" aria-labelledby="publications-heading">
      <h2 id="publications-heading">Publications</h2>

      <div class="route-grid">
        <article class="route" id="publications" data-tone="sky">
          <h3>Publications and academic work</h3>
          <p>Journal articles, conference papers and reports from my astrophysics and Earth observation work.</p>
          <a class="go" href="/research/publications/">Browse the bibliography ({pubCount} entries)</a>
        </article>
      </div>
    </section>

    {featuredProjects.length > 0 && (
      <section class="block" aria-labelledby="featured-heading">
        <h2 id="featured-heading">Featured research projects</h2>

        <div class="route-grid">
          {featuredProjects.map((project) => (
            <article class="route" id={project.slug} data-tone={project.tone}>
              {(project.sector || project.year) && (
                <p class="for">
                  {[project.sector, project.year].filter(Boolean).join(" · ")}
                </p>
              )}

              <h3>{project.title}</h3>

              {project.summary && <p>{project.summary}</p>}

              {project.role && (
                <p class="for"><strong>Role:</strong> {project.role}</p>
              )}

              {project.outcome && (
                <p class="for"><strong>Outcome:</strong> {project.outcome}</p>
              )}

              <a class="go" href={project.href}>
                View project<span class="sr-only">: {project.title}</span>
              </a>
            </article>
          ))}
        </div>
      </section>
    )}

    <section class="block" aria-labelledby="themes-heading">
      <h2 id="themes-heading">Research interests and themes</h2>

      <ul class="plain-list">
        {themes.map((theme) => (
          <li><strong>{theme.title}:</strong> {theme.text}</li>
        ))}
      </ul>
    </section>

    {academicProfiles.length > 0 && (
      <section class="block" aria-labelledby="profiles-heading">
        <h2 id="profiles-heading">Academic profiles</h2>

        <ul class="profile-list" role="list">
          {academicProfiles.map((item) => {
            const icon = resolveIcon(item.icon, item.key);

            return (
              <li>
                <a
                  class="profile-link"
                  href={item.url}
                  target="_blank"
                  rel="me noopener noreferrer"
                >
                  {icon && <Icon name={icon} class="profile-icon" aria-hidden="true" />}
                  <span>{item.name}</span>
                  <span class="sr-only"> (opens in a new tab)</span>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    )}
  </div>
</Layout>

<style>
  .profile-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .profile-link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 44px;
    padding: 0.5rem 0.95rem;
    border: 1px solid var(--bd);
    border-radius: var(--radius);
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--mb);
    text-decoration: none;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }

  .profile-link:hover,
  .profile-link:focus-visible {
    border-color: var(--bm);
    background: var(--lift);
    color: var(--w);
  }

  .profile-icon {
    display: block;
    width: 1.1rem;
    height: 1.1rem;
    fill: currentColor;
  }
</style>