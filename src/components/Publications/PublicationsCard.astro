---
interface Props {
  item?: Record<string, unknown>;
  index?: number;
  bibText?: string;
}

const { item = {}, index, bibText = "" } = Astro.props;

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
const clean = (value: unknown) => (value == null ? "" : String(value).trim());

const normalizeAuthors = (authors: unknown) => {
  if (!Array.isArray(authors)) return "";
  return authors
    .map((author) => {
      if (!author || typeof author !== "object") return "";
      const data = author as Record<string, unknown>;
      return [clean(data.given), clean(data.family)].filter(Boolean).join(" ");
    })
    .filter(Boolean)
    .join(", ");
};

const normalizeYear = (entry: Record<string, unknown>) =>
  (entry.issued as { ["date-parts"]?: unknown[][] } | undefined)?.["date-parts"]?.[0]?.[0] ||
  entry.year ||
  "";

const normalizeTitle = (entry: Record<string, unknown>) =>
  Array.isArray(entry.title) ? entry.title.map(String).join(" ") : clean(entry.title) || "Untitled";

const normalizeContainer = (entry: Record<string, unknown>) =>
  clean(entry["container-title"]) || clean(entry.journal) || clean(entry.booktitle) || clean(entry.publisher);

const TYPE_LABELS: Record<string, string> = {
  "article-journal": "Journal article",
  "paper-conference": "Conference paper",
  report: "Report",
  webpage: "Web page",
  thesis: "Thesis",
};
const normalizeType = (entry: Record<string, unknown>) =>
  TYPE_LABELS[clean(entry.type)] || clean(entry.type) || "Publication";

const normalizeKeywords = (entry: Record<string, unknown>) => {
  const raw = entry.keyword ?? entry.keywords ?? "";
  if (Array.isArray(raw)) return raw.map(String).map(clean).filter(Boolean);
  if (typeof raw === "string") return raw.split(/[;,]/).map(clean).filter(Boolean);
  return [];
};

const excerptWords = (text: string, count = 40) => {
  const words = text.trim().split(/\s+/).filter(Boolean);
  if (words.length <= count) return { text, more: false };
  return { text: `${words.slice(0, count).join(" ")}…`, more: true };
};

const pdfUrlFromItem = (entry: Record<string, unknown>) => {
  const file = entry.file;
  if (!file) return "";
  const raw = Array.isArray(file) ? String(file[0] ?? "") : String(file);
  const match = raw.match(/^[^:]+:([^:]+):application\/pdf$/i);
  return match ? `/${match[1]}` : "";
};

// Pull a single entry out of the full .bib by its citation key (brace-balanced).
// Falls back to the whole file if the key can't be found.
const bibEntryFor = (key: string, text: string) => {
  if (!key || !text) return text;
  const escaped = key.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  const start = new RegExp(`@\\w+\\s*\\{\\s*${escaped}\\s*,`, "i").exec(text);
  if (!start) return text;
  let depth = 0;
  for (let i = start.index; i < text.length; i++) {
    if (text[i] === "{") depth++;
    else if (text[i] === "}" && --depth === 0) return `${text.slice(start.index, i + 1)}\n`;
  }
  return text.slice(start.index);
};

// ---------------------------------------------------------------------------
// Derived values
// ---------------------------------------------------------------------------
const number = index ? String(index).padStart(2, "0") : "";
const title = normalizeTitle(item);
const authors = normalizeAuthors(item.author);
const year = normalizeYear(item);
const publication = normalizeContainer(item);
const type = normalizeType(item);
const abstract = clean(item.abstract);
const preview = excerptWords(abstract, 40);
const url = clean(item.URL) || clean(item.url);
const doi = clean(item.DOI) || clean(item.doi);
const doiUrl = doi ? `https://doi.org/${doi}` : "";
const titleUrl = doiUrl || url;
const pdf = pdfUrlFromItem(item);
const keywords = normalizeKeywords(item);

const citeKey = clean(item.id) || clean(item["citation-key"]);
const bibtexHref = `data:text/x-bibtex;charset=utf-8,${encodeURIComponent(bibEntryFor(citeKey, bibText))}`;
const bibtexName = `${citeKey || "publications"}.bib`;
---

<article class="pub pub-card">
  {number && <p class="pub-num" aria-hidden="true">{number}</p>}

  <div class="pub-main">
    <header class="pub-head">
      <h2 class="pub-title">
        {titleUrl ? (
          <a href={titleUrl} target="_blank" rel="noopener noreferrer">
            {title}<span class="sr-only"> (opens in a new tab)</span>
          </a>
        ) : (
          title
        )}
      </h2>
      {year && <p class="pub-year">{year}</p>}
    </header>

    <div class="meta-row">
      {publication && <span class="client-badge">{publication}</span>}
      <span class="meta-pill">{type}</span>
    </div>

    {authors && <p class="pub-authors">{authors}</p>}

    {preview.text && (
      preview.more ? (
        <details class="pub-abstract">
          <summary>
            <span class="pub-abstract-preview">{preview.text}</span>
            <span class="pub-abstract-toggle">Read full abstract</span>
          </summary>
          <p>{abstract}</p>
        </details>
      ) : (
        <p class="pub-abstract-text">{preview.text}</p>
      )
    )}

    {keywords.length > 0 && (
      <ul class="pt pub-keywords" aria-label="Keywords">
        {keywords.map((keyword) => <li class="tag">{keyword}</li>)}
      </ul>
    )}

    <div class="pub-actions">
      <a href={bibtexHref} download={bibtexName}>BibTeX</a>
      {doiUrl && (
        <a href={doiUrl} target="_blank" rel="noopener noreferrer">
          DOI<span class="sr-only"> (opens in a new tab)</span>
        </a>
      )}
      {pdf && (
        <a href={pdf} target="_blank" rel="noopener noreferrer">
          Download PDF<span class="sr-only"> (opens in a new tab)</span>
        </a>
      )}
      {url && (
        <a class="is-primary" href={url} target="_blank" rel="noopener noreferrer">
          View<span class="sr-only"> (opens in a new tab)</span>
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .pub-card {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1.25rem;
    padding: 1.5rem;
    background: var(--card);
    border: 1px solid var(--bd);
    border-radius: var(--radius);
  }

  .pub-num {
    padding-top: 0.3rem;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--teal);
  }

  .pub-main { display: grid; gap: 0.85rem; min-width: 0; }

  .pub-head { display: grid; gap: 0.3rem; }
  .pub-title {
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }
  .pub-title a { color: var(--w); text-decoration: none; }
  .pub-title a:hover,
  .pub-title a:focus-visible { color: var(--teal); text-decoration: underline; text-underline-offset: 3px; }
  .pub-year { font-family: var(--font-display); font-size: 0.8125rem; color: var(--mb); }

  .pub-card .meta-row { margin-bottom: 0; }
  .pub-authors { font-size: 0.875rem; line-height: 1.6; color: var(--mb); }

  .pub-abstract-text,
  .pub-abstract { max-width: 70ch; font-size: 0.9rem; line-height: 1.7; color: var(--mb); }
  .pub-abstract summary { cursor: pointer; list-style: none; }
  .pub-abstract summary::-webkit-details-marker { display: none; }
  .pub-abstract-toggle {
    display: inline-block;
    margin-left: 0.4rem;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--teal);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .pub-abstract[open] .pub-abstract-preview { display: none; }
  .pub-abstract[open] .pub-abstract-toggle { display: none; }
  .pub-abstract[open] p { margin: 0; }

  .pub-keywords { margin-top: 0; list-style: none; }

  .pub-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; padding-top: 0.25rem; }
  .pub-actions a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0.4rem 1rem;
    border: 1px solid var(--bm);
    border-radius: 3px;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--w);
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s, background 0.2s;
  }
  .pub-actions a:hover,
  .pub-actions a:focus-visible { border-color: var(--teal); color: var(--teal); }
  .pub-actions a.is-primary { background: var(--teal); border-color: var(--teal); color: var(--ink); }
  .pub-actions a.is-primary:hover,
  .pub-actions a.is-primary:focus-visible { opacity: 0.88; color: var(--ink); }

  @media (max-width: 600px) {
    .pub-card { grid-template-columns: 1fr; gap: 0.5rem; padding: 1.25rem; }
    .pub-num { padding-top: 0; }
  }
</style>