---
// src/components/PodcastSidebar.astro
import EntrySidebar from "./Sidebar/EntrySidebar.astro";
import { compact, entryLink } from "../lib/sidebar";
import { categoryHref } from "../lib/routes";

export interface Props {
  podcastTitle?: string;
  podcastDescription?: string;
  podcastWebsite?: string;
  podcastFeedUrl?: string;
  podcastPublisher?: string;
  podcastLanguage?: string;
  podcastCoverImage?: string;
  podcastCategories?: string[];
  podcastApplePodcasts?: string;
  podcastSpotify?: string;
  podcastYouTube?: string;
  transcriptUrl?: string;
  shareUrl?: string;
  audioUrl?: string;
  relatedEpisodes?: any[];
  relatedPodcasts?: any[];
}

const {
  podcastTitle,
  podcastDescription,
  podcastWebsite,
  podcastFeedUrl,
  podcastCoverImage,
  podcastCategories = [],
  podcastApplePodcasts,
  podcastSpotify,
  podcastYouTube,
  transcriptUrl,
  shareUrl,
  audioUrl,
  relatedEpisodes = [],
  relatedPodcasts = [],
} = Astro.props as Props;

const external = (label: string, href?: string) => (href ? [{ label, href, external: true }] : []);

const sections = compact([
  {
    title: "Podcast info",
    text: podcastDescription,
    image: podcastCoverImage
      ? { src: podcastCoverImage, alt: podcastTitle || "Podcast cover image", width: 200, height: 200 }
      : undefined,
  },
  {
    title: "Categories",
    variant: "chips",
    items: (Array.isArray(podcastCategories) ? podcastCategories : []).map((c) => ({ label: c, href: categoryHref(c) })),
  },
  {
    title: "Podcast links",
    variant: "links",
    items: [
      ...external("Website", podcastWebsite),
      ...external("RSS feed", podcastFeedUrl),
      ...external("Apple Podcasts", podcastApplePodcasts),
      ...external("Spotify", podcastSpotify),
      ...external("YouTube", podcastYouTube),
    ],
  },
  {
    title: "Episode links",
    variant: "links",
    items: [...external("Listen", shareUrl), ...external("Audio", audioUrl), ...external("Transcript", transcriptUrl)],
  },
  { title: "Related episodes", items: relatedEpisodes.map((i) => entryLink(i, "podcast", "Episode")) },
  { title: "Related podcasts", items: relatedPodcasts.map((i) => entryLink(i, "podcast", "Podcast")) },
]);
---

<!-- PodcastLayout already wraps this in an <aside>, so render a div (no nested landmark) -->
<EntrySidebar sections={sections} as="div" />
