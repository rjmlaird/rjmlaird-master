---
// src/components/ProjectSidebar.astro
// Sidebar for projects, initiatives, case studies and events. Same props as
// before; it only maps them to sections for EntrySidebar.
import EntrySidebar from "./Sidebar/EntrySidebar.astro";
import {
  compact,
  plain,
  sectorLinks,
  entryLink,
  cvLink,
  videoLink,
  organisationLink,
  outboundLinks,
  formatLabel,
} from "../lib/sidebar";

export interface Props {
  sectors?: string[];
  tools?: string[];
  features?: string[];
  relatedExperience?: any[];
  relatedEducation?: any[];
  relatedOrganisations?: any[];
  relatedVolunteering?: any[];
  relatedAwards?: any[];
  relatedCaseStudies?: any[];
  relatedProjects?: any[];
  relatedInitiatives?: any[];
  /** Legacy string/object videos (ids or simple objects) */
  relatedVideos?: any[];
  relatedEvents?: any[];
  relatedVideosRich?: any[];
  relatedArticles?: any[];
  links?: Record<string, string | undefined>;

  // Event-specific
  organiser?: string | any[];
  coOrganisers?: any[];
  speakers?: string[];
  hosts?: string[];
  location?: {
    name?: string;
    address?: string;
    city?: string;
    region?: string;
    country?: string;
    postalCode?: string;
    online?: boolean;
    onlineUrl?: string;
  };
  format?: "in-person" | "online" | "hybrid" | string;
}

const {
  sectors = [],
  tools = [],
  features = [],
  relatedExperience = [],
  relatedEducation = [],
  relatedOrganisations = [],
  relatedVolunteering = [],
  relatedAwards = [],
  relatedCaseStudies = [],
  relatedProjects = [],
  relatedInitiatives = [],
  relatedVideos = [],
  relatedVideosRich = [],
  relatedEvents = [],
  relatedArticles = [],
  links = {},
  organiser,
  coOrganisers = [],
  speakers = [],
  hosts = [],
  location,
  format,
} = Astro.props as Props;

const organisers = organiser ? (Array.isArray(organiser) ? organiser : [organiser]) : [];

const locationLines = location
  ? [
      ...[location.name, location.address, location.city, location.region, location.country, location.postalCode]
        .filter(Boolean)
        .map((label) => ({ label: label as string })),
      ...(location.online && location.onlineUrl
        ? [{ label: "Online event", href: location.onlineUrl, external: true }]
        : []),
    ]
  : [];

const sections = compact([
  {
    title: "Event details",
    groups: [
      { title: "Organiser", items: organisers.map((o) => organisationLink(o, "Organisation")) },
      { title: "Co-organisers", items: coOrganisers.map((o) => organisationLink(o, "Co-organiser")) },
      { title: "Speakers", items: plain(speakers) },
      { title: "Hosts", items: plain(hosts) },
      { title: "Format", items: format ? [{ label: formatLabel(format) }] : [] },
    ].filter((g) => g.items.length),
  },
  { title: "Location", variant: "lines", items: locationLines },
  { title: "Sectors", variant: "chips", items: sectorLinks(sectors) },
  { title: "Tools", variant: "chips", items: plain(tools) },
  { title: "Features", items: plain(features) },
  { title: "Related experience", items: relatedExperience.map((i) => cvLink(i, ["title", "role"], "Experience", true)) },
  { title: "Related education", items: relatedEducation.map((i) => cvLink(i, ["title", "school"], "Education")) },
  { title: "Related volunteering", items: relatedVolunteering.map((i) => cvLink(i, ["title", "role"], "Volunteering")) },
  { title: "Related organisations", items: relatedOrganisations.map((i) => cvLink(i, ["title"], "Organisation")) },
  { title: "Related awards", items: relatedAwards.map((i) => cvLink(i, ["title"], "Award")) },
  { title: "Related case studies", items: relatedCaseStudies.map((i) => entryLink(i, "caseStudy", "Case study")) },
  { title: "Related projects", items: relatedProjects.map((i) => entryLink(i, "project", "Project")) },
  { title: "Related initiatives", items: relatedInitiatives.map((i) => entryLink(i, "initiative", "Initiative")) },
  { title: "Related events", items: relatedEvents.map((i) => entryLink(i, "event", "Event")) },
  { title: "Related videos", items: [...relatedVideos, ...relatedVideosRich].map(videoLink) },
  {
    title: "Related articles",
    items: relatedArticles.map((a) => ({
      label: a?.title ?? "Article",
      href: a?.url,
      external: Boolean(a?.url),
    })),
  },
  { title: "Links", variant: "links", items: outboundLinks(links) },
]);
---

<EntrySidebar sections={sections} label="Project sidebar" />
