---
/**
 * Page-level FAQ block: heading, optional intro, the list, optional CTA.
 * Renders nothing if no FAQ matches, so you never ship an empty heading.
 *
 * <FaqSection page="speaking" limit={6} />
 */
import FaqList from './FaqList.astro';
import { buildFaqJsonLd, getFaqs, limitFaqs, type FaqEntry, type FaqFilter } from '../../lib/faqs';

export interface Props {
  /** Page id to pull FAQs for. Also the id that owns JSON-LD. Usually the page path. */
  page?: string;
  /** Extra filter criteria (topic, audience, tags). */
  filter?: Omit<FaqFilter, 'page'>;
  /** Pre-selected entries instead of page/filter. */
  entries?: FaqEntry[];
  /** Default "Frequently asked questions". */
  title?: string;
  /** Level of the section heading; questions sit one level below. Default 2. */
  headingLevel?: 2 | 3 | 4;
  /** Short plain-text intro. For rich markup use the default slot instead. */
  intro?: string;
  /** Cap on questions shown; a "View all" link appears when something is hidden. */
  limit?: number;
  collapsible?: boolean;
  /** Section-level CTA, shown after the list. */
  cta?: { label: string; href: string; text?: string };
  /** Emit FAQPage JSON-LD for opted-in entries. Once per page. Default false. */
  schema?: boolean;
  showViewAll?: boolean | 'auto';
  viewAllHref?: string;
  /** id for the section heading (and aria-labelledby). Default "faq". */
  id?: string;
}

const {
  page,
  filter,
  entries,
  title = 'Frequently asked questions',
  headingLevel = 2,
  intro,
  limit,
  collapsible = false,
  cta,
  schema = false,
  showViewAll = 'auto',
  viewAllHref,
  id = 'faq',
} = Astro.props;

const all = entries ?? (await getFaqs({ ...filter, ...(page ? { page } : {}) }));
const shown = limitFaqs(all, limit);
const jsonLd = schema && page ? await buildFaqJsonLd(shown, page) : null;
const Heading = `h${headingLevel}` as 'h2';
const listLevel = Math.min(headingLevel + 1, 5) as 3 | 4 | 5;
const hasSlot = Astro.slots.has('default');
---

{
  all.length > 0 && (
    <section class="faq-section" aria-labelledby={`${id}-title`}>
      <Heading id={`${id}-title`} class="faq-section__title">{title}</Heading>
      {intro && <p class="faq-section__intro">{intro}</p>}
      {hasSlot && <div class="faq-section__intro"><slot /></div>}
      <FaqList
        entries={all}
        limit={limit}
        headingLevel={listLevel}
        collapsible={collapsible}
        showViewAll={showViewAll}
        viewAllHref={viewAllHref}
      />
      {cta && (
        <div class="faq-section__cta">
          {cta.text && <p>{cta.text}</p>}
          <p><a class="faq-section__button" href={cta.href}>{cta.label}</a></p>
        </div>
      )}
      {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    </section>
  )
}

<style>
  .faq-section { margin-block: 3rem; --faq-focus: var(--focus); }
  .faq-section__title { margin: 0 0 0.5rem; font-size: 1.75rem; line-height: 1.2; }
  .faq-section__intro { margin: 0 0 1rem; max-inline-size: 70ch; }
  .faq-section__cta { margin-block-start: 1.5rem; padding: 1rem; border: 1px solid color-mix(in srgb, currentColor 25%, transparent); border-radius: 0.5rem; }
  .faq-section__cta p { margin: 0 0 0.5rem; }
  .faq-section__cta p:last-child { margin: 0; }
  .faq-section__button {
    display: inline-block;
    min-block-size: 2.75rem;
    padding: 0.6rem 1rem;
    box-sizing: border-box;
    border: 2px solid currentColor;
    border-radius: 0.375rem;
    font-weight: 600;
    color: inherit;
    text-decoration: none;
  }
  .faq-section__button:hover { text-decoration: underline; }
  .faq-section__button:focus-visible {
    outline: 3px solid var(--faq-focus);
    outline-offset: 2px;
    box-shadow: 0 0 0 2px Canvas;
  }
</style>
