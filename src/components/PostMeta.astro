---
// src/components/PostMeta.astro
import EntryMeta from "./EntryMeta.astro";

interface Props {
  author: { name: string; role: string; avatar: any };
  pubDate: Date;
  updatedDate?: Date;
  readingTime: string;
  category?: string;
  tags?: string[];
}

const { author, pubDate, updatedDate, readingTime, category = "", tags = [] } = Astro.props;
---

<EntryMeta
  author={author}
  dates={[
    { label: "Published", value: pubDate },
    { label: "Updated", value: updatedDate },
  ]}
  note={readingTime}
  categories={category ? [category] : []}
  tags={tags}
/>
