---
import socials from "../data/socials.json";
import { Icon } from "astro-icon/components";

interface SocialItem {
  key?: string;
  url: string;
  label?: string;
  name?: string;
  icon?: string;
  color?: string;
}

interface Props {
  types?: string[]; // optional: ["writing", "academic"]
}

const { types } = Astro.props;

// Keys that need a different icon from the one in the JSON.
// Web of Science has no icon in any Iconify set; Clarivate is its parent brand.
const ICON_OVERRIDES: Record<string, string> = {
  webofscience: "simple-icons:clarivate",
};

// Hidden for now: duplicate of X, and a Discord entry with a placeholder ID
const HIDDEN = new Set(["twitter", "discord"]);

const iconName = (item: SocialItem) =>
  (item.key && ICON_OVERRIDES[item.key]) ??
  (item.icon ? `simple-icons:${item.icon}` : undefined);

const safeSocials = (Array.isArray(socials) ? (socials as (SocialItem & { type?: string })[]) : [])
  .filter((item) => !item.key || !HIDDEN.has(item.key))
  .filter((item) => !types || (item.type && types.includes(item.type)));
---

<section class="socials">
  <ul class="socials__list" role="list">
    {safeSocials.map((item) => {
      const name = iconName(item);
      const label = item.label || item.name || "Social link";

      return (
        <li class="socials__item">
          <a
            class={`socials__link ${item.key ? `socials__link--${item.key}` : ""}`}
            href={item.url}
            aria-label={`${label} (opens in a new tab)`}
            target="_blank"
            rel="me noreferrer noopener"
            title={item.name || ""}
            style={item.color ? `--brand: ${item.color}` : undefined}
          >
            <span class="socials__icon" aria-hidden="true">
              {name && <Icon name={name} class="socials__svg" />}
            </span>
          </a>
        </li>
      );
    })}
  </ul>
</section>

<style>
  .socials__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .socials__item {
    display: inline-flex;
    margin: 0 0.5rem 0.5rem 0;
  }

  .socials__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    color: var(--mb);
    text-decoration: none;
    line-height: 0;
    transition: color 0.2s;
  }

  .socials__link:hover,
  .socials__link:focus-visible {
    color: var(--w);
  }

  .socials__icon {
    display: inline-flex;
    color: currentColor;
  }

  .socials__svg {
    width: 1.1rem;
    height: 1.1rem;
    display: block;
    fill: currentColor;
  }
</style>