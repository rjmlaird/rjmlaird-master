---
// src/components/VideoSidebar.astro
import TagList from './TagList.astro';

interface Props {
  title?: string;
  description?: string;
  client?: string;
  organisation?: string;
  publishedDate?: Date;
  duration?: string;
  videoUrl?: string;
  youtubeId?: string;
  heroImage?: string;
  credits?: string;
  tags?: string[];
  sectors?: any[];
  tools?: any[];
  features?: any[];
  relatedExperience?: any[];
  relatedEducation?: any[];
  relatedOrganisations?: any[];
  relatedVolunteering?: any[];
  relatedAwards?: any[];
  relatedProjects?: any[];
  relatedEvents?: any[];
  relatedVideos?: any[];
  links?: Record<string, any>;
}

const {
  title = '',
  description,
  client,
  organisation,
  publishedDate,
  duration,
  videoUrl,
  youtubeId,
  heroImage,
  credits,
  tags = [],
  sectors = [],
  tools = [],
  features = [],
  relatedExperience = [],
  relatedEducation = [],
  relatedOrganisations = [],
  relatedVolunteering = [],
  relatedAwards = [],
  relatedProjects = [],
  relatedEvents = [],
  relatedVideos = [],
  links = {},
} = Astro.props;

const formatDate = (date?: Date) => {
  if (!date) return '';
  return new Intl.DateTimeFormat('en-GB', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);
};

const watchUrl = videoUrl || (youtubeId ? `https://www.youtube.com/watch?v=${youtubeId}` : undefined);
---

<div class="video-sidebar">
  {heroImage && (
    <div class="sidebar-thumbnail">
      <img src={heroImage} alt={title} loading="lazy" />
    </div>
  )}

  <div class="sidebar-section">
    <h3>About This Video</h3>
    {description && <p class="sidebar-description">{description}</p>}
  </div>

  <div class="sidebar-section sidebar-metadata">
    <h3>Details</h3>
    <ul>
      {organisation && (
        <li>
          <span class="label">Organisation:</span>
          <span class="value">{organisation}</span>
        </li>
      )}
      {client && (
        <li>
          <span class="label">Client:</span>
          <span class="value">{client}</span>
        </li>
      )}
      {publishedDate && (
        <li>
          <span class="label">Published:</span>
          <span class="value"><time datetime={publishedDate.toISOString()}>{formatDate(publishedDate)}</time></span>
        </li>
      )}
      {duration && (
        <li>
          <span class="label">Duration:</span>
          <span class="value">{duration}</span>
        </li>
      )}
    </ul>
  </div>

  {watchUrl && (
    <div class="sidebar-section sidebar-actions">
      <a href={watchUrl} target="_blank" rel="noopener noreferrer" class="button-primary">
        Watch on YouTube
      </a>
    </div>
  )}

  {credits && (
    <div class="sidebar-section">
      <h3>Credits</h3>
      <p class="sidebar-credits">{credits}</p>
    </div>
  )}

  {sectors.length > 0 && (
    <div class="sidebar-section">
      <h3>Sectors</h3>
      <ul>
        {sectors.map((sector) => (
          <li>{typeof sector === 'string' ? sector : sector.name}</li>
        ))}
      </ul>
    </div>
  )}

  {tools.length > 0 && (
    <div class="sidebar-section">
      <h3>Tools & Tech</h3>
      <ul>
        {tools.map((tool) => (
          <li>{typeof tool === 'string' ? tool : tool.name}</li>
        ))}
      </ul>
    </div>
  )}

  {features.length > 0 && (
    <div class="sidebar-section">
      <h3>Features</h3>
      <ul>
        {features.map((feature) => (
          <li>{typeof feature === 'string' ? feature : feature.name}</li>
        ))}
      </ul>
    </div>
  )}

  {relatedExperience.length > 0 && (
    <div class="sidebar-section">
      <h3>Experience</h3>
      <ul>
        {relatedExperience.map((item) => (
          <li><a href={`/experience/${item.id || item.slug}`}>{item.title || item.name}</a></li>
        ))}
      </ul>
    </div>
  )}

  {relatedEducation.length > 0 && (
    <div class="sidebar-section">
      <h3>Education</h3>
      <ul>
        {relatedEducation.map((item) => (
          <li><a href={`/education/${item.id || item.slug}`}>{item.title || item.institution}</a></li>
        ))}
      </ul>
    </div>
  )}

  {relatedOrganisations.length > 0 && (
    <div class="sidebar-section">
      <h3>Organisations</h3>
      <ul>
        {relatedOrganisations.map((item) => (
          <li>{item.name || item.title}</li>
        ))}
      </ul>
    </div>
  )}

  {relatedVolunteering.length > 0 && (
    <div class="sidebar-section">
      <h3>Volunteering</h3>
      <ul>
        {relatedVolunteering.map((item) => (
          <li>{item.role || item.title}</li>
        ))}
      </ul>
    </div>
  )}

  {relatedAwards.length > 0 && (
    <div class="sidebar-section">
      <h3>Awards</h3>
      <ul>
        {relatedAwards.map((item) => (
          <li>{item.title || item.name}</li>
        ))}
      </ul>
    </div>
  )}

  {relatedProjects.length > 0 && (
    <div class="sidebar-section">
      <h3>Projects</h3>
      <ul>
        {relatedProjects.map((item) => (
          <li><a href={`/projects/${item.id || item.slug}`}>{item.data?.title || item.id}</a></li>
        ))}
      </ul>
    </div>
  )}

  {relatedEvents.length > 0 && (
    <div class="sidebar-section">
      <h3>Events</h3>
      <ul>
        {relatedEvents.map((item) => (
          <li><a href={`/events/${item.id || item.slug}`}>{item.data?.title || item.id}</a></li>
        ))}
      </ul>
    </div>
  )}

  {relatedVideos.length > 0 && (
    <div class="sidebar-section">
      <h3>Related Videos</h3>
      <ul>
        {relatedVideos.map((item) => (
          <li><a href={`/videos/${item.slug || item.id}`}>{item.title || item.slug}</a></li>
        ))}
      </ul>
    </div>
  )}

  {links && Object.keys(links).length > 0 && (
    <div class="sidebar-section">
      <h3>Links</h3>
      <ul>
        {Object.entries(links).map(([key, url]) => (
          <li><a href={String(url)} target="_blank" rel="noopener noreferrer">{key}</a></li>
        ))}
      </ul>
    </div>
  )}

  {tags.length > 0 && (
    <div class="sidebar-section">
      <h3>Tags</h3>
      <TagList tags={tags} />
    </div>
  )}
</div>

<style>
  .video-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 1.25rem;
    background: var(--color-surface-subtle, rgba(0, 0, 0, 0.02));
    border: 1px solid var(--color-border-subtle, rgba(0, 0, 0, 0.08));
    border-radius: 0.5rem;
    font-size: 0.9rem;
  }

  .sidebar-thumbnail {
    width: 100%;
    border-radius: 0.375rem;
    overflow: hidden;
    aspect-ratio: 16 / 9;
  }

  .sidebar-thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sidebar-section {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .video-sidebar h3 {
    font-size: 1rem;
    font-weight: 600;
    margin: 0;
    color: var(--color-heading, inherit);
  }

  .sidebar-description,
  .sidebar-credits {
    margin: 0;
    color: var(--color-text-muted, inherit);
    line-height: 1.5;
  }

  .sidebar-metadata ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .sidebar-metadata li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px dashed var(--color-border-subtle, rgba(0, 0, 0, 0.06));
    padding-bottom: 0.375rem;
  }

  .sidebar-metadata li:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .sidebar-metadata .label {
    color: var(--color-text-subtle, #666);
    font-weight: 500;
  }

  .sidebar-metadata .value {
    font-weight: 500;
    text-align: right;
  }

  .sidebar-actions {
    margin-top: 0.25rem;
  }

  .button-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 0.625rem 1rem;
    background: var(--color-primary, #0f172a);
    color: var(--color-primary-text, #fff);
    border-radius: 0.375rem;
    text-decoration: none;
    font-weight: 500;
    transition: background-color 0.2s ease;
  }

  .button-primary:hover {
    background: var(--color-primary-hover, #1e293b);
  }
</style>