---
// src/components/VideoSidebar.astro
import EntrySidebar from "./Sidebar/EntrySidebar.astro";
import { compact, plain, sectorLinks, entryLink, cvLink, outboundLinks } from "../lib/sidebar";
import { tagHref } from "../lib/routes";
import { formatDate } from "../utils/date";
import { getYouTubeId, youTubeWatchUrl } from "../utils/youtube";

interface Props {
  title?: string;
  description?: string;
  client?: string;
  organisation?: string;
  publishedDate?: Date;
  duration?: string;
  videoUrl?: string;
  youtubeId?: string;
  heroImage?: string;
  credits?: string;
  tags?: string[];
  sectors?: any[];
  tools?: any[];
  features?: any[];
  relatedExperience?: any[];
  relatedEducation?: any[];
  relatedOrganisations?: any[];
  relatedVolunteering?: any[];
  relatedAwards?: any[];
  relatedProjects?: any[];
  relatedEvents?: any[];
  relatedVideos?: any[];
  links?: Record<string, any>;
}

const {
  title = "",
  description,
  client,
  organisation,
  publishedDate,
  duration,
  videoUrl,
  youtubeId,
  heroImage,
  credits,
  tags = [],
  sectors = [],
  tools = [],
  features = [],
  relatedExperience = [],
  relatedEducation = [],
  relatedOrganisations = [],
  relatedVolunteering = [],
  relatedAwards = [],
  relatedProjects = [],
  relatedEvents = [],
  relatedVideos = [],
  links = {},
} = Astro.props;

const id = getYouTubeId(youtubeId);
const watchUrl = videoUrl || (id ? youTubeWatchUrl(id) : undefined);

const details = [
  organisation && { label: `Organisation: ${organisation}` },
  client && { label: `Client: ${client}` },
  publishedDate && { label: `Published: ${formatDate(publishedDate)}` },
  duration && { label: `Duration: ${duration}` },
].filter(Boolean) as { label: string }[];

const sections = compact([
  {
    title: "About this video",
    text: description,
    image: heroImage ? { src: heroImage, alt: title } : undefined,
  },
  { title: "Details", items: details },
  { title: "Watch", variant: "links", items: watchUrl ? [{ label: "Watch on YouTube", href: watchUrl, external: true }] : [] },
  { title: "Credits", text: credits },
  { title: "Sectors", variant: "chips", items: sectorLinks(sectors) },
  { title: "Tools and tech", variant: "chips", items: plain(tools) },
  { title: "Features", items: plain(features) },
  { title: "Experience", items: relatedExperience.map((i) => cvLink(i, ["title", "role"], "Experience")) },
  { title: "Education", items: relatedEducation.map((i) => cvLink(i, ["title", "institution"], "Education")) },
  { title: "Organisations", items: relatedOrganisations.map((i) => cvLink(i, ["name", "title"], "Organisation")) },
  { title: "Volunteering", items: relatedVolunteering.map((i) => cvLink(i, ["role", "title"], "Volunteering")) },
  { title: "Awards", items: relatedAwards.map((i) => cvLink(i, ["title", "name"], "Award")) },
  { title: "Projects", items: relatedProjects.map((i) => entryLink(i, "project", "Project")) },
  { title: "Events", items: relatedEvents.map((i) => entryLink(i, "event", "Event")) },
  { title: "Related videos", items: relatedVideos.map((i) => entryLink(i, "video", "Video")) },
  { title: "Links", variant: "links", items: outboundLinks(links) },
  { title: "Tags", variant: "chips", items: tags.map((t) => ({ label: t, href: tagHref(t) })) },
]);
---

<!-- The layout/page already wraps this in an <aside>, so render a div -->
<EntrySidebar sections={sections} as="div" />
