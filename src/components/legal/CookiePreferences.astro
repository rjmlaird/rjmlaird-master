---
import Callout from "./Callout.astro";

interface Props {
  id?: string;
  title?: string;
  /** Button text. */
  label?: string;
}

const {
  id = "cookie-preferences",
  title = "Manage cookie preferences",
  label = "Manage cookie preferences",
} = Astro.props;
---

<Callout id={id} title={title}>
  <slot />
  <button type="button" class="button" data-open-cookie-preferences>{label}</button>
  <slot name="after" />
</Callout>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.75rem 1rem;
    margin-top: 1rem;
    border: 1px solid var(--teal);
    border-radius: 0;
    color: var(--w);
    background: transparent;
    cursor: pointer;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1;
  }

  .button:hover,
  .button:focus-visible {
    background: var(--teal);
  }

  .button:focus-visible {
    outline: 2px solid var(--w);
    outline-offset: 3px;
  }
</style>
