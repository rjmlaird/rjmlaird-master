---
import socials from "../data/socials.json";
import { Icon } from "astro-icon/components";
import { resolveIcon, HIDDEN_SOCIALS } from "../lib/icons";

type FooterLink = {
  label: string;
  href: string;
  external?: boolean;
};

type FooterGroup = {
  title: string;
  links: FooterLink[];
};

const footerYear = new Date().getFullYear();

const selectedSocials = socials.filter(
  (item) => item.type === "social" && !HIDDEN_SOCIALS.has(item.key),
);

const footerNavigation: FooterGroup[] = [
  {
    title: "Explore",
    links: [
      { label: "Portfolio", href: "/work/" },
      { label: "Research", href: "/research/" },
      { label: "Projects", href: "/work/projects/" },
      { label: "Insights", href: "/insights/" },
    ],
  },
  {
    title: "Services",
    links: [
      {
        label: "Strategic communication",
        href: "/services/strategic-communication/",
      },
      {
        label: "Digital strategy & systems",
        href: "/services/digital-strategy-systems/",
      },
      {
        label: "Teaching & mentoring",
        href: "/services/teaching-mentoring/",
      },
      {
        label: "Speaking & collaboration",
        href: "/services/speaking-collaboration/",
      },
    ],
  },
  {
    title: "Platforms",
    links: [
      { label: "Docs", href: "https://docs.rjmlaird.co.uk" },
      { label: "Tools", href: "https://tools.rjmlaird.co.uk" },
      { label: "Apps", href: "https://apps.rjmlaird.co.uk" },
      { label: "Labs", href: "https://labs.rjmlaird.co.uk" },
    ],
  },
  {
    title: "Work with me",
    links: [
      { label: "Contact", href: "/contact/" },
      {
        label: "Booking Portal",
        href: "https://booking.rjmlaird.co.uk",
      },
      {
        label: "Impact Orbit Co.",
        href: "https://impactorbit.co",
        external: true,
      },
      {
        label: "Space for Neurodiversity",
        href: "https://spaceforneurodiversity.org",
        external: true,
      },
    ],
  },
];
---

<footer class="footer">
  <div class="footer__top">
    <div class="footer__brand">
      <a class="logo" href="/" aria-label="RJMLaird, home page">
        RJM<span>Laird</span>
      </a>

      <p class="footer__copy">
        Astrophysicist, science communicator and digital strategist.
      </p>

      <ul class="socials__list" role="list" aria-label="Social profiles">
        {selectedSocials.map((item) => {
          const name = resolveIcon(item.icon, item.key);

          return (
            <li class="socials__item">
              <a
                class={`socials__link socials__link--${item.key}`}
                href={item.url}
                aria-label={`${item.label} (opens in a new tab)`}
                target="_blank"
                rel="me noopener noreferrer"
                title={item.name}
              >
                <span class="socials__icon" aria-hidden="true">
                  {name && <Icon name={name} class="socials__svg" />}
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>

    <nav class="footer__links" aria-label="Footer navigation">
      {footerNavigation.map((group) => {
        const groupId = `footer-${group.title.toLowerCase()}`;

        return (
          <section class="footer__group" aria-labelledby={groupId}>
            <h2 id={groupId} class="footer__heading">
              {group.title}
            </h2>

            <ul class="footer__list" role="list">
              {group.links.map((link) => (
                <li class="footer__item">
                  <a
                    class="footer__link"
                    href={link.href}
                    target={link.external ? "_blank" : undefined}
                    rel={link.external ? "noopener noreferrer" : undefined}
                  >
                    {link.label}
                    {link.external && (
                      <>
                        <span class="footer__external" aria-hidden="true">↗</span>
                        <span class="sr-only"> (opens in a new tab)</span>
                      </>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        );
      })}
    </nav>
  </div>

  <div class="footer__bottom">
    <p>© {footerYear} Ryan Laird. All rights reserved.</p>

    <nav class="footer__meta" aria-label="Legal information">
      <a href="/privacy/">Privacy policy</a>
      <a href="/terms-of-use/">Terms of use</a>
      <a href="/disclaimer/">Disclaimer</a>
      <a href="https://api.rjmlaird.co.uk">API</a>
    </nav>
  </div>
</footer>

<style>
  /* global.css styles the bare `footer` element as a flex row, so reset it */
  .footer {
    display: block;
    padding: 2rem var(--gutter);
    border-top: 1px solid var(--bd);
    background: var(--ink);
  }

  .footer__top {
    display: grid;
    grid-template-columns: minmax(14rem, 1.1fr) minmax(0, 1.9fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  .footer__brand {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
    min-width: 0;
  }

  .footer__copy {
    max-width: 32rem;
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.75;
    color: var(--m);
  }

  /* Socials */
  .socials__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .socials__item {
    display: inline-flex;
    margin: 0;
  }

  .socials__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--bd);
    border-radius: var(--radius);
    color: var(--mb);
    line-height: 0;
    text-decoration: none;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }

  .socials__link:hover,
  .socials__link:focus-visible {
    border-color: var(--bm);
    background: var(--lift);
    color: var(--w);
  }

  .socials__icon {
    display: inline-flex;
    color: currentColor;
  }

  .socials__svg {
    display: block;
    width: 1.1rem;
    height: 1.1rem;
    fill: currentColor;
  }

  /*
    global.css styles every bare `nav` as the sticky top bar,
    so reset it and make it a responsive navigation-group grid.
  */
  .footer__links {
    position: static;
    z-index: auto;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem clamp(1.25rem, 3vw, 3rem);
    align-items: start;
    align-content: start;
    min-height: 0;
    padding: 0;
    border: 0;
    background: none;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  .footer__group {
    display: grid;
    align-content: start;
    align-self: start;
    min-width: 0;
  }

  .footer__heading {
    margin: 0 0 0.85rem;
    color: var(--m);
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .footer__list {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__item {
    margin: 0;
  }

  /*
    Shared styling for the top navigation and bottom legal links.
    Both use the same size, colour, underline and interaction states.
  */
  .footer__links a,
  .footer__copy a,
  .footer__meta a {
    display: inline-block;
    padding-block: 0.15rem;
    color: var(--mb);
    font-family: var(--font-body);
    font-size: 0.8rem;
    line-height: 1.5;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s;
  }

  .footer__links a:hover,
  .footer__links a:focus-visible,
  .footer__copy a:hover,
  .footer__copy a:focus-visible,
  .footer__meta a:hover,
  .footer__meta a:focus-visible {
    color: var(--teal);
  }

  .footer__external {
    display: inline-block;
    margin-left: 0.2em;
    font-size: 0.8em;
    line-height: 1;
  }

  /* Bottom bar */
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--bd);
    font-size: 0.8rem;
    color: var(--m);
  }

  .footer__bottom p {
    margin: 0;
    font-size: inherit;
    color: inherit;
  }

  /*
    global.css styles every bare `nav` as the sticky top bar,
    so reset legal navigation as well.
  */
  .footer__meta {
    position: static;
    z-index: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    min-height: 0;
    padding: 0;
    border: 0;
    background: none;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  .footer a:focus-visible {
    outline: 2px solid var(--teal);
    outline-offset: 3px;
    border-radius: 0.15rem;
  }


  @media (max-width: 700px) {
    .footer {
      padding-block: 1.75rem;
    }

    .footer__top {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .footer__copy {
      max-width: 100%;
    }

    .footer__links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem 1.5rem;
    }

    .footer__bottom {
      flex-direction: column;
      align-items: flex-start;
      margin-top: 1.5rem;
    }
  }

  @media (max-width: 420px) {
    .footer__links {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .socials__link,
    .footer__links a,
    .footer__copy a,
    .footer__meta a {
      transition: none;
    }
  }
</style>
