---
import socials from "../data/socials.json";
import { Icon } from "astro-icon/components";
import { resolveIcon, HIDDEN_SOCIALS } from "../lib/icons";

const year = new Date().getFullYear();

const selectedSocials = socials.filter(
  (item) => item.type === "social" && !HIDDEN_SOCIALS.has(item.key),
);

const footerLinks = [
  { href: "/work-with-me/", label: "Work with me" },
  { href: "/cv/", label: "CV" },
  { href: "/open-source/", label: "Open source" },
  { href: "/press/", label: "Press" },
  { href: "/contact/", label: "Contact" },
];
---

<footer class="footer">
  <div class="footer__top">
    <div class="footer__brand">
      <a class="logo" href="/" aria-label="Home">RJM<span>Laird</span></a>

      <p class="footer__copy">
        Astrophysicist, science communicator and strategist. Founder and Director of
        <a href="https://greenorbit.space">Green Orbit Digital</a>.
      </p>

      <ul class="socials__list" role="list" aria-label="Social profiles">
        {selectedSocials.map((item) => {
          const name = resolveIcon(item.icon, item.key);

          return (
            <li class="socials__item">
              <a
                class={`socials__link socials__link--${item.key}`}
                href={item.url}
                aria-label={`${item.label} (opens in a new tab)`}
                target="_blank"
                rel="me noreferrer noopener"
                title={item.name}
              >
                <span class="socials__icon" aria-hidden="true">
                  {name && <Icon name={name} class="socials__svg" />}
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </div>

  <div class="footer__bottom">
    <p>© {year} Ryan J. M. Laird. All rights reserved.</p>

    <nav class="footer__links" aria-label="Footer">
      {footerLinks.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>
  </div>
</footer>

<style>
  /* global.css styles the bare `footer` element as a flex row, so reset it */
  .footer {
    display: block;
    padding: 2rem var(--gutter);
    border-top: 1px solid var(--bd);
    background: var(--ink);
  }

  .footer__top {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  .footer__brand {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
    min-width: 0;
  }

  .footer__copy {
    max-width: 32rem;
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.75;
    color: var(--m);
  }

  /* Socials */
  .socials__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .socials__item {
    display: inline-flex;
    margin: 0;
  }

  .socials__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--bd);
    border-radius: var(--radius);
    color: var(--mb);
    line-height: 0;
    text-decoration: none;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }

  .socials__link:hover,
  .socials__link:focus-visible {
    border-color: var(--bm);
    background: var(--lift);
    color: var(--w);
  }

  .socials__icon {
    display: inline-flex;
    color: currentColor;
  }

  .socials__svg {
    display: block;
    width: 1.1rem;
    height: 1.1rem;
    fill: currentColor;
  }

  /* Bottom bar */
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--bd);
    font-size: 0.8rem;
    color: var(--m);
  }

  .footer__bottom p {
    margin: 0;
    font-size: inherit;
    color: inherit;
  }

  /* global.css styles every bare `nav` as the sticky top bar; undo that here */
  .footer__links {
    position: static;
    z-index: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    min-height: 0;
    padding: 0;
    border: 0;
    background: none;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  .footer__links a,
  .footer__copy a {
    color: var(--mb);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s;
  }

  .footer__links a:hover,
  .footer__links a:focus-visible,
  .footer__copy a:hover,
  .footer__copy a:focus-visible {
    color: var(--teal);
  }

  @media (max-width: 700px) {
    .footer {
      padding-block: 1.75rem;
    }

    .footer__copy {
      max-width: 100%;
    }

    .footer__bottom {
      flex-direction: column;
      align-items: flex-start;
      margin-top: 1.5rem;
    }
  }
</style>