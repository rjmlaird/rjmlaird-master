---
// src/components/Projects/Filters.astro
// Filter bar for card indexes. Reads the data-* attributes emitted by ProjectCard.astro and the
// grid id "projectGrid". Search is always visible; everything else sits behind a "Filters" toggle
// so phones see the content first.
import type { CollectionEntry } from "astro:content";

type AnyEntry = CollectionEntry<"projects" | "initiatives" | "caseStudies" | "events">;

interface Props {
  items?: AnyEntry[];
  clientFields?: string[];
  /** Tags shown before the "Show all" toggle. */
  tagLimit?: number;
  /** Noun for the result count, e.g. "events". */
  noun?: string;
}

const {
  items = [],
  clientFields = ["client", "organisation", "institution", "organiser"],
  tagLimit = 12,
  noun = "items",
} = Astro.props as Props;

const flattenStrings = (val: unknown): string[] => {
  if (!val) return [];
  if (Array.isArray(val)) return val.filter(Boolean).map(String);
  return [String(val)];
};

const getClientLike = (data: Record<string, unknown>) => {
  if (!data) return "";
  for (const key of clientFields) {
    const val = data[key];
    if (typeof val === "string" && val.trim()) return val.trim();

    if (key === "organiser") {
      const first = Array.isArray(val) ? val.find(Boolean) : val;
      if (typeof first === "string" && first.trim()) return first.trim();
      if (first && typeof first === "object" && "name" in (first as object)) {
        const name = String((first as { name?: unknown }).name || "").trim();
        if (name) return name;
      }
    }
  }
  return "";
};

const dataOf = (p: AnyEntry) => (p.data as Record<string, unknown>) || {};
const uniqueSorted = (values: string[]) => Array.from(new Set(values.filter(Boolean))).sort();

const allClients = uniqueSorted(items.map((p) => getClientLike(dataOf(p))));

// Tags ranked by how many entries use them, so the visible handful are the useful ones.
const tagCounts = new Map<string, number>();
for (const p of items) {
  for (const t of new Set(flattenStrings(dataOf(p).tags))) tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
}
const rankedTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
const visibleTags = rankedTags.slice(0, tagLimit);
const extraTags = rankedTags.slice(tagLimit).sort((a, b) => a[0].localeCompare(b[0]));

const allCategories = uniqueSorted(
  items.flatMap((p) => [...flattenStrings(dataOf(p).category), ...flattenStrings(dataOf(p).sectors)]),
);
const allTypes = uniqueSorted(items.map((p) => String(dataOf(p).type || "").trim()));
const allStatuses = uniqueSorted(items.map((p) => String(dataOf(p).status || "").trim()));
const allFormats = uniqueSorted(items.map((p) => String(dataOf(p).format || "").trim()));

const years = Array.from(
  new Set(
    items
      .map((p) => {
        const d = dataOf(p).startDate;
        const t = d ? new Date(d as string | number | Date) : null;
        return t && !Number.isNaN(t.getTime()) ? String(t.getFullYear()) : "";
      })
      .filter(Boolean),
  ),
).sort((a, b) => Number(b) - Number(a));

---

<section class="filters" aria-label="Filter and search">
  <div class="filters__bar">
    <div class="filter-field filters__search">
      <label for="search">Search</label>
      <input id="search" type="search" placeholder="Search title or description" autocomplete="off" />
    </div>

    <button
      class="filters__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="filterPanel"
      id="filterToggle"
    >
      Filters <span class="filters__badge" id="filterBadge" hidden>0</span>
    </button>
  </div>

  <div class="filters__panel" id="filterPanel" hidden>
    <div class="filters__selects">
      {allClients.length > 1 && (
        <div class="filter-field">
          <label for="client">Client / organiser</label>
          <select id="client">
            <option value="">All</option>
            {allClients.map((c) => <option value={c}>{c}</option>)}
          </select>
        </div>
      )}

      {allTypes.length > 1 && (
        <div class="filter-field">
          <label for="type">Type</label>
          <select id="type">
            <option value="">All</option>
            {allTypes.map((t) => <option value={t}>{t}</option>)}
          </select>
        </div>
      )}

      {allStatuses.length > 1 && (
        <div class="filter-field">
          <label for="status">Status</label>
          <select id="status">
            <option value="">All</option>
            {allStatuses.map((s) => <option value={s}>{s}</option>)}
          </select>
        </div>
      )}

      {allFormats.length > 1 && (
        <div class="filter-field">
          <label for="format">Format</label>
          <select id="format">
            <option value="">All</option>
            {allFormats.map((f) => <option value={f}>{f}</option>)}
          </select>
        </div>
      )}

      {years.length > 1 && (
        <div class="filter-field">
          <label for="year">Year</label>
          <select id="year">
            <option value="">All</option>
            {years.map((y) => <option value={y}>{y}</option>)}
          </select>
        </div>
      )}
    </div>

    {rankedTags.length > 0 && (
      <fieldset class="filter-group">
        <legend>Tags</legend>
        <div class="checkbox-group" id="tagGroup">
          {visibleTags.map(([t, n]) => (
            <label class="chip">
              <input type="checkbox" class="tag-checkbox" value={t} />
              <span>{t} <small>{n}</small></span>
            </label>
          ))}
          {extraTags.map(([t, n]) => (
            <label class="chip chip--extra" hidden>
              <input type="checkbox" class="tag-checkbox" value={t} />
              <span>{t} <small>{n}</small></span>
            </label>
          ))}
        </div>
        {extraTags.length > 0 && (
          <button class="filters__more" id="tagMore" type="button" aria-expanded="false">
            Show all {rankedTags.length} tags
          </button>
        )}
      </fieldset>
    )}

    {allCategories.length > 0 && (
      <fieldset class="filter-group">
        <legend>Categories</legend>
        <div class="checkbox-group" id="categoryGroup">
          {allCategories.map((c) => (
            <label class="chip">
              <input type="checkbox" class="category-checkbox" value={c} />
              <span>{c}</span>
            </label>
          ))}
        </div>
      </fieldset>
    )}

    <div class="filters__dates">
      <div class="filter-field">
        <label for="fromDate">From</label>
        <input id="fromDate" type="date" />
      </div>
      <div class="filter-field">
        <label for="toDate">To</label>
        <input id="toDate" type="date" />
      </div>
      <button id="clearFilters" class="filters__clear" type="button">Clear all</button>
    </div>
  </div>

  <p class="filters__count" id="resultCount" role="status" aria-live="polite" data-noun={noun}></p>
  <p class="filters__empty" id="noResults" hidden>
    Nothing matches those filters. <button type="button" id="emptyClear">Clear filters</button>
  </p>

  <script is:inline>
    (() => {
      const grid = document.getElementById("projectGrid");
      if (!grid) return;

      const $ = (id) => document.getElementById(id);
      const searchInput = $("search");
      const selects = ["client", "type", "status", "format", "year"].map($).filter(Boolean);
      const fromDateInput = $("fromDate");
      const toDateInput = $("toDate");
      const tagBoxes = [...document.querySelectorAll(".tag-checkbox")];
      const catBoxes = [...document.querySelectorAll(".category-checkbox")];
      const countEl = $("resultCount");
      const emptyEl = $("noResults");
      const badge = $("filterBadge");
      const panel = $("filterPanel");
      const toggle = $("filterToggle");

      const checked = (boxes) => boxes.filter((b) => b.checked).map((b) => b.value);
      const dateMs = (v, end) => {
        if (!v) return null;
        const d = new Date(`${v}T${end ? "23:59:59" : "00:00:00"}`);
        return Number.isNaN(d.getTime()) ? null : d.getTime();
      };
      const val = (id) => ($(id) ? $(id).value : "");

      function apply() {
        const q = (searchInput?.value || "").toLowerCase().trim();
        const client = val("client"), type = val("type"), status = val("status");
        const format = val("format"), year = val("year");
        const from = dateMs(fromDateInput?.value, false);
        const to = dateMs(toDateInput?.value, true);
        const tags = checked(tagBoxes);
        const cats = checked(catBoxes);

        const cards = [...grid.children];
        let shown = 0;

        cards.forEach((card) => {
          const d = card.dataset;
          const hay = `${d.title || ""} ${d.description || ""}`.toLowerCase();
          const cardTags = (d.tags || "").split("|").filter(Boolean);
          const cardCats = (d.categories || "").split("|").filter(Boolean);
          const start = d.startDate ? new Date(d.startDate).getTime() : null;

          let ok = true;
          if (q && !hay.includes(q)) ok = false;
          if (client && d.client !== client) ok = false;
          if (type && d.type !== type) ok = false;
          if (status && d.status !== status) ok = false;
          if (format && d.format !== format) ok = false;
          if (year && d.year !== year) ok = false;
          if (tags.length && !tags.some((t) => cardTags.includes(t))) ok = false;
          if (cats.length && !cats.some((c) => cardCats.includes(c))) ok = false;
          // Undated entries are only excluded when a date range is set.
          if ((from !== null || to !== null) && start === null) ok = false;
          if (from !== null && start !== null && start < from) ok = false;
          if (to !== null && start !== null && start > to) ok = false;

          card.hidden = !ok;
          if (ok) shown += 1;
        });

        const total = cards.length;
        const noun = countEl.dataset.noun || "items";
        countEl.textContent = shown === total ? `${total} ${noun}` : `Showing ${shown} of ${total} ${noun}`;
        emptyEl.hidden = shown !== 0;

        const active =
          selects.filter((s) => s.value).length +
          tags.length + cats.length +
          (fromDateInput?.value ? 1 : 0) + (toDateInput?.value ? 1 : 0);
        badge.textContent = String(active);
        badge.hidden = active === 0;
      }

      function clearAll() {
        if (searchInput) searchInput.value = "";
        selects.forEach((s) => (s.value = ""));
        [fromDateInput, toDateInput].forEach((i) => i && (i.value = ""));
        [...tagBoxes, ...catBoxes].forEach((b) => (b.checked = false));
        apply();
      }

      toggle?.addEventListener("click", () => {
        const open = toggle.getAttribute("aria-expanded") === "true";
        toggle.setAttribute("aria-expanded", String(!open));
        panel.hidden = open;
      });

      $("tagMore")?.addEventListener("click", (e) => {
        const btn = e.currentTarget;
        const open = btn.getAttribute("aria-expanded") === "true";
        document.querySelectorAll(".chip--extra").forEach((c) => (c.hidden = open));
        btn.setAttribute("aria-expanded", String(!open));
        btn.textContent = open ? `Show all ${tagBoxes.length} tags` : "Show fewer tags";
      });

      [searchInput, ...selects, fromDateInput, toDateInput, ...tagBoxes, ...catBoxes].forEach((el) => {
        el?.addEventListener("input", apply);
        el?.addEventListener("change", apply);
      });
      $("clearFilters")?.addEventListener("click", clearAll);
      $("emptyClear")?.addEventListener("click", clearAll);

      apply();
    })();
  </script>
</section>

<style>
  .filters {
    display: grid;
    gap: 0.9rem;
    margin-bottom: 1.25rem;
  }

  .filters__bar {
    display: flex;
    align-items: flex-end;
    gap: 0.75rem;
  }

  .filters__search {
    flex: 1;
    min-width: 0;
  }

  .filter-field {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }

  .filter-field label,
  .filter-group legend {
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
  }

  .filter-field input,
  .filter-field select {
    width: 100%;
    min-height: 2.6rem;
    padding: 0.5rem 0.7rem;
    background: var(--card);
    color: var(--w);
    border: 1px solid var(--bm);
    border-radius: 6px;
    font-size: 0.9rem;
    color-scheme: dark;
  }

  .filter-field input:focus-visible,
  .filter-field select:focus-visible {
    outline-offset: 1px;
  }

  .filters__toggle,
  .filters__clear,
  .filters__more,
  .filters__empty button {
    min-height: 2.6rem;
    padding: 0.5rem 0.95rem;
    background: transparent;
    color: var(--w);
    border: 1px solid var(--bm);
    border-radius: 6px;
    font-size: 0.85rem;
    cursor: pointer;
  }

  .filters__toggle:hover,
  .filters__clear:hover,
  .filters__more:hover,
  .filters__empty button:hover {
    border-color: var(--teal);
  }

  .filters__toggle[aria-expanded="true"] {
    border-color: var(--teal);
    background: var(--td);
  }

  .filters__badge {
    display: inline-block;
    min-width: 1.25rem;
    margin-left: 0.3rem;
    padding: 0 0.35rem;
    border-radius: 999px;
    background: var(--teal);
    color: var(--ink);
    font-size: 0.72rem;
    font-weight: 700;
    text-align: center;
  }

  .filters__badge[hidden] {
    display: none;
  }

  .filters__panel {
    display: grid;
    gap: 1rem;
    padding: 1rem;
    background: var(--ink2);
    border: 1px solid var(--bd);
    border-radius: 8px;
  }

  .filters__panel[hidden] {
    display: none;
  }

  .filters__selects {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
    gap: 0.75rem;
  }

  .filter-group {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .filter-group legend {
    margin-bottom: 0.4rem;
    padding: 0;
  }

  .checkbox-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .chip {
    display: inline-flex;
    cursor: pointer;
    user-select: none;
  }

  .chip[hidden] {
    display: none;
  }

  .chip input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .chip span {
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--bm);
    border-radius: 999px;
    font-size: 0.8rem;
    color: var(--mb);
  }

  .chip small {
    opacity: 0.65;
  }

  .chip input:checked + span {
    background: var(--td);
    border-color: var(--teal);
    color: var(--w);
  }

  .chip input:focus-visible + span {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }

  .filters__more {
    margin-top: 0.6rem;
    min-height: 0;
    padding: 0.3rem 0.7rem;
    font-size: 0.8rem;
  }

  .filters__dates {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    align-items: end;
  }

  .filters__clear {
    grid-column: 1 / -1;
    justify-self: start;
  }

  .filters__count {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .filters__empty {
    margin: 0;
    padding: 1rem 1.25rem;
    border: 1px dashed var(--bm);
    border-radius: 8px;
    color: var(--mb);
  }

  .filters__empty[hidden] {
    display: none;
  }

  @media (min-width: 720px) {
    .filters__search {
      max-width: 28rem;
    }

    .filters__bar {
      justify-content: space-between;
    }

    .filters__dates {
      grid-template-columns: 12rem 12rem auto;
    }

    .filters__clear {
      grid-column: auto;
    }
  }
</style>
