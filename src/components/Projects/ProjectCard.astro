---
// src/components/ProjectCard.astro
import type { CollectionEntry } from "astro:content";
import CategoryBadge from "../CategoryBadge.astro";
import TagList from "../TagList.astro";
import Figure from "../Figure.astro";
import { cleanText } from "../../lib/content-quality.mjs";
import { entryHref, type EntryKind } from "../../lib/routes";
import { formatDate, formatDateRange, isoDate } from "../../utils/date";

interface Props {
  project?: CollectionEntry<"projects">;
  initiative?: CollectionEntry<"initiatives">;
  caseStudy?: CollectionEntry<"caseStudies">;
  event?: CollectionEntry<"events">;
  featured?: boolean;
}

const { project, initiative, caseStudy, event, featured = false } = Astro.props as Props;

const source = project ?? initiative ?? caseStudy ?? event;
const kind: EntryKind = project
  ? "project"
  : initiative
    ? "initiative"
    : caseStudy
      ? "caseStudy"
      : "event";

const data = source?.data;

const title = data?.title ?? "";
const description = cleanText(data?.description);
const excerpt = cleanText(data?.excerpt);
const tags = data?.tags ?? [];
const type = data?.type ?? "";
const status = data?.status ?? "";
const client = data?.client ?? "";
const organisation = data?.organisation ?? "";
const institution = data?.institution ?? "";

const startDate = data?.startDate;
const endDate = data?.endDate;

const heroImage = data?.heroImage ?? "";
const heroAlt = (data?.heroAlt ?? title) || "Hero image";

const safeTags = Array.isArray(tags) ? tags : [];
const primaryType = type || status || client || organisation || institution || "";

const dateText = kind === "event" ? formatDateRange(startDate, endDate) : formatDate(startDate, "short");

const href = entryHref(kind as EntryKind, source?.id ?? "");

/* ---- Filter hooks -------------------------------------------------------------------------
   Filters.astro reads these data-* attributes. They must stay in sync with its field list. */
const asStrings = (val: unknown): string[] =>
  Array.isArray(val) ? val.filter(Boolean).map(String) : val ? [String(val)] : [];

const organiserName = (val: unknown): string => {
  const first = Array.isArray(val) ? val[0] : val;
  if (!first) return "";
  if (typeof first === "string") return first.trim();
  if (typeof first === "object" && "name" in (first as object)) {
    return String((first as { name?: unknown }).name ?? "").trim();
  }
  return "";
};

const clientLike = (
  [client, organisation, institution].find((v) => typeof v === "string" && v.trim()) ||
  organiserName((data as Record<string, unknown>)?.organiser)
)
  .toString()
  .trim();

const raw = (data ?? {}) as Record<string, unknown>;
const categories = [...asStrings(raw.category), ...asStrings(raw.sectors)];
const format = typeof raw.format === "string" ? raw.format : "";
const startIso = isoDate(startDate);
const year = startIso ? startIso.slice(0, 4) : "";

/* Events: show where and how, which is what people scan for. */
const loc = raw.location as { name?: string; city?: string; online?: boolean } | undefined;
const place = kind === "event" ? (loc?.online ? "Online" : [loc?.city].filter(Boolean).join("")) || "" : "";
const placeText = [place, format && format !== "in-person" ? format : ""].filter(Boolean).join(" · ");
---

<article
  class:list={["project-card", { featured }]}
  data-title={title}
  data-description={description || excerpt}
  data-client={clientLike}
  data-tags={safeTags.join("|")}
  data-categories={categories.join("|")}
  data-type={type}
  data-status={status}
  data-format={format}
  data-start-date={startIso}
  data-year={year}
>
  {heroImage && (
    <a href={href} class="project-card-image-link" aria-label={title} tabindex="-1">
      <Figure src={heroImage} alt={heroAlt} />
    </a>
  )}

  <div class="body">
    {primaryType && <CategoryBadge category={primaryType} as="span" />}

    <h2>
      <a href={href} class="title-link">{title}</a>
    </h2>

    {(description || excerpt) && <p class="description">{description || excerpt}</p>}

    {safeTags.length > 0 && (
      <div class="meta-block">
        <TagList tags={safeTags} limit={3} />
      </div>
    )}

    {(dateText || placeText) && (
      <div class="footer">
        {dateText && <time datetime={startIso}>{dateText}</time>}
        {placeText && <span class="place">{placeText}</span>}
      </div>
    )}
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--card);
    color: inherit;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .project-card:hover,
  .project-card:focus-within {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .project-card-image-link {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--ink2);
  }

  /* Figure adds a 2rem margin for article bodies; inside a card it only creates dead space. */
  .project-card-image-link :global(.post-figure) {
    margin: 0;
    height: 100%;
  }

  .project-card-image-link :global(.post-figure img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
  }

  .body {
    flex: 1;
    padding: 1.1rem 1.2rem 1.3rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  h2 {
    margin: 0;
    font-size: 1.1rem;
    line-height: 1.3;
  }

  .featured h2 {
    font-size: 1.5rem;
  }

  /* Whole card is clickable via the title link. */
  .title-link {
    color: inherit;
    text-decoration: none;
  }

  .title-link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .project-card {
    position: relative;
  }

  .title-link:hover {
    color: var(--color-accent);
  }

  .description {
    margin: 0;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Sits above the stretched title link so tag links stay clickable. */
  .meta-block {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-top: 0.2rem;
  }

  .footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    margin-top: auto;
    padding-top: 0.4rem;
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  .place::before {
    content: "·";
    margin-right: 0.75rem;
  }

  .featured {
    grid-column: 1 / -1;
  }

  @media (min-width: 800px) {
    .featured {
      flex-direction: row;
    }

    .featured .project-card-image-link {
      width: 65%;
      aspect-ratio: auto;
    }

    .featured .body {
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card {
      transition: none;
    }

    .project-card:hover,
    .project-card:focus-within {
      transform: none;
    }
  }
</style>
