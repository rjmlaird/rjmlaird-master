---
// src/components/VideoMeta.astro
import EntryMeta from "./EntryMeta.astro";

interface Props {
  type?: string;
  status?: string;
  client?: string;
  organisation?: string;
  institution?: string;
  publishedDate?: Date;
  updatedDate?: Date;
  duration?: string;
  category?: string | string[];
  tags?: string[];
}

const {
  type,
  status,
  client,
  organisation,
  institution,
  publishedDate,
  updatedDate,
  duration = "",
  category = "",
  tags = [],
} = Astro.props as Props;

const items = [
  type && { label: "Type", value: type },
  status && { label: "Status", value: status },
  client && { label: "Client", value: client },
  organisation && { label: "Organisation", value: organisation },
  institution && { label: "Institution", value: institution },
].filter(Boolean) as { label: string; value: string }[];

const categories = Array.isArray(category) ? category : category ? [category] : [];
---

<EntryMeta
  items={items}
  itemsLabel="Video metadata"
  dates={[
    { label: "Published", value: publishedDate, time: true },
    { label: "Updated", value: updatedDate, time: true },
  ]}
  note={duration}
  categories={categories}
  tags={tags}
/>
