---
// src/components/Hero/Hero.astro
import OrbitGraphic from "./OrbitGraphic.astro";

interface Profile {
  name?: string;
  credentials?: string[];
  location?: string;
}

interface Props {
  profile?: Profile | null;
  title?: string;
  surname?: string;
  eyebrow?: string;
  headline?: string;
  description?: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  showGraphic?: boolean;
}

const {
  profile,
  title = "Ryan",
  surname = "Laird",
  eyebrow = "Astrophysicist · Science communicator · Strategist",
  headline = "Science, communication and digital strategy for complex ideas.",
  description = "I help organisations, teams and individuals make complex work clearer, more accurate and more useful through strategic communication, digital systems, teaching and collaboration.",
  primaryHref = "/services/",
  primaryLabel = "Explore services",
  secondaryHref = "/how-i-work/",
  secondaryLabel = "How I work",
  showGraphic = true,
} = Astro.props;

const credentials = profile?.credentials ?? [
  "MPhys",
  "CMktr",
  "MInstP",
  "MCIPR",
];

const location = profile?.location ?? "Based in Leicester. Working across the UK, Europe and online.";
---

<section class="hero" aria-labelledby="hero-title">
  {
    showGraphic && (
      <div class="hero__graphic" aria-hidden="true">
        <OrbitGraphic />
      </div>
    )
  }

  <div class="hero__main">
    <p class="hero__eyebrow">{eyebrow}</p>

    <h1 id="hero-title" class="hero__title">
      <span>{title}</span>
      <span class="hero__surname">{surname}</span>
    </h1>

    <p class="hero__headline">{headline}</p>

    <p class="hero__description">{description}</p>

    {
      credentials.length > 0 && (
        <ul class="hero__credentials" aria-label="Professional credentials">
          {
            credentials.map((credential) => (
              <li>{credential}</li>
            ))
          }
        </ul>
      )
    }

    <p class="hero__location">{location}</p>

    <div class="hero__actions">
      <a class="button button--primary" href={primaryHref}>
        {primaryLabel}
      </a>

      <a class="button button--secondary" href={secondaryHref}>
        {secondaryLabel}
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: min(44rem, calc(100svh - 5rem));
    align-items: end;
    padding: clamp(2rem, 5vw, 4.5rem) clamp(1.25rem, 5vw, 5rem)
      clamp(4.5rem, 9vw, 8rem);
    overflow: clip;
  }

  .hero__main {
    position: relative;
    z-index: 1;
    max-width: 53rem;
  }

  .hero__graphic {
    position: absolute;
    z-index: 0;
    top: 50%;
    right: clamp(-13rem, -8vw, -4rem);
    width: min(58vw, 50rem);
    min-width: 30rem;
    translate: 0 -50%;
    opacity: 0.75;
    pointer-events: none;
  }

  .hero__eyebrow {
    margin: 0;
    color: var(--teal);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .hero__title {
    display: grid;
    margin: 0.75rem 0 0;
    color: var(--w);
    font-family: var(--font-display);
    font-size: clamp(4rem, 9vw, 8.5rem);
    font-weight: 400;
    letter-spacing: -0.075em;
    line-height: 0.76;
  }

  .hero__surname {
    color: var(--teal);
  }

  .hero__headline {
    max-width: 44rem;
    margin: clamp(1.75rem, 4vw, 3rem) 0 0;
    color: var(--w);
    font-size: clamp(1.25rem, 2.25vw, 1.7rem);
    line-height: 1.45;
  }

  .hero__description {
    max-width: 40rem;
    margin: 1rem 0 0;
    color: var(--mb);
    font-size: 1rem;
    line-height: 1.75;
  }

  .hero__credentials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.85rem;
    padding: 0;
    margin: 1.5rem 0 0;
    list-style: none;
  }

  .hero__credentials li {
    color: var(--m);
    font-family: var(--font-mono, inherit);
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    line-height: 1.45;
  }

  .hero__credentials li:not(:last-child)::after {
    margin-left: 0.85rem;
    color: var(--teal);
    content: "·";
  }

  .hero__location {
    margin: 0.85rem 0 0;
    color: var(--m);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .button {
    display: inline-flex;
    min-height: 2.9rem;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.1rem;
    border: 1px solid transparent;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      color 0.2s ease,
      background 0.2s ease;
  }

  .button--primary {
    border-color: var(--teal);
    color: var(--bg);
    background: var(--teal);
  }

  .button--primary:hover,
  .button--primary:focus-visible {
    border-color: var(--w);
    color: var(--bg);
    background: var(--w);
  }

  .button--secondary {
    border-color: var(--bd);
    color: var(--w);
    background: transparent;
  }

  .button--secondary:hover,
  .button--secondary:focus-visible {
    border-color: var(--teal);
    color: var(--teal);
  }

  a:focus-visible {
    outline: 2px solid var(--teal);
    outline-offset: 4px;
  }

  @media (max-width: 760px) {
    .hero {
      min-height: auto;
      padding-top: 3rem;
    }

    .hero__graphic {
      top: 5rem;
      right: -16rem;
      width: 40rem;
      opacity: 0.3;
      translate: 0;
    }

    .hero__title {
      font-size: clamp(4rem, 19vw, 6.5rem);
      line-height: 0.8;
    }
  }

  @media (max-width: 460px) {
    .hero {
      padding-inline: 1.25rem;
      padding-bottom: 4.5rem;
    }

    .hero__title {
      font-size: clamp(3.65rem, 18vw, 5rem);
    }

    .hero__headline {
      font-size: 1.2rem;
    }

    .hero__actions {
      align-items: stretch;
      flex-direction: column;
    }

    .button {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .button {
      transition: none;
    }
  }
</style>
