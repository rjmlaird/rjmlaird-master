---
import JsonLd from './JsonLd.astro';
import { SchemaGraph } from '../../lib/schema/graph';
import { mapPublications } from '../../lib/schema/mappers';
import type { BibEntry } from '../../lib/schema/types';

interface Props {
  /** Raw BibTeX text (your publications.json is BibTeX) or parsed entries. */
  data: string | BibEntry[];
  includeAbstract?: boolean;
}
const { data, includeAbstract } = Astro.props;
const g = new SchemaGraph();
mapPublications(g, data, { includeAbstract });
---

<JsonLd data={g.toJSON()} />
