---
import JsonLd from './JsonLd.astro';
import { SchemaGraph } from '../../lib/schema/graph';
import { mapEducation } from '../../lib/schema/mappers';
import { unwrap } from '../../lib/schema/helpers';
import type { EducationItem, MaybeWrapped, Organisation } from '../../lib/schema/types';

interface Props {
  /** Array, or the wrapper object { education: [...] }. */
  data: MaybeWrapped<EducationItem, 'education'>;
  /** Optional override, e.g. fetched from your API. Defaults to src/data/organisations.json. */
  organisations?: Organisation[];
}
const { data, organisations } = Astro.props;
const g = new SchemaGraph(organisations);
mapEducation(g, unwrap(data, 'education'));
---

<JsonLd data={g.toJSON()} />
