---
// src/components/ProjectMeta.astro
import EntryMeta from "./EntryMeta.astro";

interface Props {
  type?: string;
  status?: string;
  client?: string;
  organisation?: string;
  institution?: string;
  startDate?: Date;
  endDate?: Date;
  updatedDate?: Date;
  readingTime?: string;
  category?: string | string[];
  tags?: string[];
}

const {
  type,
  status,
  client,
  organisation,
  institution,
  startDate,
  endDate,
  updatedDate,
  readingTime = "",
  category = "",
  tags = [],
} = Astro.props as Props;

const items = [
  type && { label: "Type", value: type },
  status && { label: "Status", value: status },
  client && { label: "Client", value: client },
  organisation && { label: "Organisation", value: organisation },
  institution && { label: "Institution", value: institution },
].filter(Boolean) as { label: string; value: string }[];

const categories = Array.isArray(category) ? category : category ? [category] : [];
---

<EntryMeta
  items={items}
  itemsLabel="Project metadata"
  dates={[
    { label: "Started", value: startDate, time: true },
    { label: "Ended", value: endDate, time: true },
    { label: "Updated", value: updatedDate, time: true },
  ]}
  note={readingTime}
  categories={categories}
  tags={tags}
/>
