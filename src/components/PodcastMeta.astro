---
// src/components/PodcastMeta.astro
import EntryMeta from "./EntryMeta.astro";

interface Props {
  podcastPublisher?: string;
  podcastLanguage?: string;
  podcastWebsite?: string;
  podcastFeedUrl?: string;
  podcastCategories?: string[];
  tags?: string | string[];
  podcastApplePodcasts?: string;
  podcastSpotify?: string;
  podcastYouTube?: string;
  podcastTitle?: string;
  podcastDescription?: string;
  episodeNumber?: number | string;
  season?: number | string;
  publishedDate?: Date | string;
  duration?: string;
  host?: string;
  guest?: string;
  updatedDate?: Date | string;
}

const {
  podcastPublisher,
  podcastLanguage,
  podcastWebsite,
  podcastFeedUrl,
  podcastCategories = [],
  tags = [],
  podcastApplePodcasts,
  podcastSpotify,
  podcastYouTube,
  podcastTitle = "",
  podcastDescription = "",
  episodeNumber,
  season,
  publishedDate,
  duration = "",
  host,
  guest,
  updatedDate,
} = Astro.props as Props;

const items = [
  podcastTitle && { label: "Podcast", value: podcastTitle },
  podcastPublisher && { label: "Publisher", value: podcastPublisher },
  podcastLanguage && { label: "Language", value: podcastLanguage.toUpperCase() },
  episodeNumber && { label: "Episode", value: String(episodeNumber) },
  season && { label: "Season", value: String(season) },
  host && { label: "Host", value: host },
  guest && { label: "Guest", value: guest },
].filter(Boolean) as { label: string; value: string }[];

const links = [
  podcastWebsite && { label: "Website", href: podcastWebsite },
  podcastFeedUrl && { label: "RSS feed", href: podcastFeedUrl },
  podcastApplePodcasts && { label: "Apple Podcasts", href: podcastApplePodcasts },
  podcastSpotify && { label: "Spotify", href: podcastSpotify },
  podcastYouTube && { label: "YouTube", href: podcastYouTube },
].filter(Boolean) as { label: string; href: string }[];
---

<EntryMeta
  items={items}
  itemsLabel="Podcast metadata"
  dates={[
    { label: "Published", value: publishedDate },
    { label: "Updated", value: updatedDate },
  ]}
  note={duration}
  description={podcastDescription}
  categories={Array.isArray(podcastCategories) ? podcastCategories : []}
  tags={Array.isArray(tags) ? tags : tags ? [tags] : []}
  links={links}
  linksLabel="Podcast platform links"
/>
