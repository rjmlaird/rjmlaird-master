---
// src/components/Index/IndexHero.astro
// One hero for every portfolio index page (events, projects, case studies, initiatives, videos,
// articles, talks). Stacks cleanly on mobile; the accent phrase wraps onto its own line.
interface Props {
  eyebrow: string;
  title: string;
  /** Optional accent phrase, rendered in the teal accent after the title. */
  accent?: string;
  lede?: string;
  /** Short facts shown under the lede, e.g. ["51 events", "2009–2024"]. */
  stats?: string[];
}

const { eyebrow, title, accent, lede, stats = [] } = Astro.props as Props;
---

<header class="index-hero">
  <p class="index-hero__eyebrow">{eyebrow}</p>
  <h1 class="index-hero__title">
    {title}
    {accent && <em>{accent}</em>}
  </h1>
  {lede && <p class="index-hero__lede">{lede}</p>}
  {
    stats.length > 0 && (
      <ul class="index-hero__stats" aria-label="At a glance">
        {stats.map((stat) => (
          <li>{stat}</li>
        ))}
      </ul>
    )
  }
</header>

<style>
  .index-hero {
    display: grid;
    gap: 0.9rem;
    max-width: 52rem;
    padding-block: 0 clamp(0.25rem, 1.5vw, 0.75rem);
  }

  .index-hero__eyebrow {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--teal);
  }

  .index-hero__title {
    margin: 0;
    font-size: clamp(1.85rem, 6.2vw, 3.25rem);
    line-height: 1.08;
    letter-spacing: -0.025em;
    font-weight: 700;
    text-wrap: balance;
  }

  .index-hero__title em {
    display: block;
    color: var(--teal);
    font-style: normal;
  }

  .index-hero__lede {
    margin: 0;
    max-width: 60ch;
    font-size: clamp(1rem, 2.4vw, 1.1rem);
    line-height: 1.7;
    color: var(--mb);
  }

  .index-hero__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.5rem;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .index-hero__stats li {
    padding: 0.25rem 0.7rem;
    border: 1px solid var(--bm);
    border-radius: 999px;
    font-size: 0.8rem;
    color: var(--mb);
  }
</style>
