---
// src/components/AuthorCard.astro
interface Props {
  name: string;
  role: string;
  avatar?: string | null;
  bio?: string;
  compact?: boolean; // true = inline meta-bar chip, false = full footer card
}

const { name, role, avatar, bio, compact = false } = Astro.props;

const avatarSrc = avatar || undefined;
---

<div class:list={['author', { compact }]}>
  {avatarSrc && (
    <img
      src={avatarSrc}
      alt={name}
      width={compact ? 32 : 56}
      height={compact ? 32 : 56}
      class="avatar"
    />
  )}
  <div class="text">
    <span class="name">{name}</span>
    <span class="role">{role}</span>
    {!compact && bio && <p class="bio">{bio}</p>}
  </div>
</div>

<style>
  .author {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .author.compact {
    gap: 0.5rem;
  }
  .avatar {
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
  .text {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }
  .name {
    font-weight: 600;
    color: var(--color-text);
  }
  .compact .name {
    font-size: 0.9rem;
  }
  .role {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }
  .bio {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    max-width: 45ch;
  }
</style>
