---
import nav from "../data/nav.json";

type NavChild = {
  label: string;
  href: string;
  external?: boolean;
};

type NavLink = {
  label: string;
  href: string;
  external?: boolean;
  children?: NavChild[];
};

type NavData = {
  primary: NavLink[];
  utility?: NavLink[];
  cta?: NavLink;
};

const { primary, utility = [], cta } = nav as NavData;
const path = Astro.url.pathname;

const isCurrent = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(href);

const hasCurrentChild = (children: NavChild[] = []) =>
  children.some((child) => isCurrent(child.href));

const linkAttrs = (link: { href: string; external?: boolean }) =>
  link.external
    ? { target: "_blank", rel: "noopener noreferrer" }
    : {};
---

<nav class="site-nav" data-nav aria-label="Primary">
  <div class="nav-left">
    <a href="/" class="logo" aria-label="Ryan Laird home">RJM<span>Laird</span></a>
  </div>

  <div class="nav-right">
    <div class="utility-links">
      {utility.map((link) => (
        <a
          href={link.href}
          class="nsub"
          aria-current={isCurrent(link.href) ? "page" : undefined}
          {...linkAttrs(link)}
        >
          {link.label}
          {link.external && <span class="sr-only"> (opens in a new tab)</span>}
        </a>
      ))}
    </div>

    {cta && (
      <a href={cta.href} class="ncta">
        {cta.label}
      </a>
    )}

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav-menu"
    >
      <span class="sr-only">Open navigation</span>
      <span class="hamburger" aria-hidden="true"></span>
    </button>
  </div>

  <div class="nav-center">
    <ul id="site-nav-menu" class="nl">
      {primary.map((link, index) => {
        const hasChildren = Boolean(link.children?.length);
        const submenuId = `nav-submenu-${index}`;
        const isActive = isCurrent(link.href) || hasCurrentChild(link.children);

        return (
          <li class:list={["nitem", { "has-children": hasChildren, "is-active": isActive }]}>
            <div class="nav-item-row">
              <a
                class="nav-link"
                href={link.href}
                aria-current={isCurrent(link.href) ? "page" : undefined}
                {...linkAttrs(link)}
              >
                {link.label}
              </a>

              {hasChildren && (
                <button
                  class="submenu-toggle"
                  type="button"
                  aria-expanded="false"
                  aria-controls={submenuId}
                  aria-label={`Show ${link.label} links`}
                >
                  <span aria-hidden="true"></span>
                </button>
              )}
            </div>

            {hasChildren && (
              <ul id={submenuId} class="dropdown" hidden>
                {link.children?.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      aria-current={isCurrent(child.href) ? "page" : undefined}
                      {...linkAttrs(child)}
                    >
                      {child.label}
                      {child.external && (
                        <span class="sr-only"> (opens in a new tab)</span>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        );
      })}
    </ul>
  </div>

  <script is:inline>
    const initNav = () => {
      const siteNav = document.querySelector("[data-nav]");
      if (!siteNav || siteNav.dataset.initialised === "true") return;

      siteNav.dataset.initialised = "true";

      const mobileToggle = siteNav.querySelector(".nav-toggle");
      const mainMenu = siteNav.querySelector("#site-nav-menu");
      const submenuToggles = [...siteNav.querySelectorAll(".submenu-toggle")];

      const setMobileMenu = (open) => {
        siteNav.classList.toggle("menu-open", open);
        mobileToggle?.setAttribute("aria-expanded", String(open));

        const label = mobileToggle?.querySelector(".sr-only");
        if (label) label.textContent = open ? "Close navigation" : "Open navigation";
      };

      const closeSubmenu = (toggle, returnFocus = false) => {
        const submenuId = toggle.getAttribute("aria-controls");
        const submenu = submenuId ? document.getElementById(submenuId) : null;

        toggle.setAttribute("aria-expanded", "false");
        toggle.setAttribute(
          "aria-label",
          `Show ${toggle.closest(".nitem")?.querySelector(".nav-link")?.textContent?.trim() || "section"} links`
        );

        if (submenu) submenu.hidden = true;
        if (returnFocus) toggle.focus();
      };

      const openSubmenu = (toggle) => {
        submenuToggles.forEach((otherToggle) => {
          if (otherToggle !== toggle) closeSubmenu(otherToggle);
        });

        const submenuId = toggle.getAttribute("aria-controls");
        const submenu = submenuId ? document.getElementById(submenuId) : null;
        const label = toggle.closest(".nitem")?.querySelector(".nav-link")?.textContent?.trim() || "section";

        toggle.setAttribute("aria-expanded", "true");
        toggle.setAttribute("aria-label", `Hide ${label} links`);

        if (submenu) submenu.hidden = false;
      };

      const closeAllSubmenus = (returnFocus = false) => {
        submenuToggles.forEach((toggle) => closeSubmenu(toggle, returnFocus));
      };

      mobileToggle?.addEventListener("click", () => {
        const open = !siteNav.classList.contains("menu-open");
        setMobileMenu(open);

        if (!open) closeAllSubmenus();
      });

      submenuToggles.forEach((toggle) => {
        toggle.addEventListener("click", () => {
          const expanded = toggle.getAttribute("aria-expanded") === "true";

          if (expanded) {
            closeSubmenu(toggle);
          } else {
            openSubmenu(toggle);
          }
        });
      });

      siteNav.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return;

        const openToggle = siteNav.querySelector('.submenu-toggle[aria-expanded="true"]');

        if (openToggle) {
          event.preventDefault();
          closeSubmenu(openToggle, true);
          return;
        }

        if (siteNav.classList.contains("menu-open")) {
          event.preventDefault();
          setMobileMenu(false);
          mobileToggle?.focus();
        }
      });

      document.addEventListener("click", (event) => {
        if (!siteNav.contains(event.target)) {
          closeAllSubmenus();
          setMobileMenu(false);
        }
      });

      siteNav.addEventListener("focusout", () => {
        window.setTimeout(() => {
          if (!siteNav.contains(document.activeElement)) {
            closeAllSubmenus();
          }
        }, 0);
      });

      mainMenu?.addEventListener("click", (event) => {
        const target = event.target.closest("a");
        if (target) {
          closeAllSubmenus();
          setMobileMenu(false);
        }
      });
    };

    initNav();
    document.addEventListener("astro:page-load", initNav);
  </script>
</nav>

<style>
.site-nav {
  position: relative;
  z-index: 300;
  width: 100%;
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  align-items: center;
  gap: 1.5rem;
  padding: 1rem var(--gutter);
  background: rgba(11, 15, 26, 0.93);
  backdrop-filter: blur(18px);
  border-bottom: 1px solid var(--bd);
}

.nav-left {
  justify-self: start;
}

.nav-center {
  justify-self: center;
  min-width: 0;
}

.nav-right {
  justify-self: end;
  display: flex;
  align-items: center;
  gap: 0.7rem;
}

.utility-links {
  display: flex;
  align-items: center;
  gap: 0.45rem;
}

.logo {
  font-family: var(--D);
  font-size: 0.93rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  color: var(--w);
  text-decoration: none;
}

.logo span {
  color: var(--teal);
}

.nl {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1.2rem;
  list-style: none;
  margin: 0;
  padding: 0;
}

.nitem {
  position: relative;
}

.nav-item-row {
  display: flex;
  align-items: center;
  gap: 0.1rem;
}

.nav-link {
  font-family: var(--D);
  font-size: 0.75rem;
  font-weight: 500;
  color: var(--m);
  text-decoration: none;
  letter-spacing: 0.04em;
  padding: 0.4rem 0;
}

.nav-link[aria-current="page"],
.nitem.is-active > .nav-item-row > .nav-link,
.nsub[aria-current="page"] {
  color: var(--w);
}

.nav-link:hover,
.nav-link:focus-visible,
.nsub:hover,
.nsub:focus-visible {
  color: var(--w);
}

.submenu-toggle {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 1.4rem;
  min-height: 1.8rem;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--m);
  cursor: pointer;
}

.submenu-toggle span {
  display: block;
  width: 0.42rem;
  height: 0.42rem;
  border-right: 1px solid currentColor;
  border-bottom: 1px solid currentColor;
  transform: translateY(-0.12rem) rotate(45deg);
  transition: transform 160ms ease;
}

.submenu-toggle[aria-expanded="true"] {
  color: var(--w);
}

.submenu-toggle[aria-expanded="true"] span {
  transform: translateY(0.1rem) rotate(225deg);
}

.submenu-toggle:focus-visible {
  outline: 2px solid var(--teal);
  outline-offset: 2px;
  border-radius: 2px;
}

.dropdown {
  position: absolute;
  top: calc(100% + 0.45rem);
  left: 50%;
  z-index: 10;
  width: max-content;
  min-width: 13rem;
  max-width: min(20rem, calc(100vw - 2rem));
  list-style: none;
  margin: 0;
  padding: 0.45rem;
  border: 1px solid var(--bd);
  border-radius: 4px;
  background: rgba(11, 15, 26, 0.98);
  box-shadow: 0 1rem 2.5rem rgba(0, 0, 0, 0.24);
  transform: translateX(-50%);
}

.dropdown[hidden] {
  display: none;
}

.dropdown li + li {
  border-top: 1px solid rgba(255, 255, 255, 0.06);
}

.dropdown li a {
  display: block;
  font-family: var(--D);
  font-size: 0.72rem;
  font-weight: 500;
  color: var(--m);
  text-decoration: none;
  padding: 0.58rem 0.65rem;
  border-radius: 2px;
}

.dropdown li a:hover,
.dropdown li a:focus-visible,
.dropdown li a[aria-current="page"] {
  color: var(--w);
  background: rgba(255, 255, 255, 0.06);
}

.nsub {
  font-family: var(--D);
  font-size: 0.7rem;
  font-weight: 500;
  color: var(--m);
  text-decoration: none;
  border: 1px solid var(--bm);
  padding: 0.4rem 0.65rem;
  border-radius: 3px;
}

.ncta {
  font-family: var(--D);
  font-size: 0.76rem;
  font-weight: 600;
  color: var(--ink);
  background: var(--teal);
  padding: 0.48rem 0.95rem;
  border-radius: 3px;
  text-decoration: none;
  white-space: nowrap;
}

.ncta:hover,
.ncta:focus-visible {
  filter: brightness(1.08);
}

.nav-toggle {
  display: none;
  align-items: center;
  gap: 0.3rem;
  border: 1px solid var(--bm);
  border-radius: 3px;
  background: transparent;
  color: var(--m);
  padding: 0.5rem 0.65rem;
  cursor: pointer;
}

.nav-toggle:focus-visible,
.ncta:focus-visible {
  outline: 2px solid var(--w);
  outline-offset: 2px;
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.hamburger,
.hamburger::before,
.hamburger::after {
  display: block;
  width: 1.1rem;
  height: 0.09rem;
  background: currentColor;
}

.hamburger {
  position: relative;
}

.hamburger::before,
.hamburger::after {
  content: "";
  position: absolute;
  left: 0;
}

.hamburger::before {
  top: -0.28rem;
}

.hamburger::after {
  top: 0.28rem;
}

@media (max-width: 960px) {
  .utility-links {
    display: none;
  }

  .nl {
    gap: 0.8rem;
  }
}

@media (max-width: 720px) {
  .site-nav {
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-rows: auto auto;
    gap: 0.75rem;
  }

  .nav-center {
    grid-column: 1 / -1;
    justify-self: stretch;
  }

  .nav-right {
    gap: 0.45rem;
  }

  .ncta {
    font-size: 0.7rem;
    padding: 0.46rem 0.7rem;
  }

  .nav-toggle {
    display: inline-flex;
  }

  .nl {
    display: none;
    align-items: stretch;
    gap: 0;
    margin-top: 0.25rem;
    border-top: 1px solid var(--bd);
  }

  .site-nav.menu-open .nl {
    display: flex;
    flex-direction: column;
  }

  .nitem {
    width: 100%;
    border-bottom: 1px solid var(--bd);
  }

  .nav-item-row {
    justify-content: space-between;
    min-height: 2.9rem;
  }

  .nav-link {
    flex: 1;
    padding: 0.8rem 0;
  }

  .submenu-toggle {
    width: 2.9rem;
    min-height: 2.9rem;
  }

  .dropdown {
    position: static;
    width: 100%;
    max-width: none;
    min-width: 0;
    margin: 0;
    padding: 0.2rem 0 0.55rem 1rem;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    transform: none;
  }

  .dropdown li + li {
    border-top: 0;
  }

  .dropdown li a {
    padding: 0.55rem 0.65rem;
  }
}

@media (max-width: 430px) {
  .ncta {
    display: none;
  }
}
</style>
